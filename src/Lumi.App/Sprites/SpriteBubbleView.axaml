<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:Lumi.App.Sprites"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             x:Class="Lumi.App.Sprites.SpriteBubbleView"
             x:DataType="sp:SpriteBubbleViewModel">
  <!--
    小精靈的氣泡（ui-spec 8.1、8.3）：狀態一行、串流中的回答、完成、等待確認（精簡／展開／Destructive）、錯誤。
    同一時間只顯示最新一則。等待確認與錯誤的氣泡有警示色外框。只用 token 上色。
    按鈕層級（ui-guide.html 第 6 節）：每個區塊最多一個 primary（Destructive 的「允許刪除」改 danger），其餘 secondary／tertiary。
    氣泡的內距、按鈕內距與間距（14,10／12,5／6）決定氣泡尺寸，小精靈版面不改（UE-1），所以保持原值。
  -->
  <UserControl.Styles>
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusPanel}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MaxWidth" Value="280" />
      <Setter Property="BoxShadow" Value="{StaticResource LumiSpriteShadow}" />
    </Style>
    <Style Selector="Border.bubble.approval">
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.bubble.error">
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LumiInfoBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiInfoBrush}" />
    </Style>
    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
  </UserControl.Styles>

  <!-- 氣泡太高時（提醒卡片＋長回答＋按鈕）不超出預留區：高度上限由 SpriteWindow 設，超過的部分在這裡捲動，捲到最下面（最新內容與按鈕）。
       捲動區向外擴、內容向內縮各一圈陰影的寬度（code-behind），陰影不會被捲動區切掉 -->
  <ScrollViewer x:Name="BubbleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="Root">
    <!--
      提醒（M10 10E）：獨立的卡片，在回應氣泡上方；不自動消失，按關閉才收起（只有關閉鈕可以點，卡片其他部分穿透）。
      最新一則；還有其他則時標示「還有 N 則」，關掉一則後顯示下一則。內文超過氣泡上限就截斷（完整內容在工作台的通知列）。
    -->
    <Border x:Name="ReminderCard" Classes="bubble" IsVisible="{Binding HasReminder}" Margin="0,0,0,6">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ctl:LumiIcon Data="{StaticResource LumiIconBell}" Size="14" Foreground="{DynamicResource LumiAccentTextBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="ReminderTitle" Text="{Binding Reminder.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"
                       FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiTextMutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="ReminderDismissButton" Grid.Column="1" Classes="tertiary" Width="24" Height="24" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding Reminder.DismissCommand}" ToolTip.Tip="{Binding Reminder.DismissLabel}"
                  AutomationProperties.Name="{Binding Reminder.DismissLabel}">
            <ctl:LumiIcon Data="{StaticResource LumiIconX}" Size="12" />
          </Button>
        </Grid>
        <ctl:EmojiTextBlock x:Name="ReminderBody" Text="{Binding ReminderText}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                            LineHeight="22" FontSize="{DynamicResource LumiFontSizeCard}" IsHitTestVisible="False" />
        <TextBlock x:Name="ReminderMore" IsVisible="{Binding HasReminderMore}" Text="{Binding ReminderMoreText}"
                   FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiTextMutedBrush}" />
      </StackPanel>
    </Border>

    <Border x:Name="BubbleBorder" Classes="bubble" Classes.approval="{Binding IsApproval}" Classes.error="{Binding IsError}" IsVisible="{Binding IsVisible}">
      <Panel>
        <!-- 思考或呼叫工具：一行狀態；語音送出時上方先以小字引用轉寫結果（ui-spec 8.4） -->
        <StackPanel x:Name="StatusArea" IsVisible="{Binding IsStatus}" Spacing="4">
          <ctl:EmojiTextBlock x:Name="QuoteLine" IsVisible="{Binding HasQuote}" Text="{Binding QuoteText}" TextWrapping="Wrap" MaxLines="2"
                              TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LumiTextMutedBrush}"
                              FontSize="{DynamicResource LumiFontSizeCaption}" IsHitTestVisible="False" />
          <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxLines="1"
                     Foreground="{DynamicResource LumiTextMutedBrush}" FontSize="{DynamicResource LumiFontSizeCard}" />
        </StackPanel>

        <!-- 語音提示（太短、沒有聲音、沒聽到內容）：一句，會自動淡出 -->
        <ctl:EmojiTextBlock x:Name="NoticeLine" IsVisible="{Binding IsNotice}" Text="{Binding NoticeText}" TextWrapping="Wrap"
                            FontSize="{DynamicResource LumiFontSizeCard}" IsHitTestVisible="False" />

        <!-- 回答（串流中與完成）：最多兩句，不用 Markdown -->
        <StackPanel x:Name="AnswerArea" IsVisible="{Binding IsAnswer}" Spacing="6">
          <ctl:EmojiTextBlock x:Name="AnswerText" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22"
                              FontSize="{DynamicResource LumiFontSizeCard}" IsHitTestVisible="False" />
          <Button x:Name="DetailsLink" Classes="link" IsVisible="{Binding ShowDetailsLink}" Command="{Binding OpenDetailsCommand}"
                  Content="{x:Static res:Strings.Sprite_OpenDetails}" />
        </StackPanel>

        <!-- 權限確認（在氣泡內完成，不需要切回工作台） -->
        <StackPanel x:Name="ApprovalArea" IsVisible="{Binding IsApproval}" Spacing="8">
          <StackPanel Spacing="8" DataContext="{Binding Approval}" x:DataType="sp:SpriteApprovalViewModel">
            <ctl:EmojiTextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{DynamicResource LumiFontSizeCard}" IsHitTestVisible="False" />
            <TextBlock IsVisible="{Binding HasTarget}" Text="{Binding Target}" Classes="mono" TextWrapping="Wrap"
                       FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiWarningTextBrush}" />
            <TextBlock IsVisible="{Binding HasWarning}" Text="{Binding Warning}" TextWrapping="Wrap"
                       FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiWarningTextBrush}" />
            <TextBlock IsVisible="{Binding IsDestructive}" Text="{x:Static res:Strings.Sprite_Irreversible}" FontWeight="SemiBold"
                       Foreground="{DynamicResource LumiDangerBrush}" />
            <ScrollViewer IsVisible="{Binding ShowDetail}" MaxHeight="80" VerticalScrollBarVisibility="Auto">
              <ctl:EmojiTextBlock Text="{Binding Detail}" Classes="mono" TextWrapping="Wrap" FontSize="{DynamicResource LumiFontSizeCaption}" IsHitTestVisible="False" />
            </ScrollViewer>
          </StackPanel>

          <!-- 精簡版：允許（＝允許一次）、拒絕、更多選項。Destructive 只有「允許刪除」「拒絕」 -->
          <StackPanel x:Name="CompactButtons" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Approval.ShowOptions}">
            <Button x:Name="AllowButton" Classes="small" Classes.primary="{Binding !Approval.IsDestructive}" Classes.danger="{Binding Approval.IsDestructive}"
                    Content="{Binding Approval.AllowLabel}" Command="{Binding AllowOnceCommand}" />
            <Button x:Name="DenyButton" Classes="small" Classes.tertiary="{Binding !Approval.IsDestructive}" Classes.secondary="{Binding Approval.IsDestructive}"
                    Content="{x:Static res:Strings.Sprite_Deny}" Command="{Binding DenyCommand}" />
          </StackPanel>
          <Button x:Name="MoreLink" Classes="link" IsVisible="{Binding Approval.ShowMoreLink}" Command="{Binding ToggleMoreOptionsCommand}"
                  Content="{x:Static res:Strings.Sprite_MoreOptions}" HorizontalAlignment="Left" />

          <!-- 展開：允許一次／這則對話都允許／拒絕／在工作台檢視 -->
          <StackPanel x:Name="Options" IsVisible="{Binding Approval.ShowOptions}" Spacing="6">
            <WrapPanel>
              <Button x:Name="OptionAllowOnce" Classes="small primary" Margin="0,0,6,6" Content="{x:Static res:Strings.Sprite_AllowOnce}"
                      Command="{Binding AllowOnceCommand}" />
              <Button x:Name="OptionAllowConversation" Classes="small secondary" Margin="0,0,6,6" Content="{x:Static res:Strings.Sprite_AllowConversation}"
                      Command="{Binding AllowForConversationCommand}" IsVisible="{Binding Approval.AllowRemember}" />
              <Button x:Name="OptionDeny" Classes="small tertiary" Margin="0,0,6,6" Content="{x:Static res:Strings.Sprite_Deny}" Command="{Binding DenyCommand}" />
            </WrapPanel>
            <Button x:Name="ViewLink" Classes="link" Command="{Binding ViewInWorkbenchCommand}" HorizontalAlignment="Left"
                    Content="{x:Static res:Strings.Sprite_ViewInWorkbench}" />
          </StackPanel>
        </StackPanel>

        <!-- 錯誤：一句說明，加上重試與在工作台查看（金鑰問題帶「開啟設定」）；語音轉寫失敗改為「重試轉寫」「放棄這段錄音」 -->
        <StackPanel x:Name="ErrorArea" IsVisible="{Binding IsError}" Spacing="8">
          <ctl:EmojiTextBlock x:Name="ErrorText" Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource LumiDangerBrush}"
                              FontSize="{DynamicResource LumiFontSizeCard}" IsHitTestVisible="False" />
          <WrapPanel IsVisible="{Binding !IsVoiceFailure}">
            <Button x:Name="RetryButton" Classes="small primary" Margin="0,0,6,6" IsVisible="{Binding CanRetry}" Content="{x:Static res:Strings.Sprite_Retry}"
                    Command="{Binding RetryCommand}" />
            <Button x:Name="SettingsButton" Classes="small secondary" Margin="0,0,6,6" IsVisible="{Binding CanOpenSettings}"
                    Content="{x:Static res:Strings.Sprite_OpenSettings}" Command="{Binding OpenSettingsCommand}" />
          </WrapPanel>
          <WrapPanel x:Name="VoiceErrorButtons" IsVisible="{Binding IsVoiceFailure}">
            <Button x:Name="VoiceRetryButton" Classes="small primary" Margin="0,0,6,6" Content="{x:Static res:Strings.Voice_Retry}"
                    Command="{Binding VoiceRetryCommand}" />
            <Button x:Name="VoiceDiscardButton" Classes="small tertiary" Margin="0,0,6,6" Content="{x:Static res:Strings.Voice_DiscardTip}"
                    Command="{Binding VoiceDiscardCommand}" />
          </WrapPanel>
          <Button x:Name="ErrorViewLink" Classes="link" Command="{Binding ViewInWorkbenchCommand}" HorizontalAlignment="Left"
                  Content="{x:Static res:Strings.Sprite_ViewErrorInWorkbench}" IsVisible="{Binding !IsVoiceFailure}" />
        </StackPanel>
      </Panel>
    </Border>
    <Path Data="M0,0 L14,0 L7,8 Z" Fill="{DynamicResource LumiSurfaceBrush}" HorizontalAlignment="Center" IsVisible="{Binding HasTail}" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
