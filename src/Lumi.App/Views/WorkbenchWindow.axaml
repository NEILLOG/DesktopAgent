<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumi.App.ViewModels"
        xmlns:ctl="using:Lumi.App.Controls"
        xmlns:res="using:Lumi.App.Resources"
        xmlns:views="using:Lumi.App.Views"
        xmlns:md="using:Lumi.App.Markdown"
        x:Name="Root"
        x:Class="Lumi.App.Views.WorkbenchWindow"
        x:DataType="vm:WorkbenchViewModel"
        Title="{Binding Title}"
        Width="960" Height="760"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.send">
      <Setter Property="Background" Value="{DynamicResource LumiAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiOnAccentBrush}" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
    </Style>
    <!-- 選取列是琥珀底（歷史抽屜目前的對話）：裡面的文字改用 OnAccent，確保對比 -->
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiOnAccentBrush}" />
    </Style>
    <Style Selector="Button.capsule">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,5" />
    </Style>
    <Style Selector="Button.sprite:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LumiAccentTextBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
    <!-- 上下文 chip（輸入框上方）與使用者氣泡上的 chip -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,3,4,3" />
    </Style>
    <Style Selector="Border.chip.folder">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
    </Style>
    <Style Selector="Border.chip.problem">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.dropping">
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
  </Window.Styles>

  <!-- 由上而下：頂端列、訊息流、輸入區、狀態列（ui-spec 第 2 節）。只用 token 上色。 -->
  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="12,8"
            Background="{DynamicResource LumiChromeBrush}"
            BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="chrome" Content="{x:Static res:Strings.Workbench_History}" Command="{Binding History.ToggleCommand}" />
          <Button Classes="chrome" Content="{x:Static res:Strings.Workbench_NewConversation}" Command="{Binding NewConversationCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
            <Ellipse Width="12" Height="12" Fill="{DynamicResource LumiAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Lumi" FontWeight="Medium" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- 模型切換膠囊：狀態點、模型名稱、連線名稱、下拉箭頭。回應中停用並說明原因 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="CapsuleButton" Classes="capsule" IsEnabled="{Binding CanSwitchModel}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <views:ModelPicker DataContext="{Binding ModelSwitcher}" />
              </Flyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding ModelSwitcher}" x:DataType="vm:ModelSwitcherViewModel">
              <Panel Width="10" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" IsVisible="{Binding IsOk}" Fill="{DynamicResource LumiSuccessBrush}" />
                <Ellipse Width="9" Height="9" IsVisible="{Binding IsFailed}" Fill="{DynamicResource LumiDangerBrush}" />
                <Ellipse Width="9" Height="9" IsVisible="{Binding IsUnknown}" Fill="{DynamicResource LumiBorderStrongBrush}" />
              </Panel>
              <TextBlock Text="{Binding CapsuleText}" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentConnectionName}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Text="▾" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock IsVisible="{Binding ShowSwitchBlockedHint}" Text="{x:Static res:Strings.Workbench_SwitchBlocked}"
                     Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
          <!-- 小精靈模式：M7 之前停用 -->
          <Button Classes="chrome sprite" IsEnabled="False" Content="{x:Static res:Strings.Workbench_SpriteMode}"
                  ToolTip.Tip="{x:Static res:Strings.Workbench_SpriteModeSoon}" />
          <Button Classes="chrome" Content="{x:Static res:Strings.Workbench_Settings}" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 歷史對話抽屜（內嵌，開啟時把訊息區往右推） -->
    <SplitView Grid.Row="1" IsPaneOpen="{Binding History.IsOpen}" DisplayMode="Inline" PanePlacement="Left" OpenPaneLength="260"
               PaneBackground="{DynamicResource LumiChromeBrush}">
      <SplitView.Pane>
        <DockPanel DataContext="{Binding History}" x:DataType="vm:HistoryViewModel">
          <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="{x:Static res:Strings.Workbench_History}" FontWeight="Medium" />
          </Border>
          <Border BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,0,1,0">
            <Panel>
              <TextBlock IsVisible="{Binding IsEmpty}" Text="{x:Static res:Strings.Workbench_HistoryEmpty}" Classes="muted"
                         HorizontalAlignment="Center" Margin="0,24,0,0" />
              <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" Margin="6">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConversationListItem">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding TimeText}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </DockPanel>
      </SplitView.Pane>

    <Grid RowDefinitions="*,Auto,Auto">
    <ScrollViewer Grid.Row="0" x:Name="MessageScroller">
      <StackPanel Margin="24,20" Spacing="18">
        <!-- 一次性提示：例如設定檔損毀已改用預設 -->
        <Border IsVisible="{Binding HasNotice}" Padding="14,10" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource LumiWarningTextBrush}" />
            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{x:Static res:Strings.Workbench_DismissNotice}" Command="{Binding DismissNoticeCommand}" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="18" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <!-- 工具段落（ToolRunViewModel 繼承 MessageViewModel，所以放前面先比對） -->
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:ToolRunViewModel">
              <views:ToolRunView />
            </DataTemplate>
            <DataTemplate DataType="vm:MessageViewModel" x:DataType="vm:MessageViewModel">
              <Panel>
                <!-- 使用者：靠右、UserBubble 底色；上方是送出當時帶的檔案、資料夾、圖片 chip -->
                <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="640" Spacing="6">
                  <ItemsControl IsVisible="{Binding HasAttachments}" ItemsSource="{Binding Attachments}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MessageChipViewModel">
                        <Border Classes="chip" Classes.folder="{Binding IsFolder}" Classes.problem="{Binding HasProblem}"
                                Padding="9,3" ToolTip.Tip="{Binding Tooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:EmojiTextBlock Text="{Binding DisplayName}" MaxWidth="240" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                FontSize="{DynamicResource LumiFontSizeCaption}" />
                            <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" Classes="muted" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Right" Padding="14,10" CornerRadius="14"
                          Background="{DynamicResource LumiUserBubbleBrush}">
                    <ctl:EmojiTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                        Foreground="{DynamicResource LumiUserBubbleTextBrush}" />
                  </Border>
                </StackPanel>

                <!-- 助理：靠左、不加底、左側小光球 -->
                <Grid IsVisible="{Binding IsAssistant}" ColumnDefinitions="Auto,*" HorizontalAlignment="Left" MaxWidth="780">
                  <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,5,12,0" VerticalAlignment="Top"
                           Fill="{DynamicResource LumiAccentBrush}" />
                  <StackPanel Grid.Column="1" Spacing="6">
                    <!-- 思考過程：M1 最簡版，正式樣式在 M2（Q14） -->
                    <Expander IsVisible="{Binding HasThinking}" Header="{Binding ThinkingTitle}"
                              HorizontalAlignment="Stretch">
                      <ctl:EmojiTextBlock Text="{Binding Thinking}" TextWrapping="Wrap"
                                          Foreground="{DynamicResource LumiTextMutedBrush}"
                                          FontSize="{DynamicResource LumiFontSizeCard}" />
                    </Expander>
                    <!-- 助理的回答用 Markdown 渲染；使用者訊息與思考過程維持純文字 -->
                    <md:MarkdownView IsVisible="{Binding HasText}" Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}" />
                    <TextBlock IsVisible="{Binding ShowTypingIndicator}" Text="…" Classes="muted" />
                    <TextBlock IsVisible="{Binding IsStopped}" Text="{x:Static res:Strings.Workbench_Stopped}" Classes="muted" />

                    <!-- 動作列：複製、重新產生（只有最後一則）、本輪 token -->
                    <StackPanel IsVisible="{Binding ShowActions}" Orientation="Horizontal" Spacing="4">
                      <Button Classes="chrome small" Content="{Binding CopyLabel}"
                              Command="{Binding #Root.((vm:WorkbenchViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}" />
                      <Button Classes="chrome small" IsVisible="{Binding IsLastAssistant}" Content="{x:Static res:Strings.Workbench_Regenerate}"
                              Command="{Binding #Root.((vm:WorkbenchViewModel)DataContext).RegenerateCommand}" />
                      <TextBlock IsVisible="{Binding HasUsage}" Text="{Binding UsageText}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Panel>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>

        <!-- 錯誤列：原因 + 對話內容已保留 + 重試（ui-spec 第 3 節） -->
        <Border IsVisible="{Binding HasError}" Padding="14,10" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
              <TextBlock Text="{x:Static res:Strings.Workbench_ErrorKept}" Classes="muted" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
              <Button x:Name="RetryOtherModelButton" Content="{x:Static res:Strings.Workbench_RetryOtherModel}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <views:ModelPicker DataContext="{Binding RetrySwitcher}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Content="{x:Static res:Strings.Workbench_Retry}" Command="{Binding RetryCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="InputArea" Grid.Row="1" Margin="24,8,24,14" Padding="12,8" CornerRadius="14" BorderThickness="1"
            DragDrop.AllowDrop="True"
            Background="{DynamicResource LumiSurfaceBrush}"
            BorderBrush="{DynamicResource LumiBorderStrongBrush}">
      <StackPanel Spacing="6">
        <!-- 此對話的上下文（ui-spec 6.1）：有項目時才出現 -->
        <StackPanel x:Name="ContextBar" DataContext="{Binding Context}" IsVisible="{Binding HasItems}" Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Static res:Strings.Context_Title}" Classes="muted" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static res:Strings.Context_TokensHint}">
              <TextBlock Text="{Binding TokensText}" Classes="muted" />
              <TextBlock IsVisible="{Binding IsOverLimit}" Text="⚠" Foreground="{DynamicResource LumiWarningIconBrush}"
                         ToolTip.Tip="{Binding OverLimitText}" />
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="ContextChips" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextChipViewModel">
                <Border Classes="chip" Classes.folder="{Binding IsFolder}" Classes.problem="{Binding HasProblem}" ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- 圖片縮圖（解碼失敗就沒有） -->
                    <Image IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}" Width="20" Height="20" Stretch="UniformToFill"
                           Source="{Binding Path, Converter={x:Static views:PathToBitmapConverter.Instance}}" />
                    <ctl:EmojiTextBlock Text="{Binding DisplayName}" MaxWidth="220" TextTrimming="CharacterEllipsis" MaxLines="1"
                                        VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCaption}" />
                    <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock IsVisible="{Binding IsSent}" Text="{Binding SentLabel}" Classes="muted" VerticalAlignment="Center" />
                    <Button Classes="chrome small" Padding="5,0" Content="×" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.Context_Remove}"
                            Command="{Binding #Root.((vm:WorkbenchViewModel)DataContext).Context.RemoveCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding HasNotice}" Text="{Binding Notice}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error}" TextWrapping="Wrap"
                     Foreground="{DynamicResource LumiWarningTextBrush}" FontSize="{DynamicResource LumiFontSizeCaption}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <!-- Enter 送出、Shift+Enter 換行（code-behind）；約 8 行後改捲動 -->
          <TextBox x:Name="InputBox" Grid.Row="0" Grid.Column="0"
                   Text="{Binding InputText}"
                   Watermark="{x:Static res:Strings.Workbench_InputPlaceholder}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="40" MaxHeight="190"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Bottom">
            <TextBlock IsVisible="{Binding IsResponding}" Text="{x:Static res:Strings.Workbench_WaitingHint}"
                       Classes="muted" VerticalAlignment="Center" />
            <Button IsVisible="{Binding !IsResponding}" Classes="round send" Content="↑"
                    ToolTip.Tip="{x:Static res:Strings.Workbench_Send}" Command="{Binding SendCommand}" />
            <Button IsVisible="{Binding IsResponding}" Classes="round stop" Content="■"
                    ToolTip.Tip="{x:Static res:Strings.Workbench_Stop}" Command="{Binding StopCommand}" />
          </StackPanel>
          <!-- 左下：加入檔案、加入資料夾（回應中停用） -->
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
            <Button x:Name="AddFileButton" Classes="chrome small" Content="{x:Static res:Strings.Context_AddFile}"
                    Command="{Binding Context.AddFileCommand}" />
            <Button x:Name="AddFolderButton" Classes="chrome small" Content="{x:Static res:Strings.Context_AddFolder}"
                    Command="{Binding Context.AddFolderCommand}" />
            <TextBlock IsVisible="{Binding IsResponding}" Text="{x:Static res:Strings.Context_LockedHint}" Classes="muted"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
            <!-- 開發用（Lumi:Developer:ShowSpriteModeToggle）：M7 之前驗收小精靈 prompt -->
            <CheckBox x:Name="SpriteModeToggle" IsVisible="{Binding ShowSpriteModeToggle}" IsEnabled="{Binding CanChangeMode}"
                      IsChecked="{Binding IsSpriteMode}" Content="{x:Static res:Strings.Workbench_SpriteModeToggle}"
                      FontSize="{DynamicResource LumiFontSizeCaption}" Margin="10,0,0,0" MinHeight="0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 輸入 N · 輸出 N · 回合 N · 上下文 [進度條] 14K / 1M（ui-spec 2.3） -->
    <Border Grid.Row="2" Padding="16,6"
            Background="{DynamicResource LumiChromeBrush}"
            BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
          <ProgressBar Width="120" MinWidth="120" VerticalAlignment="Center"
                       Minimum="0" Maximum="{Binding ContextWindow}" Value="{Binding ContextUsed}" />
          <TextBlock Text="{Binding ContextText}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <!-- 連線狀態：最近一次回應或測試連線的結果 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Panel Width="10" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" IsVisible="{Binding IsConnectionOk}" Fill="{DynamicResource LumiSuccessBrush}" />
            <Ellipse Width="9" Height="9" IsVisible="{Binding IsConnectionFailed}" Fill="{DynamicResource LumiDangerBrush}" />
            <Ellipse Width="9" Height="9" IsVisible="{Binding IsConnectionUnknown}" Fill="{DynamicResource LumiBorderStrongBrush}" />
          </Panel>
          <TextBlock Text="{Binding ConnectionStatusText}" Classes="muted" />
        </StackPanel>
      </Grid>
    </Border>
    </Grid>
    </SplitView>
  </Grid>
</Window>
