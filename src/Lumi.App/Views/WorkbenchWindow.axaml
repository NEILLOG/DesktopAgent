<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumi.App.ViewModels"
        xmlns:ctl="using:Lumi.App.Controls"
        xmlns:res="using:Lumi.App.Resources"
        xmlns:views="using:Lumi.App.Views"
        xmlns:md="using:Lumi.App.Markdown"
        x:Name="Root"
        Icon="avares://Lumi.App/Assets/Icons/lumi-256.png"
        x:Class="Lumi.App.Views.WorkbenchWindow"
        x:DataType="vm:WorkbenchViewModel"
        Title="{Binding Title}"
        Width="1040" Height="760"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <Window.Styles>
    <!-- 歷史抽屜用到的共用樣式；工具列、訊息流、輸入區各自在自己的 UserControl 裡載入 -->
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
    <!-- 選取列用 Soft 底＋OnSoft 文字（ui-guide.html 第 3 節），文字對比 ≥ 4.5:1 -->
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
    <!-- 歷史抽屜的項目：圓角 10、內距 12／8、項目之間 4（選取＝上面的 Soft 底） -->
    <Style Selector="ListBox.history-list ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
    </Style>
    <!-- Fluent 的選取／Hover 底色畫在模板裡的 ContentPresenter，要在這一層覆寫才會生效 -->
    <Style Selector="ListBox.history-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    </Style>
    <Style Selector="ListBox.history-list ListBoxItem:selected /template/ ContentPresenter, ListBox.history-list ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.history-list ListBoxItem:selected:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
    <!-- 歷史抽屜：Wide／Compact 內嵌（把訊息區往右推），Narrow 蓋在訊息區上方（RWD原則 / 計畫「工作台結構」） -->
    <Style Selector="SplitView">
      <Setter Property="DisplayMode" Value="Inline" />
    </Style>
    <Style Selector="Window.narrow SplitView">
      <Setter Property="DisplayMode" Value="Overlay" />
    </Style>
  </Window.Styles>

  <!-- 由上而下：標題列、工具列、訊息流＋輸入區（ui-spec 第 2 節；用量與連線狀態在模型選單頂部）。只用 token 上色。 -->
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- 自訂標題列：Lumi 標誌、拖曳區、小精靈模式（SpriteModeButton 在它裡面，見 CustomTitleBar.SpriteModeButton） -->
    <views:CustomTitleBar x:Name="TitleBar" Grid.Row="0" />

    <!-- 工具列：新對話、歷史對話、模型膠囊（CapsuleButton）、「…」選單 -->
    <views:ChatToolbar x:Name="Toolbar" Grid.Row="1" />

    <!-- 歷史對話抽屜（內嵌，開啟時把訊息區往右推） -->
    <SplitView Grid.Row="2" IsPaneOpen="{Binding History.IsOpen}" PanePlacement="Left" OpenPaneLength="260"
               PaneBackground="{DynamicResource LumiChromeBrush}">
      <SplitView.Pane>
        <!-- 收起時整個隱藏，抽屜裡的清單才不會被 Tab 聚焦到（搜尋、清單、載入更多都在 HistoryDrawer 裡） -->
        <views:HistoryDrawer x:Name="HistoryDrawerView" DataContext="{Binding History}" IsVisible="{Binding IsOpen}" />
      </SplitView.Pane>

      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 提醒通知列：沒有通知時不佔空間（ui-spec 第 13 節） -->
        <views:NotificationStrip x:Name="NotificationStripView" Grid.Row="0" DataContext="{Binding Notifications}" />

        <!-- 查看中：小精靈回應中開啟的工作台，輸入與切換都停用，結束後自動解除（ui-spec 2.2） -->
        <Border x:Name="ViewOnlyBanner" Grid.Row="1" IsVisible="{Binding IsViewOnly}" Padding="16,8"
                Background="{DynamicResource LumiAccentSoftBrush}" BorderBrush="{DynamicResource LumiAccentBorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="{x:Static res:Strings.Workbench_ViewOnlyBanner}" Foreground="{DynamicResource LumiAccentTextBrush}" />
        </Border>

        <!-- 訊息流（MessageScroller、RetryOtherModelButton 在它裡面） -->
        <views:ConversationView x:Name="Conversation" Grid.Row="2" />

        <!-- 輸入區（InputArea、InputBox、ContextBar、AddFileButton… 在它裡面） -->
        <views:ChatComposer x:Name="Composer" Grid.Row="3" />
      </Grid>
    </SplitView>
  </Grid>
</Window>
