<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:views="using:Lumi.App.Views"
             x:Class="Lumi.App.Views.AiConnectionsView"
             x:DataType="vm:AiSettingsViewModel">

  <UserControl.Styles>
    <!-- 連線底下的虛線「＋ 新增模型」列：它是清單裡可選取的一列（方向鍵走得到），所以虛線框是畫出來的，Hover／選取／鍵盤焦點時換 Accent -->
    <Style Selector="ListBoxItem:pointerover Panel.add-model Rectangle#PART_Dash, ListBoxItem:selected Panel.add-model Rectangle#PART_Dash">
      <Setter Property="Stroke" Value="{DynamicResource LumiAccentBrush}" />
      <Setter Property="Fill" Value="{DynamicResource LumiAccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible Panel.add-model Rectangle#PART_Dash">
      <Setter Property="Stroke" Value="{DynamicResource LumiAccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Panel.add-model TextBlock, ListBoxItem:selected Panel.add-model TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
  </UserControl.Styles>

  <!--
    AI 連線頁的內容（M22 22D）：整頁一個 ScrollViewer，表單照內容長高、一起捲動（沒有內層捲軸）。
    由上而下：預設模型（立即生效）→ 清單＋詳細。清單 260、詳細吃剩餘寬度；視窗 < 900 時由根節點的 stacked class 改成上下排（Themes/Controls.axaml）。
  -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,0">

      <!-- 預設模型（工作台與小精靈共用）：標籤在上、Caption 說明在下；改了立即生效 -->
      <StackPanel x:Name="DefaultsSection" DataContext="{Binding Models}" x:DataType="vm:ModelsViewModel" Spacing="8" Margin="0,0,0,24">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <ctl:FormField x:Name="WorkbenchDefaultField" Grid.Column="0" Label="{x:Static res:Strings.AiSettings_DefaultModel}"
                         Hint="{x:Static res:Strings.Models_WorkbenchDefaultHint}">
            <ComboBox x:Name="WorkbenchDefaultBox" ItemsSource="{Binding DefaultOptions}" SelectedItem="{Binding WorkbenchOption}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{x:Static res:Strings.AiSettings_DefaultModel}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModelOption"><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </ctl:FormField>
        </Grid>

        <!-- 費用說明（BYOK：費用歸屬要清楚） -->
        <TextBlock x:Name="CostNote" Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Workbench_CostNote}" />

        <Border IsVisible="{Binding DefaultChangedNotice, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="12,8" CornerRadius="{StaticResource LumiRadiusInput}" BorderThickness="1"
                Background="{DynamicResource LumiAccentSoftBrush}" BorderBrush="{DynamicResource LumiAccentBorderBrush}">
          <TextBlock Text="{Binding DefaultChangedNotice}" TextWrapping="Wrap" Foreground="{DynamicResource LumiTextOnSoftBrush}" />
        </Border>
      </StackPanel>

      <!-- 清單＋詳細：清單 class="master"、詳細 class="detail"（兩欄兩列，< 900 時改上下排） -->
      <Grid x:Name="Layout" ColumnDefinitions="260,*" RowDefinitions="Auto,*">

        <!-- 清單：連線（分組標題）→ 它的模型 → 虛線「＋ 新增模型」；清單欄超過高度時跟著整頁捲，不另外捲 -->
        <StackPanel x:Name="MasterHost" Classes="master">
          <TextBlock x:Name="ListCaption" Classes="muted" Margin="0,0,0,8" Text="{Binding ListTitle}" />
          <TextBlock x:Name="AiEmptyText" Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.AiSettings_Empty}" IsVisible="{Binding IsEmpty}" />
          <ListBox x:Name="AiList" Classes="cards" ItemsSource="{Binding Items}" IsVisible="{Binding !IsEmpty}"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding ListTitle}">
            <ListBox.Styles>
              <!-- 每一列的可存取名稱：連線＝名稱與狀態、模型＝名稱與 model ID（與預設標籤）、新增模型＝「新增模型」 -->
              <Style Selector="ListBoxItem" x:DataType="vm:AiListItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
              </Style>
            </ListBox.Styles>
            <ListBox.DataTemplates>
              <!-- 連線：字首圖示、名稱、狀態點加文字 -->
              <DataTemplate DataType="vm:AiConnectionItem">
                <Border Classes="card" Padding="12" ToolTip.Tip="{Binding Connection.Name}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <views:ProviderMark Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" Text="{Binding Connection.Initial}" />
                    <TextBlock Grid.Column="1" Text="{Binding Connection.Name}" FontWeight="SemiBold" FontSize="{DynamicResource LumiFontSizeCard}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <views:StatusIndicator Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Status="{Binding Connection.Status}" />
                  </Grid>
                </Border>
              </DataTemplate>
              <!-- 模型：縮排在所屬連線底下，名稱與「預設」標籤 -->
              <DataTemplate DataType="vm:AiModelItem">
                <Border Classes="card" Margin="24,0,0,0" Padding="12,8" ToolTip.Tip="{Binding Tooltip}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Model.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasTag}">
                      <TextBlock Text="{Binding Tag}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
              <!-- 連線底下最後一列：虛線「＋ 新增模型」（選到它就在這個連線底下新增） -->
              <DataTemplate DataType="vm:AiAddModelItem">
                <Panel Classes="add-model" Margin="24,0,0,0" MinHeight="40">
                  <Rectangle x:Name="PART_Dash" RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="4,3"
                             Stroke="{DynamicResource LumiBorderStrongBrush}" Fill="Transparent" IsHitTestVisible="False" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ctl:LumiIcon Data="{StaticResource LumiIconPlus}" Size="16" Foreground="{DynamicResource LumiTextMutedBrush}" />
                    <TextBlock Text="{x:Static res:Strings.AiSettings_AddModel}" Foreground="{DynamicResource LumiTextMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </StackPanel>

        <!-- 詳細：隨選取切換（連線表單／模型表單／沒選時的提示）。表單卡片照內容長高 -->
        <Panel x:Name="DetailHost" Classes="detail">
          <TextBlock x:Name="DetailPlaceholder" IsVisible="{Binding ShowPlaceholder}" Text="{x:Static res:Strings.Conn_Select}" Classes="muted"
                     TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" />
          <views:ConnectionsPanel x:Name="ConnectionsPanel" DataContext="{Binding Connections}" />
          <views:ModelsPanel x:Name="ModelsPanel" DataContext="{Binding Models}" />
        </Panel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
