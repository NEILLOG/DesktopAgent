<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Lumi.App.Resources"
        x:Class="Lumi.App.Views.ConfirmDialog"
        Title="{x:Static res:Strings.Workbench_Title}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="18">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="{x:Static res:Strings.Confirm_Cancel}" IsCancel="True" />
      <Button x:Name="ConfirmButton" IsDefault="True"
              Background="{DynamicResource LumiPrimaryButtonBrush}" Foreground="{DynamicResource LumiPrimaryButtonTextBrush}" />
    </StackPanel>
  </StackPanel>
</Window>
