<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Lumi.App.Resources"
        x:Class="Lumi.App.Views.ConfirmDialog"
        Title="{x:Static res:Strings.Workbench_Title}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- 按鈕層級：取消 = secondary；確認 = primary（一般）或 danger（破壞性，見建構子）。只有一個 primary／danger -->
  <StackPanel Margin="24" Spacing="24">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Classes="secondary" Padding="16,8" Content="{x:Static res:Strings.Confirm_Cancel}" IsCancel="True" />
      <Button x:Name="ConfirmButton" Padding="16,8" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
