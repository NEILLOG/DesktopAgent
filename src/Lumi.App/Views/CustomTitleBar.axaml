<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             x:Class="Lumi.App.Views.CustomTitleBar"
             x:DataType="vm:WorkbenchViewModel"
             Height="40">

  <UserControl.Styles>
    <!-- chrome 層級（無框、Text 色、hover SurfaceAlt）給齒輪用；樣式與工具列共用 -->
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />

    <!-- 小精靈模式：Soft 底、圖示加文字（ui-guide.html 第 6 節，tertiary 以外的視窗層級入口） -->
    <Style Selector="Button.spriteMode">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.spriteMode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
    <Style Selector="Button.spriteMode:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
    <Style Selector="Button.spriteMode:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.spriteMode:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>

    <!-- 齒輪：chrome 的無框透明底與 hover 由 ChatStyles 提供；這裡只定 32×32 與圓角 9（ui-usage-and-topbar.md 1.1） -->
    <Style Selector="Button.titleIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- RWD（根節點 class）：按鈕位置固定，只切換文字（RWD原則 3.1）。這一段要放在最後，才蓋得過上面的預設 -->
    <Style Selector="TextBlock.label-short">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact TextBlock.label-full">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact TextBlock.label-short">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.narrow TextBlock.label-full">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.narrow Button.spriteMode">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="36" />
    </Style>
  </UserControl.Styles>

  <!-- 整條標題列都是拖曳面（Background 要有值才吃得到滑鼠）；按鈕自己處理點擊，不會觸發拖曳 -->
  <Border x:Name="TitleBarSurface" Background="{DynamicResource LumiChromeBrush}">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
      <!-- macOS 讓出紅綠燈、Windows 的左邊界 -->
      <Border x:Name="LeftSpacer" Grid.Column="0" Width="16" />

      <!-- 只顯示軟體名稱，不放 logo -->
      <TextBlock x:Name="Brand" Grid.Column="1" Text="{x:Static res:Strings.TitleBar_Brand}" FontWeight="SemiBold" VerticalAlignment="Center" />

      <!-- Grid.Column=2 是中間的空白，拖曳由 TitleBarSurface 處理 -->

      <!-- 小精靈模式：隱藏工作台、顯示小精靈。回應中停用，停用時的 Tooltip 說明原因 -->
      <Button x:Name="SpriteModeButton" Grid.Column="3" Classes="spriteMode"
              Command="{Binding EnterSpriteModeCommand}"
              ToolTip.Tip="{Binding SpriteModeTip}" ToolTip.ShowOnDisabled="True"
              AutomationProperties.Name="{x:Static res:Strings.Workbench_SpriteMode}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ctl:LumiIcon Data="{StaticResource LumiIconSparkle}" Size="16" />
          <!-- Wide：完整標籤；Compact：短標籤；Narrow：只剩圖示（Tooltip 與 AutomationProperties.Name 不變） -->
          <TextBlock x:Name="SpriteModeLabel" Classes="label-full" Text="{x:Static res:Strings.Workbench_SpriteMode}" VerticalAlignment="Center" />
          <TextBlock x:Name="SpriteModeShortLabel" Classes="label-short" Text="{x:Static res:Strings.Workbench_SpriteModeShort}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- 設定（齒輪）：開設定獨立視窗。回應中也可以用；和小精靈按鈕一起隱藏（設定視窗本身沒有） -->
      <Button x:Name="SettingsButton" Grid.Column="4" Classes="chrome titleIcon" Margin="8,0,0,0"
              Command="{Binding OpenSettingsCommand}"
              ToolTip.Tip="{x:Static res:Strings.Workbench_Settings}"
              AutomationProperties.Name="{x:Static res:Strings.Workbench_Settings}">
        <ctl:LumiIcon Data="{StaticResource LumiIconSettings}" Size="16" />
      </Button>

      <!-- 和系統按鈕之間的分隔線（Windows） -->
      <Border x:Name="Divider" Grid.Column="5" Width="1" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"
              Background="{DynamicResource LumiBorderBrush}" />

      <!-- Windows：為系統按鈕保留的寬度；macOS：右邊界 -->
      <Border x:Name="RightSpacer" Grid.Column="6" Width="16" />
    </Grid>
  </Border>
</UserControl>
