<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumi.App.ViewModels"
        xmlns:res="using:Lumi.App.Resources"
        xmlns:ctl="using:Lumi.App.Controls"
        xmlns:views="using:Lumi.App.Views"
        Icon="avares://Lumi.App/Assets/Icons/lumi-256.png"
        x:Class="Lumi.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="1040" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource LumiWarningTextBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 區段標題 20／700（ui-guide.html 第 2 節） -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeTitle}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- 色票卡片：色塊（那套色票自己的 Accent／Hover／Soft／Text）、「使用中」徽章只在選取的卡片顯示（文字，不只靠顏色） -->
    <Style Selector="ListBox.palette ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    </Style>
    <Style Selector="ListBox.cards Border.active-badge">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected Border.active-badge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- 小標籤（程式型／素材型）：中性底，不和狀態徽章混淆 -->
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
    <!-- 載入失敗（Danger 淡底）與警告（Warning 淡底）：每項一行，圖示＋種類文字＋說明 -->
    <Style Selector="Border.issue">
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.issue.fatal">
      <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    </Style>
    <Style Selector="Border.issue.fatal TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
    </Style>
    <Style Selector="Border.issue.fatal ctl|LumiIcon">
      <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
    </Style>
    <Style Selector="Border.issue.warn">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.issue.warn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiWarningTextBrush}" />
    </Style>
    <Style Selector="Border.issue.warn ctl|LumiIcon">
      <Setter Property="Foreground" Value="{DynamicResource LumiWarningIconBrush}" />
    </Style>
    <!-- 選取列用 Soft 底＋OnSoft 文字（ui-guide.html 第 3 節），文字對比 ≥ 4.5:1 -->
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>

    <!-- Menu（ui-guide.html 第 3 節）：項目圓角 10；選取＝Soft 底＋OnSoft 文字；停用＝淡色，說明另外寫在 Caption -->
    <Style Selector="ListBox.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem">
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem:selected /template/ ContentPresenter, ListBox.menu ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.menu ListBoxItem:selected:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
    <!-- 語音頁的測試結果（同 ConnectionsPanel）：成功＝Soft 底＋勾；失敗＝Danger 淡底＋三角形＋文字 -->
    <Style Selector="Border.result">
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.result.ok">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
    </Style>
    <Style Selector="Border.result.fail">
      <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem TextBlock.menu-main">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem TextBlock.menu-caption">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- 自訂標題列：只要 L 標誌與品牌，沒有小精靈按鈕（不需要工作台的 DataContext） -->
    <views:CustomTitleBar x:Name="TitleBar" Grid.Row="0" ShowSpriteButton="False" DataContext="{x:Null}" />

    <Grid Grid.Row="1" ColumnDefinitions="240,*">

    <!-- 左側 Menu（寬 240）：回到對話、分類、底部說明 -->
    <Border x:Name="Menu" Grid.Column="0" Background="{DynamicResource LumiChromeBrush}"
            BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="8,16,8,0">
          <TextBlock x:Name="MenuVersion" Text="{Binding VersionText}" FontSize="{DynamicResource LumiFontSizeCaption}"
                     Foreground="{DynamicResource LumiTextMutedBrush}" />
          <TextBlock x:Name="MenuKeysNote" Text="{x:Static res:Strings.Settings_MenuKeysNote}" FontSize="{DynamicResource LumiFontSizeCaption}"
                     Foreground="{DynamicResource LumiTextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 回到對話（tertiary）：關閉設定、顯示工作台；有未儲存的變更先詢問 -->
        <Button x:Name="BackToChatButton" DockPanel.Dock="Top" Classes="tertiary"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"
                Command="{Binding ReturnToChatCommand}"
                ToolTip.Tip="{x:Static res:Strings.Settings_BackToChatTip}"
                AutomationProperties.Name="{x:Static res:Strings.Settings_BackToChat}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:LumiIcon Data="{StaticResource LumiIconArrowLeft}" Size="16" />
            <TextBlock Text="{x:Static res:Strings.Settings_BackToChat}" FontSize="{DynamicResource LumiFontSizeBody}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Border DockPanel.Dock="Top" Classes="divider" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- 分類：順序與 SettingsCategory 一致（0 設定首頁、1 AI 連線、2 用量與費用、3 人格與主動性、4 記憶、5 提醒排程、6 工具、7 外觀與操作、8 小精靈、9 語音、10 網路、11 資料與隱私） -->
            <ListBox x:Name="CategoryList" Classes="menu" SelectedIndex="{Binding CategoryIndex}"
                     AutomationProperties.Name="{x:Static res:Strings.Settings_CategoriesName}">
              <ListBoxItem x:Name="CategoryHome" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryHome}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconHome}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryHome}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryHomeSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryConnections" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryConnections}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconDiamond}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryConnections}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryConnectionsSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!-- 需要處理的橘點（不只靠顏色：有 AutomationProperties.HelpText） -->
                  <Ellipse x:Name="ConnectionsAttentionDot" Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Margin="8,0,0,0"
                           Fill="{DynamicResource LumiWarningDotBrush}" IsVisible="{Binding Home.AttentionConnections}"
                           AutomationProperties.HelpText="{x:Static res:Strings.Home_Attention}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryUsage" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryUsage}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconBarChart}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryUsage}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryUsageHint}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryPersona" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryPersona}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconUser}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryPersona}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryPersonaSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryMemory" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryMemory}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconBrain}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryMemory}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryMemorySub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryReminders" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryReminders}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconBell}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryReminders}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryRemindersSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryTools" AutomationProperties.Name="{x:Static res:Strings.Tools_MenuTitle}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconWrench}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Tools_MenuTitle}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Tools_MenuSubtitle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryGeneral" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryGeneral}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconSun}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryGeneral}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryGeneralSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategorySprite" AutomationProperties.Name="{x:Static res:Strings.Settings_CategorySprite}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconSparkle}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategorySprite}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategorySpriteSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategorySpeech" AutomationProperties.Name="{x:Static res:Strings.Settings_CategorySpeech}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconMic}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategorySpeech}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategorySpeechSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!-- 需要處理的橘點（不只靠顏色：有 AutomationProperties.HelpText） -->
                  <Ellipse x:Name="SpeechAttentionDot" Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Margin="8,0,0,0"
                           Fill="{DynamicResource LumiWarningDotBrush}" IsVisible="{Binding Home.AttentionSpeech}"
                           AutomationProperties.HelpText="{x:Static res:Strings.Home_Attention}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryNetwork" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryNetwork}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconGlobe}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryNetwork}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryNetworkSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryPrivacy" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryPrivacy}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconShield}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryPrivacy}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryPrivacySub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!-- 設定檔損毀或版本太新 -->
      <Border Grid.Row="0" IsVisible="{Binding HasLoadProblem}" Margin="32,16,32,0" Padding="12,8" CornerRadius="10" BorderThickness="1"
              Background="{DynamicResource LumiWarningBackgroundBrush}" BorderBrush="{DynamicResource LumiWarningBorderBrush}">
        <TextBlock Text="{Binding LoadProblem}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
      </Border>

      <!-- ===== AI 連線（M22 22D：連線與模型合成一頁）：頁首（主要動作固定是「新增連線」）→ 預設模型 → 清單＋詳細，整頁一起捲 ===== -->
      <Grid x:Name="ConnectionsPage" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowConnectionsAndModels}" Margin="32">
        <views:SettingsPageHeader x:Name="ConnectionsHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryConnections}"
                                  Title="{x:Static res:Strings.Settings_HeaderConnectionsTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderConnectionsDescription}">
          <views:SettingsPageHeader.Actions>
            <Button x:Name="NewConnectionButton" Classes="primary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                    Command="{Binding AiSettings.NewConnectionCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Conn_New}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconPlus}" Size="16" />
                <TextBlock Text="{x:Static res:Strings.Conn_New}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </views:SettingsPageHeader.Actions>
        </views:SettingsPageHeader>

        <views:AiConnectionsView x:Name="AiPage" Grid.Row="1" DataContext="{Binding AiSettings}" />
      </Grid>

      <!-- ===== 人格與主動性：區段標題＋分隔線的表單（欄位不包卡片）；底部 重設（secondary）／儲存（primary） ===== -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowPersona}">
       <StackPanel Margin="32">
        <views:SettingsPageHeader x:Name="PersonaHeader"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryPersona}"
                                  Title="{x:Static res:Strings.Settings_HeaderPersonaTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderPersonaDescription}" />
        <ctl:FractionWidthLimiter MaxPixels="560" HorizontalAlignment="Stretch">
          <StackPanel x:Name="PersonaForm" DataContext="{Binding Persona}" x:DataType="vm:PersonaViewModel">

            <StackPanel x:Name="PersonaStyleSection" Spacing="16">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Persona_SectionStyle}" />
              <ctl:FormField Label="{x:Static res:Strings.Persona_Style}" Hint="{Binding SelectedStyleHint}">
                <ComboBox x:Name="PersonaStyleBox" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static res:Strings.Persona_Style}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PersonaStyleOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </ctl:FormField>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel x:Name="PersonaProactivitySection" Spacing="16">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Persona_SectionProactivity}" />
              <ctl:FormField Label="{x:Static res:Strings.Persona_Proactivity}" Hint="{Binding SelectedProactivityHint}">
                <ComboBox x:Name="PersonaProactivityBox" ItemsSource="{Binding Proactivities}" SelectedItem="{Binding SelectedProactivity}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static res:Strings.Persona_Proactivity}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProactivityOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </ctl:FormField>
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Persona_ProactivityNote}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel x:Name="PersonaCustomSection" Spacing="16">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Persona_Custom}" />
              <ctl:FormField Label="{x:Static res:Strings.Persona_CustomLabel}" Requirement="Optional"
                             Hint="{x:Static res:Strings.Persona_CustomNote}" Error="{Binding CustomError}">
                <StackPanel Spacing="4">
                  <TextBox x:Name="PersonaCustomBox" Text="{Binding CustomPersona}" Classes.error="{Binding HasCustomError}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="256"
                           Watermark="{x:Static res:Strings.Persona_CustomPlaceholder}"
                           AutomationProperties.Name="{x:Static res:Strings.Persona_Custom}"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  <TextBlock x:Name="PersonaCounter" Classes="muted" Text="{Binding CustomCounter}" HorizontalAlignment="Right" />
                </StackPanel>
              </ctl:FormField>
            </StackPanel>

            <Border Classes="divider" />

            <!-- 動作列：訊息在左，重設（secondary）與儲存（primary，這一區唯一的 Primary）在右 -->
            <Grid x:Name="PersonaActions" ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock x:Name="PersonaMessage" Grid.Column="0" Classes="muted" Classes.error="{Binding MessageIsError}"
                         IsVisible="{Binding HasMessage}" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="PersonaResetButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Persona_Reset}" Command="{Binding ResetCommand}" />
                <Button x:Name="PersonaSaveButton" Classes="primary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Persona_Save}" Command="{Binding SaveCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ctl:FractionWidthLimiter>
       </StackPanel>
      </ScrollViewer>

      <!-- ===== 記憶：頁首（新增記憶，唯一的 Primary）→ 面板（開關、用量、新增表單、清單、全部清除）。面板自己捲動 ===== -->
      <Grid x:Name="MemoryPage" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowMemory}" Margin="32">
        <views:SettingsPageHeader x:Name="MemoryHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryMemory}"
                                  Title="{x:Static res:Strings.Settings_HeaderMemoryTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderMemoryDescription}">
          <views:SettingsPageHeader.Actions>
            <Button x:Name="NewMemoryButton" Classes="primary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                    Command="{Binding Memory.NewCommand}" AutomationProperties.Name="{x:Static res:Strings.Memory_New}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconPlus}" Size="16" />
                <TextBlock Text="{x:Static res:Strings.Memory_New}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </views:SettingsPageHeader.Actions>
        </views:SettingsPageHeader>

        <views:MemoryPanel x:Name="MemoryPanel" Grid.Row="1" Margin="0,24,0,0" DataContext="{Binding Memory}" />
      </Grid>

      <!-- ===== 設定首頁：常用設定的連結（沒有主要動作） ===== -->
      <Grid x:Name="HomePage" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowHome}" Margin="32">
        <views:SettingsPageHeader x:Name="HomeHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryHome}"
                                  Title="{x:Static res:Strings.Settings_HeaderHomeTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderHomeDescription}" />
        <views:HomePanel x:Name="HomePanel" Grid.Row="1" Margin="0,24,0,0" />
      </Grid>

      <!-- ===== 提醒排程：頁首（沒有主要動作，只能刪除）→ 面板。面板自己捲動 ===== -->
      <Grid x:Name="RemindersPage" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowReminders}" Margin="32">
        <views:SettingsPageHeader x:Name="RemindersHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryReminders}"
                                  Title="{x:Static res:Strings.Settings_HeaderRemindersTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderRemindersDescription}" />
        <views:RemindersPanel x:Name="RemindersPanel" Grid.Row="1" Margin="0,24,0,0" DataContext="{Binding Reminders}" />
      </Grid>

      <!-- ===== 資料與隱私：存放位置、哪些內容會送出去、怎麼控制。面板自己捲動 ===== -->
      <!-- ===== 用量與費用（M23）：頁首 → 面板（面板自己捲動） ===== -->
      <Grid x:Name="UsagePage" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowUsage}" Margin="32">
        <views:SettingsPageHeader x:Name="UsageHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryUsage}"
                                  Title="{x:Static res:Strings.UsagePage_Title}" />
        <views:UsagePanel x:Name="UsagePanel" Grid.Row="1" Margin="0,24,0,0" DataContext="{Binding Usage}" />
      </Grid>

      <Grid x:Name="PrivacyPage" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowPrivacy}" Margin="32">
        <views:SettingsPageHeader x:Name="PrivacyHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryPrivacy}"
                                  Title="{x:Static res:Strings.Settings_HeaderPrivacyTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderPrivacyDescription}" />
        <views:DataPrivacyPanel x:Name="PrivacyPanel" Grid.Row="1" Margin="0,24,0,0" DataContext="{Binding Privacy}" />
      </Grid>

      <!-- ===== 工具：頁首（沒有主要動作）→ 面板（說明、群組、恢復預設）。面板自己捲動 ===== -->
      <Grid x:Name="ToolsPage" Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowTools}" Margin="32">
        <views:SettingsPageHeader x:Name="ToolsHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Tools_HeaderEyebrow}"
                                  Title="{x:Static res:Strings.Tools_HeaderTitle}"
                                  Description="{x:Static res:Strings.Tools_HeaderDescription}">
          <views:SettingsPageHeader.Actions>
            <!-- 工具清單分段沒有主要動作；MCP 伺服器分段是「新增伺服器」（這一區唯一的 Primary） -->
            <Button x:Name="NewMcpServerButton" Classes="primary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                    IsVisible="{Binding ShowMcpTab}" Command="{Binding McpServers.HeaderPrimaryActionCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Mcp_AddServer}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconPlus}" Size="16" />
                <TextBlock Text="{x:Static res:Strings.Mcp_AddServer}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </views:SettingsPageHeader.Actions>
        </views:SettingsPageHeader>

        <!-- 分段切換：綁 ToolsTabIndex，0 = 工具清單、1 = MCP 伺服器 -->
        <Border x:Name="ToolsTabSwitch" Grid.Row="1" Classes="segmented" HorizontalAlignment="Left" Margin="0,24,0,0">
          <StackPanel x:Name="ToolsTabSwitchPanel" Orientation="Horizontal" Spacing="4" KeyboardNavigation.TabNavigation="Once"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_TabsName}">
            <RadioButton x:Name="TabToolsList" GroupName="ToolsTabs" Content="{x:Static res:Strings.Tools_TabList}"
                         IsChecked="{Binding ToolsTabIndex, Mode=TwoWay, Converter={x:Static views:TabIndexConverter.Instance}, ConverterParameter=0}" />
            <RadioButton x:Name="TabToolsMcp" GroupName="ToolsTabs" Content="{x:Static res:Strings.Tools_TabMcp}"
                         IsChecked="{Binding ToolsTabIndex, Mode=TwoWay, Converter={x:Static views:TabIndexConverter.Instance}, ConverterParameter=1}" />
          </StackPanel>
        </Border>

        <Panel Grid.Row="2" Margin="0,24,0,0" IsVisible="{Binding ShowToolsListTab}">
          <views:ToolsPanel x:Name="ToolsPanel" DataContext="{Binding Tools}" />
        </Panel>
        <Panel Grid.Row="2" Margin="0,24,0,0" IsVisible="{Binding ShowMcpTab}">
          <views:McpServersPanel x:Name="McpServersPanel" DataContext="{Binding McpServers}" />
        </Panel>
      </Grid>

      <!-- ===== 外觀與操作：主題色票（五張可選取的小卡片）→ 分隔線 → 明暗 ===== -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowGeneral}">
       <StackPanel Margin="32">
        <views:SettingsPageHeader x:Name="GeneralHeader"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryGeneral}"
                                  Title="{x:Static res:Strings.Settings_HeaderGeneralTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderGeneralDescription}" />
        <ctl:FractionWidthLimiter MaxPixels="720" HorizontalAlignment="Stretch">
          <StackPanel DataContext="{Binding General}" x:DataType="vm:GeneralViewModel">

            <StackPanel x:Name="PaletteSection" Spacing="8">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.General_Palette}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.General_PaletteNote}" TextWrapping="Wrap" />

              <!-- 一個色票一張卡片（巢狀一層）；選取＝Soft 底＋Accent 邊框＋「使用中」文字徽章；點選立即套用。
                   色塊是該色票自己的顏色（PalettePreview 讀 Palettes/{id}.axaml），不是目前主題的 token -->
              <ListBox x:Name="PaletteBox" Classes="cards palette" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}"
                       Margin="0,8,0,0"
                       AutomationProperties.Name="{x:Static res:Strings.General_Palette}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem" x:DataType="vm:PaletteOption">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                  </Style>
                  <Style Selector="ListBoxItem:selected" x:DataType="vm:PaletteOption">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationNameActive}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteOption">
                    <Border Classes="card" Width="200">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource LumiFontSizeCard}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Classes="swatch" Background="{Binding Id, Converter={x:Static views:PaletteSwatchConverter.Instance}, ConverterParameter=Accent}" />
                            <Border Classes="swatch" Background="{Binding Id, Converter={x:Static views:PaletteSwatchConverter.Instance}, ConverterParameter=Hover}" />
                            <Border Classes="swatch" Background="{Binding Id, Converter={x:Static views:PaletteSwatchConverter.Instance}, ConverterParameter=Soft}" />
                            <Border Classes="swatch" Background="{Binding Id, Converter={x:Static views:PaletteSwatchConverter.Instance}, ConverterParameter=Text}" />
                          </StackPanel>
                          <Border Grid.Column="1" Classes="badge active-badge">
                            <TextBlock Text="{x:Static res:Strings.Common_Active}" />
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel x:Name="ThemeSection" Spacing="16" MaxWidth="420" HorizontalAlignment="Left">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.General_Theme}" />
              <ctl:FormField Label="{x:Static res:Strings.General_ThemeMode}" Hint="{x:Static res:Strings.General_ThemeHint}">
                <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static res:Strings.General_ThemeMode}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </ctl:FormField>
            </StackPanel>

            <Border Classes="divider" />

            <!-- 筆記資料夾（M10 10B）：路徑欄位＋選擇資料夾（secondary）＋恢復預設（tertiary）。Enter 或離開欄位時套用，沒有儲存鈕（SettingsWindow.axaml.cs） -->
            <StackPanel x:Name="NotesFolderSection" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.NotesFolder_Title}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.NotesFolder_Note}" TextWrapping="Wrap" />
              <ctl:FormField x:Name="NotesFolderField" Label="{x:Static res:Strings.NotesFolder_Label}" Requirement="Optional"
                             Hint="{x:Static res:Strings.NotesFolder_Hint}" Error="{Binding NotesFolderError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="NotesFolderBox" Grid.Column="0" Text="{Binding NotesFolderInput}" Watermark="{Binding NotesFolderDefault}"
                           Classes.error="{Binding NotesFolderError, Converter={x:Static ObjectConverters.IsNotNull}}"
                           AutomationProperties.Name="{x:Static res:Strings.NotesFolder_Label}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NotesFolderChooseButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                            Content="{x:Static res:Strings.NotesFolder_Choose}" Command="{Binding ChooseNotesFolderCommand}" />
                    <Button x:Name="NotesFolderResetButton" Classes="tertiary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                            Content="{x:Static res:Strings.NotesFolder_Reset}" Command="{Binding ResetNotesFolderCommand}"
                            IsEnabled="{Binding IsNotesFolderCustomized}" />
                  </StackPanel>
                </Grid>
              </ctl:FormField>
            </StackPanel>

            <Border Classes="divider" Margin="0,16" />

            <!-- 啟動與更新：開機後自動啟動、啟動時檢查新版（勾選立即儲存）、目前版本與立即檢查 -->
            <StackPanel x:Name="StartupSection" DataContext="{Binding Startup}" x:DataType="vm:StartupViewModel" Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Startup_Title}" />
              <CheckBox x:Name="LaunchAtLoginBox" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" IsEnabled="{Binding LaunchSupported}"
                        Content="{x:Static res:Strings.Startup_LaunchAtLogin}"
                        AutomationProperties.Name="{x:Static res:Strings.Startup_LaunchAtLogin}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Startup_LaunchAtLoginNote}" TextWrapping="Wrap" />
              <TextBlock x:Name="LaunchUnsupportedNote" Classes="muted" Text="{x:Static res:Strings.Startup_LaunchUnsupported}" TextWrapping="Wrap"
                         IsVisible="{Binding LaunchUnsupported}" />

              <CheckBox x:Name="CheckForUpdatesBox" Margin="0,8,0,0" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                        Content="{x:Static res:Strings.Update_CheckAtStartup}"
                        AutomationProperties.Name="{x:Static res:Strings.Update_CheckAtStartup}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Update_CheckAtStartupNote}" TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <TextBlock x:Name="VersionText" Text="{Binding VersionText}" VerticalAlignment="Center" />
                <Button x:Name="CheckUpdateButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Update_CheckNow}" Command="{Binding CheckNowCommand}"
                        IsVisible="{Binding CanCheck}" />
                <Button x:Name="OpenUpdateButton" Classes="tertiary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Update_Download}" Command="{Binding OpenDownloadCommand}"
                        IsVisible="{Binding HasUpdate}" />
              </StackPanel>
              <TextBlock x:Name="UpdateStatus" Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
              <TextBlock x:Name="StartupError" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            </StackPanel>

            <Border Classes="divider" Margin="0,16" />

            <!-- 進階：預設關閉的顯示選項，勾選立即儲存 -->
            <StackPanel x:Name="AdvancedSection" Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Advanced_Title}" />
              <CheckBox x:Name="ShowTokenUsageBox" IsChecked="{Binding ShowTokenUsage, Mode=TwoWay}"
                        Content="{x:Static res:Strings.Advanced_ShowTokenUsage}"
                        AutomationProperties.Name="{x:Static res:Strings.Advanced_ShowTokenUsage}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Advanced_ShowTokenUsageNote}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="GeneralError" Classes="error" Margin="0,16,0,0" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </ctl:FractionWidthLimiter>
       </StackPanel>
      </ScrollViewer>

      <!-- ===== 小精靈：預覽（左 240，< 900 改放上方）＋ 角色卡片清單、尺寸、語氣、狀態預覽（選了立即生效，沒有 Primary） =====
           標題與預覽區固定不捲；只有右欄（設定內容）在自己的 ScrollViewer 裡捲動，所以捲到底預覽仍在視野內 -->
      <Grid Grid.Row="1" IsVisible="{Binding ShowSprite}" Margin="32" RowDefinitions="Auto,*">
        <views:SettingsPageHeader x:Name="SpriteHeader" Grid.Row="0"
                                  Eyebrow="{x:Static res:Strings.Settings_CategorySprite}"
                                  Title="{x:Static res:Strings.Settings_HeaderSpriteTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderSpriteDescription}" />
        <Grid x:Name="SpritePanel" Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" DataContext="{Binding Sprite}" x:DataType="vm:SpriteSettingsViewModel">

          <!-- 預覽區（一個物件，所以是卡片）：用同一個角色即時播放所選的狀態。master／detail 的版面規則見 Themes/Controls.axaml -->
          <Panel x:Name="SpritePreviewArea" Classes="master" VerticalAlignment="Top">
            <Border x:Name="SpritePreviewCard" Classes="card" Width="240" Height="240" Padding="0" HorizontalAlignment="Left">
              <Border x:Name="SpritePreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Panel>

          <ScrollViewer x:Name="SpriteScroll" Classes="detail" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ctl:FractionWidthLimiter x:Name="SpriteDetail" MaxPixels="560" HorizontalAlignment="Stretch">
            <StackPanel>

              <!-- 角色 -->
              <StackPanel x:Name="SpriteCharacterSection" Spacing="8">
                <TextBlock Classes="section-title" Text="{x:Static res:Strings.SpriteSettings_Character}" />
                <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_CharacterNote}" TextWrapping="Wrap" />
                <ListBox x:Name="SpriteList" Classes="cards" Margin="0,8,0,0" ItemsSource="{Binding Sprites}" SelectedItem="{Binding SelectedSprite}"
                         AutomationProperties.Name="{x:Static res:Strings.SpriteSettings_Character}">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:SpriteOption">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SpriteOption">
                      <Border Classes="card" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                          <!-- 縮圖：素材型角色的 preview.png（沒有就顯示佔位圖示）；像素圖用最近鄰，不要糊掉 -->
                          <Border Grid.Column="0" Width="48" Height="48" CornerRadius="{StaticResource LumiRadiusInput}" ClipToBounds="True"
                                  Background="{DynamicResource LumiSurfaceAltBrush}">
                            <Panel>
                              <ctl:LumiIcon Data="{StaticResource LumiIconSparkle}" Size="20" Foreground="{DynamicResource LumiTextMutedBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding PreviewPath, Converter={x:Static ObjectConverters.IsNull}}" />
                              <Image Source="{Binding PreviewPath, Converter={x:Static views:PathToBitmapConverter.Instance}}" Stretch="Uniform"
                                     RenderOptions.BitmapInterpolationMode="None"
                                     IsVisible="{Binding PreviewPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource LumiFontSizeCard}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" Text="{Binding Credit}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Classes="tag" HorizontalAlignment="Right"><TextBlock Text="{Binding KindText}" /></Border>
                            <Border Classes="badge active-badge" HorizontalAlignment="Right"><TextBlock Text="{x:Static res:Strings.Common_Active}" /></Border>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- 角色資料夾：放好素材後按「重新載入」。兩個都是 secondary（選了立即生效，這一區沒有 Primary） -->
                <StackPanel Spacing="8" IsVisible="{Binding CanReload}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SpriteReloadButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                            Content="{Binding ReloadLabel}" Command="{Binding ReloadCommand}" />
                    <Button x:Name="SpriteOpenFolderButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                            Content="{x:Static res:Strings.SpriteSettings_OpenFolder}" Command="{Binding OpenFolderCommand}"
                            IsVisible="{Binding HasSpritesDirectory}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_FolderNote}" TextWrapping="Wrap" />
                  <TextBlock x:Name="SpriteFolderPath" Classes="muted mono" Text="{Binding SpritesDirectory}" TextWrapping="Wrap" IsVisible="{Binding HasSpritesDirectory}" />
                </StackPanel>

                <!-- 載入失敗與警告：每項一行，三角圖示＋種類文字（失敗用 Danger 淡底、警告用 Warning 淡底），不只靠顏色 -->
                <StackPanel x:Name="SpriteIssuesPanel" Spacing="8" IsVisible="{Binding HasIssues}" Margin="0,8,0,0">
                  <TextBlock Text="{x:Static res:Strings.SpriteSettings_Issues}" FontSize="{DynamicResource LumiFontSizeBody}" FontWeight="Bold" />
                  <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_IssuesNote}" TextWrapping="Wrap" />
                  <ItemsControl x:Name="SpriteIssueList" ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpriteIssueItem">
                        <Border Classes="issue" Classes.fatal="{Binding IsFatal}" Classes.warn="{Binding !IsFatal}">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconAlertTriangle}" Size="16" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding KindText}" FontSize="{DynamicResource LumiFontSizeCaption}" FontWeight="Bold" />
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource LumiFontSizeCaption}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <Border Classes="divider" />

              <!-- 大小與語氣 -->
              <StackPanel x:Name="SpriteLookSection" Spacing="16">
                <TextBlock Classes="section-title" Text="{x:Static res:Strings.SpriteSettings_SectionLook}" />
                <ctl:FormField Label="{x:Static res:Strings.SpriteSettings_Size}" Hint="{x:Static res:Strings.SpriteSettings_SizeNote}">
                  <ComboBox x:Name="SpriteSizeBox" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Static res:Strings.SpriteSettings_Size}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SpriteSizeOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </ctl:FormField>
                <ctl:FormField Label="{x:Static res:Strings.SpriteSettings_Voice}" Hint="{x:Static res:Strings.SpriteSettings_VoiceNote}">
                  <CheckBox x:Name="SpriteVoiceBox" IsChecked="{Binding VoiceEnabled}" Content="{x:Static res:Strings.SpriteSettings_VoiceToggle}" />
                </ctl:FormField>
                <TextBlock Classes="muted" IsVisible="{Binding HasNoVoice}" Text="{x:Static res:Strings.SpriteSettings_VoiceNone}" TextWrapping="Wrap" />
                <ctl:FormField Label="{x:Static res:Strings.SpriteSettings_Topmost}" Hint="{x:Static res:Strings.SpriteSettings_TopmostNote}">
                  <CheckBox x:Name="SpriteTopmostBox" IsChecked="{Binding AlwaysOnTop}" Content="{x:Static res:Strings.SpriteSettings_TopmostToggle}" />
                </ctl:FormField>
              </StackPanel>

              <Border Classes="divider" />

              <!-- 狀態預覽 -->
              <StackPanel x:Name="SpritePreviewSection" Spacing="8">
                <TextBlock Classes="section-title" Text="{x:Static res:Strings.SpriteSettings_Preview}" />
                <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_PreviewNote}" TextWrapping="Wrap" />
                <ListBox x:Name="SpriteStateList" Classes="rows" Margin="0,8,0,0" ItemsSource="{Binding States}" SelectedItem="{Binding PreviewState}"
                         AutomationProperties.Name="{x:Static res:Strings.SpriteSettings_Preview}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SpriteStateItem">
                      <Grid ColumnDefinitions="112,*">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <TextBlock Classes="error" Margin="0,16,0,0" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ctl:FractionWidthLimiter>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- ===== 語音：服務（端點、語言、逾時）→ Token → 測試結果與動作列（測試連線 secondary、還原 secondary、儲存 primary） ===== -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSpeech}">
       <StackPanel Margin="32">
        <views:SettingsPageHeader x:Name="SpeechHeader"
                                  Eyebrow="{x:Static res:Strings.Settings_CategorySpeech}"
                                  Title="{x:Static res:Strings.Settings_HeaderSpeechTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderSpeechDescription}" />
        <ctl:FractionWidthLimiter MaxPixels="560" HorizontalAlignment="Stretch">
          <StackPanel x:Name="SpeechForm" DataContext="{Binding Speech}" x:DataType="vm:SpeechViewModel">

            <StackPanel x:Name="SpeechServiceSection" Spacing="16">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Speech_SectionService}" />
              <ctl:FormField x:Name="SpeechEndpointField" Label="{x:Static res:Strings.Speech_Endpoint}" Requirement="Required"
                             Hint="{x:Static res:Strings.Speech_EndpointHint}" Error="{Binding EndpointError}">
                <TextBox x:Name="SpeechEndpointBox" Text="{Binding Endpoint}" Classes.error="{Binding EndpointError, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Watermark="{x:Static res:Strings.Speech_EndpointWatermark}"
                         AutomationProperties.Name="{x:Static res:Strings.Speech_Endpoint}" />
              </ctl:FormField>

              <ctl:FormField x:Name="SpeechLanguageField" Label="{x:Static res:Strings.Speech_Language}" Requirement="Optional"
                             Hint="{x:Static res:Strings.Speech_LanguageHint}">
                <StackPanel Spacing="8">
                  <TextBox x:Name="SpeechLanguageBox" Text="{Binding Language}" Watermark="{x:Static res:Strings.Speech_LanguageWatermark}"
                           AutomationProperties.Name="{x:Static res:Strings.Speech_Language}" />
                  <!-- 常用快選：tertiary，文字就是名稱；「留空」由服務端判斷 -->
                  <WrapPanel>
                    <Button x:Name="SpeechLangAutoButton" Classes="tertiary" Margin="0,0,8,8" Padding="12,8"
                            Content="{x:Static res:Strings.Speech_LangAuto}" Command="{Binding SetLanguageCommand}" CommandParameter="" />
                    <Button x:Name="SpeechLangZhButton" Classes="tertiary" Margin="0,0,8,8" Padding="12,8"
                            Content="{x:Static res:Strings.Speech_LangZh}" Command="{Binding SetLanguageCommand}" CommandParameter="zh" />
                    <Button x:Name="SpeechLangEnButton" Classes="tertiary" Margin="0,0,8,8" Padding="12,8"
                            Content="{x:Static res:Strings.Speech_LangEn}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                    <Button x:Name="SpeechLangJaButton" Classes="tertiary" Margin="0,0,8,8" Padding="12,8"
                            Content="{x:Static res:Strings.Speech_LangJa}" Command="{Binding SetLanguageCommand}" CommandParameter="ja" />
                  </WrapPanel>
                </StackPanel>
              </ctl:FormField>

              <ctl:FormField x:Name="SpeechTimeoutField" Label="{x:Static res:Strings.Speech_Timeout}" Requirement="Required"
                             Hint="{x:Static res:Strings.Speech_TimeoutHint}" Error="{Binding TimeoutError}">
                <TextBox x:Name="SpeechTimeoutBox" Text="{Binding TimeoutText}" Width="120" HorizontalAlignment="Left"
                         Classes.error="{Binding TimeoutError, Converter={x:Static ObjectConverters.IsNotNull}}"
                         AutomationProperties.Name="{x:Static res:Strings.Speech_Timeout}" />
              </ctl:FormField>

              <TextBlock x:Name="SpeechPrivacyNote" Classes="muted" Text="{x:Static res:Strings.Speech_NotePrivacy}" TextWrapping="Wrap" />
              <TextBlock x:Name="SpeechCertificateNote" Classes="muted" Text="{x:Static res:Strings.Speech_NoteCertificate}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" />

            <!-- Token：已設定時顯示「已設定 · 結尾 xxxx」與更換／清除；端點主機變了就改顯示警告並要求重新輸入 -->
            <StackPanel x:Name="SpeechTokenSection" Spacing="16">
              <TextBlock Classes="section-title" Text="{x:Static res:Strings.Speech_SectionToken}" />
              <ctl:FormField x:Name="SpeechTokenField" Label="{x:Static res:Strings.Speech_Token}" Requirement="Required"
                             Hint="{x:Static res:Strings.Speech_TokenNote}">
                <StackPanel Spacing="8">
                  <Grid x:Name="SpeechTokenStatusRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowTokenStatus}">
                    <TextBlock Grid.Column="0" Text="{Binding TokenStatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button x:Name="SpeechReplaceTokenButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                              Content="{x:Static res:Strings.Speech_TokenReplace}" Command="{Binding ReplaceTokenCommand}" IsVisible="{Binding !ReplacingToken}" />
                      <Button x:Name="SpeechClearTokenButton" Classes="tertiary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                              Content="{x:Static res:Strings.Speech_TokenClear}" Command="{Binding ClearTokenCommand}" IsVisible="{Binding !ReplacingToken}" />
                      <Button x:Name="SpeechCancelReplaceTokenButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                              Content="{x:Static res:Strings.Speech_TokenCancelReplace}" Command="{Binding CancelReplaceTokenCommand}" IsVisible="{Binding ReplacingToken}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="SpeechTokenHostChangedText" Classes="warning" Text="{x:Static res:Strings.Speech_TokenHostChanged}"
                             IsVisible="{Binding HostChanged}" />
                  <Grid x:Name="SpeechTokenInputRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowTokenInput}">
                    <TextBox x:Name="SpeechTokenBox" Grid.Column="0" Text="{Binding NewToken}" PasswordChar="•" RevealPassword="{Binding RevealToken}"
                             Watermark="{x:Static res:Strings.Speech_TokenPlaceholder}" AutomationProperties.Name="{x:Static res:Strings.Speech_Token}" />
                    <ToggleButton x:Name="SpeechRevealTokenButton" Grid.Column="1" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                                  Content="{x:Static res:Strings.Speech_TokenShow}" IsChecked="{Binding RevealToken}" />
                  </Grid>
                </StackPanel>
              </ctl:FormField>
            </StackPanel>

            <Border Classes="divider" />

            <!-- 測試結果：成功＝Success 淡底＋勾＋文字；失敗＝Danger 淡底＋三角＋原因文字（不只靠顏色）；停用的原因寫在動作列旁邊 -->
            <StackPanel x:Name="SpeechResults" Spacing="8">
              <Border x:Name="SpeechTestOk" Classes="result ok" IsVisible="{Binding ShowTestOk}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconCheck}" Size="16" Foreground="{DynamicResource LumiSuccessBrush}" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Text="{Binding TestResultText}" TextWrapping="Wrap" Foreground="{DynamicResource LumiTextOnSoftBrush}" />
                </Grid>
              </Border>
              <Border x:Name="SpeechTestFail" Classes="result fail" IsVisible="{Binding ShowTestFailure}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconAlertTriangle}" Size="16" Foreground="{DynamicResource LumiDangerBrush}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static res:Strings.Speech_TestFailed}" FontWeight="Bold" Foreground="{DynamicResource LumiDangerBrush}" />
                    <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" Foreground="{DynamicResource LumiDangerBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <!-- 動作列：左邊是訊息與停用原因，右邊是測試連線（secondary）、還原（secondary）、儲存（primary，這一區唯一的 Primary） -->
            <Grid x:Name="SpeechActions" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,16,0,0">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="SpeechMessage" Classes="muted" Classes.error="{Binding MessageIsError}"
                           IsVisible="{Binding HasMessage}" Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock x:Name="SpeechTestBlockedText" Classes="muted" Text="{Binding TestBlockedReason}" TextWrapping="Wrap"
                           IsVisible="{Binding HasTestBlockedReason}" />
                <TextBlock x:Name="SpeechSaveBlockedText" Classes="muted" Text="{Binding SaveBlockedReason}" TextWrapping="Wrap"
                           IsVisible="{Binding HasSaveBlockedReason}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="SpeechTestButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Speech_Test}" Command="{Binding TestCommand}" IsVisible="{Binding !IsTesting}" />
                <TextBlock x:Name="SpeechTestingText" Text="{x:Static res:Strings.Speech_Testing}" IsVisible="{Binding IsTesting}" VerticalAlignment="Center" />
                <Button x:Name="SpeechRevertButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Speech_Revert}" Command="{Binding RevertCommand}" />
                <Button x:Name="SpeechSaveButton" Classes="primary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                        Content="{x:Static res:Strings.Speech_Save}" Command="{Binding SaveCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ctl:FractionWidthLimiter>
       </StackPanel>
      </ScrollViewer>

      <!-- 網路與 Proxy（M17 17G）：頁首與表單都在 NetworkPanel；下半部是瀏覽器設定（M18 18I，立即生效，和上面的儲存無關） -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowNetwork}">
        <StackPanel>
          <views:NetworkPanel DataContext="{Binding Network}" />
          <ctl:FractionWidthLimiter MaxPixels="560" HorizontalAlignment="Stretch" Margin="32,0,32,32">
            <StackPanel x:Name="BrowserSectionHost" DataContext="{Binding Browser}" x:DataType="vm:BrowserSettingsViewModel">
              <Border Classes="divider" />
              <views:BrowserSettingsSection />
            </StackPanel>
          </ctl:FractionWidthLimiter>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </Grid>
  </Grid>
</Window>
