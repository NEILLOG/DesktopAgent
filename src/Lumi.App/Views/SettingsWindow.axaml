<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumi.App.ViewModels"
        xmlns:res="using:Lumi.App.Resources"
        xmlns:ctl="using:Lumi.App.Controls"
        xmlns:views="using:Lumi.App.Views"
        x:Class="Lumi.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource LumiWarningTextBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
    </Style>
    <!-- 選取列用 Soft 底＋OnSoft 文字（ui-guide.html 第 3 節），文字對比 ≥ 4.5:1 -->
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>

    <!-- Menu（ui-guide.html 第 3 節）：項目圓角 10；選取＝Soft 底＋OnSoft 文字；停用＝淡色，說明另外寫在 Caption -->
    <Style Selector="ListBox.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem">
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem:selected /template/ ContentPresenter, ListBox.menu ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.menu ListBoxItem:selected:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem TextBlock.menu-main">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.menu ListBoxItem TextBlock.menu-caption">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- 自訂標題列：只要 L 標誌與品牌，沒有小精靈按鈕（不需要工作台的 DataContext） -->
    <views:CustomTitleBar x:Name="TitleBar" Grid.Row="0" ShowSpriteButton="False" DataContext="{x:Null}" />

    <Grid Grid.Row="1" ColumnDefinitions="240,*">

    <!-- 左側 Menu（寬 240）：標題區、回到對話、分類、即將推出、底部說明 -->
    <Border x:Name="Menu" Grid.Column="0" Background="{DynamicResource LumiChromeBrush}"
            BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="8,16,8,0">
          <TextBlock x:Name="MenuVersion" Text="{Binding VersionText}" FontSize="{DynamicResource LumiFontSizeCaption}"
                     Foreground="{DynamicResource LumiTextMutedBrush}" />
          <TextBlock x:Name="MenuKeysNote" Text="{x:Static res:Strings.Settings_MenuKeysNote}" FontSize="{DynamicResource LumiFontSizeCaption}"
                     Foreground="{DynamicResource LumiTextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 標題區 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="8,0,8,0">
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource LumiRadiusInput}" Margin="0,0,12,0"
                  Background="{DynamicResource LumiAccentSoftBrush}">
            <TextBlock Text="{x:Static res:Strings.TitleBar_LogoMark}" FontWeight="Bold" FontSize="{DynamicResource LumiFontSizeBody}"
                       Foreground="{DynamicResource LumiAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="MenuTitle" Text="{x:Static res:Strings.Settings_MenuTitle}" FontSize="{DynamicResource LumiFontSizeBody}" FontWeight="Bold"
                       Foreground="{DynamicResource LumiTextBrush}" />
            <TextBlock Text="{x:Static res:Strings.Settings_MenuSubtitle}" FontSize="{DynamicResource LumiFontSizeCaption}"
                       Foreground="{DynamicResource LumiTextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <!-- 回到對話（tertiary）：關閉設定、顯示工作台；有未儲存的變更先詢問 -->
        <Button x:Name="BackToChatButton" DockPanel.Dock="Top" Classes="tertiary" Margin="0,16,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"
                Command="{Binding ReturnToChatCommand}"
                ToolTip.Tip="{x:Static res:Strings.Settings_BackToChatTip}"
                AutomationProperties.Name="{x:Static res:Strings.Settings_BackToChat}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:LumiIcon Data="{StaticResource LumiIconArrowLeft}" Size="16" />
            <TextBlock Text="{x:Static res:Strings.Settings_BackToChat}" FontSize="{DynamicResource LumiFontSizeBody}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Border DockPanel.Dock="Top" Classes="divider" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- 分類：索引與 CategoryIndex 一致（0 AI 連線、1 人格與主動性、2 外觀與操作、3 小精靈） -->
            <ListBox x:Name="CategoryList" Classes="menu" SelectedIndex="{Binding CategoryIndex}">
              <ListBoxItem x:Name="CategoryConnections" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryConnections}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconDiamond}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryConnections}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryConnectionsSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryPersona" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryPersona}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconUser}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryPersona}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryPersonaSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryGeneral" AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryGeneral}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconSun}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryGeneral}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategoryGeneralSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategorySprite" AutomationProperties.Name="{x:Static res:Strings.Settings_CategorySprite}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconSparkle}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategorySprite}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_CategorySpriteSub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
            </ListBox>

            <Border Classes="divider" />

            <!-- 還沒有後端的項目：停用，可見的 Caption 與 Tooltip 都寫「即將推出」 -->
            <ListBox x:Name="ComingSoonList" Classes="menu" Focusable="False" SelectionMode="Single">
              <ListBoxItem x:Name="CategoryHome" IsEnabled="False" ToolTip.Tip="{x:Static res:Strings.Settings_ComingSoon}" ToolTip.ShowOnDisabled="True"
                           AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryHome}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconHome}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryHome}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_ComingSoon}" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
              <ListBoxItem x:Name="CategoryPrivacy" IsEnabled="False" ToolTip.Tip="{x:Static res:Strings.Settings_ComingSoon}" ToolTip.ShowOnDisabled="True"
                           AutomationProperties.Name="{x:Static res:Strings.Settings_CategoryPrivacy}">
                <Grid ColumnDefinitions="Auto,*">
                  <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconShield}" Size="18" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="menu-main" Text="{x:Static res:Strings.Settings_CategoryPrivacy}" />
                    <TextBlock Classes="menu-caption" Text="{x:Static res:Strings.Settings_ComingSoon}" />
                  </StackPanel>
                </Grid>
              </ListBoxItem>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!-- 設定檔損毀或版本太新 -->
      <Border Grid.Row="0" IsVisible="{Binding HasLoadProblem}" Margin="32,16,32,0" Padding="12,8" CornerRadius="10" BorderThickness="1"
              Background="{DynamicResource LumiWarningBackgroundBrush}" BorderBrush="{DynamicResource LumiWarningBorderBrush}">
        <TextBlock Text="{Binding LoadProblem}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
      </Border>

      <!-- ===== 連線與模型 ===== -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowConnectionsAndModels}" Margin="32">
      <views:SettingsPageHeader x:Name="ConnectionsHeader" Grid.Row="0"
                                Eyebrow="{x:Static res:Strings.Settings_CategoryConnections}"
                                Title="{x:Static res:Strings.Settings_HeaderConnectionsTitle}"
                                Description="{x:Static res:Strings.Settings_HeaderConnectionsDescription}" />
      <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex}">

        <!-- 連線 -->
        <TabItem Header="{x:Static res:Strings.Settings_TabConnections}">
          <Grid ColumnDefinitions="260,*" Margin="0,8,0,0" DataContext="{Binding Connections}" x:DataType="vm:ConnectionsViewModel">

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
              <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                      Content="{x:Static res:Strings.Conn_New}" Command="{Binding NewConnectionCommand}" />
              <ListBox Classes="rows" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectionListItem">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel Grid.Column="0" Width="12" Margin="0,5,10,0" VerticalAlignment="Top">
                        <Ellipse Width="10" Height="10" IsVisible="{Binding IsOk}" Fill="{DynamicResource LumiSuccessBrush}" />
                        <Ellipse Width="10" Height="10" IsVisible="{Binding IsFailed}" Fill="{DynamicResource LumiDangerBrush}" />
                        <Ellipse Width="10" Height="10" IsVisible="{Binding IsUnknown}" Fill="{DynamicResource LumiBorderStrongBrush}" />
                      </Panel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted">
                          <Run Text="{Binding FormatText}" /><Run Text=" · " /><Run Text="{Binding ModelCountText}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <Panel Grid.Column="1">
              <TextBlock IsVisible="{Binding ShowPlaceholder}" Text="{x:Static res:Strings.Conn_Select}" Classes="muted"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <ScrollViewer IsVisible="{Binding HasEditor}">
                <StackPanel Spacing="6" Margin="0,0,12,16" MaxWidth="560" HorizontalAlignment="Left">

                  <Border IsVisible="{Binding HasNotice}" Padding="12,8" CornerRadius="8" BorderThickness="1"
                          Background="{DynamicResource LumiAccentSoftBrush}" BorderBrush="{DynamicResource LumiAccentBorderBrush}">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource LumiAccentTextBrush}" />
                  </Border>

                  <TextBlock Classes="label" Text="{x:Static res:Strings.Conn_Name}" />
                  <TextBox Text="{Binding Name}" />
                  <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <TextBlock Classes="label" Text="{x:Static res:Strings.Conn_Format}" />
                  <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FormatOption">
                        <TextBlock Text="{Binding Text}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Classes="label" Text="{x:Static res:Strings.Conn_BaseUrl}" />
                  <TextBox Text="{Binding BaseUrl}" />
                  <TextBlock Classes="error" Text="{Binding BaseUrlError}" IsVisible="{Binding BaseUrlError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="warning" Text="{Binding BaseUrlWarning}" IsVisible="{Binding BaseUrlWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <!-- 金鑰：已存的永遠不讀回來顯示，只顯示「已設定 · 結尾 xxxx」 -->
                  <TextBlock Classes="label" Text="{x:Static res:Strings.Conn_ApiKey}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowKeyStatus}">
                    <TextBlock Text="{Binding KeyStatusText}" VerticalAlignment="Center" />
                    <Button Content="{x:Static res:Strings.Conn_KeyReplace}" Command="{Binding ReplaceKeyCommand}" IsVisible="{Binding !ReplacingKey}" />
                    <Button Content="{x:Static res:Strings.Conn_KeyClear}" Command="{Binding ClearKeyCommand}" IsVisible="{Binding !ReplacingKey}" />
                    <Button Content="{x:Static res:Strings.Conn_KeyCancel}" Command="{Binding CancelReplaceKeyCommand}" IsVisible="{Binding ReplacingKey}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowKeyInput}">
                    <TextBox x:Name="KeyBox" Grid.Column="0" Text="{Binding NewApiKey}" PasswordChar="•" RevealPassword="{Binding RevealKey}"
                             Watermark="{x:Static res:Strings.Conn_KeyPlaceholder}" />
                    <ToggleButton Grid.Column="1" Margin="8,0,0,0" Content="{x:Static res:Strings.Conn_KeyShow}" IsChecked="{Binding RevealKey}" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Conn_KeyOptionalHint}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.ApiKey_Note}" />

                  <!-- 測試連線：用表單上目前的設定與還沒儲存的金鑰 -->
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button Content="{x:Static res:Strings.Conn_Test}" Command="{Binding TestCommand}" IsVisible="{Binding !IsTesting}" />
                    <TextBlock Text="{x:Static res:Strings.Conn_Testing}" IsVisible="{Binding IsTesting}" VerticalAlignment="Center" />
                    <Button Content="{x:Static res:Strings.Conn_TestCancel}" Command="{Binding CancelTestCommand}" IsVisible="{Binding IsTesting}" />
                  </StackPanel>
                  <TextBlock Text="{Binding TestResultText}" IsVisible="{Binding ShowTestOk}" TextWrapping="Wrap"
                             Foreground="{DynamicResource LumiSuccessBrush}" />
                  <TextBlock Text="{Binding TestResultText}" IsVisible="{Binding ShowTestFailure}" TextWrapping="Wrap"
                             Foreground="{DynamicResource LumiDangerBrush}" />

                  <TextBlock Classes="error" Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}" />

                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Classes="primary" Content="{x:Static res:Strings.Conn_Save}" Command="{Binding SaveCommand}" />
                    <Button Content="{x:Static res:Strings.Conn_Delete}" Command="{Binding DeleteCommand}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Grid>
        </TabItem>

        <!-- 模型設定 -->
        <TabItem Header="{x:Static res:Strings.Settings_TabModels}">
          <Grid RowDefinitions="Auto,*" Margin="0,8,0,0" DataContext="{Binding Models}" x:DataType="vm:ModelsViewModel">

            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,12,10">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="label" Text="{x:Static res:Strings.Models_WorkbenchDefault}" />
                  <ComboBox ItemsSource="{Binding DefaultOptions}" SelectedItem="{Binding WorkbenchOption}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModelOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="{x:Static res:Strings.Models_SpriteDefault}" />
                  <ComboBox ItemsSource="{Binding DefaultOptions}" SelectedItem="{Binding SpriteOption}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModelOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Border IsVisible="{Binding DefaultChangedNotice, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="12,8" CornerRadius="8" BorderThickness="1"
                      Background="{DynamicResource LumiAccentSoftBrush}" BorderBrush="{DynamicResource LumiAccentBorderBrush}">
                <TextBlock Text="{Binding DefaultChangedNotice}" TextWrapping="Wrap" Foreground="{DynamicResource LumiAccentTextBrush}" />
              </Border>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="260,*">
              <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="6">
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Models_NeedConnection}" IsVisible="{Binding ShowNeedConnectionHint}" />
                  <Button HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Models_New}" Command="{Binding NewModelCommand}" />
                </StackPanel>
                <ListBox Classes="rows" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModelListItem">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontWeight="Medium" Text="{Binding Badges}" IsVisible="{Binding HasBadges}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <Panel Grid.Column="1">
                <TextBlock IsVisible="{Binding ShowPlaceholder}" Text="{x:Static res:Strings.Models_Select}" Classes="muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ScrollViewer IsVisible="{Binding HasEditor}">
                  <StackPanel Spacing="6" Margin="0,0,12,16" MaxWidth="560" HorizontalAlignment="Left">

                    <TextBlock Classes="label" Text="{x:Static res:Strings.Models_Connection}" />
                    <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ConnectionOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Classes="label" Text="{x:Static res:Strings.Models_ModelId}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox Grid.Column="0" IsEditable="True" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding AvailableModelIds}" Text="{Binding ModelId}" />
                      <Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static res:Strings.Models_Refresh}" Command="{Binding RefreshModelListCommand}" />
                    </Grid>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ListStatusText}" IsVisible="{Binding HasListStatus}" />
                    <TextBlock Classes="error" Text="{Binding ModelIdError}" IsVisible="{Binding ModelIdError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Classes="label" Text="{x:Static res:Strings.Models_DisplayName}" />
                    <TextBox Text="{Binding DisplayName}" />
                    <TextBlock Classes="error" Text="{Binding DisplayNameError}" IsVisible="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.Models_MaxOutput}" />
                        <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1" Increment="256" FormatString="0" />
                        <TextBlock Classes="error" Text="{Binding MaxOutputError}" IsVisible="{Binding MaxOutputError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.Models_ContextWindow}" />
                        <NumericUpDown Value="{Binding ContextWindow}" Minimum="1" Increment="1000" FormatString="0" />
                        <TextBlock Classes="error" Text="{Binding ContextWindowError}" IsVisible="{Binding ContextWindowError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </Grid>

                    <CheckBox Margin="0,8,0,0" Content="{x:Static res:Strings.Models_ShowThinking}" IsChecked="{Binding ShowThinking}" />
                    <CheckBox x:Name="ToolsEnabledCheckBox" Content="{x:Static res:Strings.Models_ToolsEnabled}" IsChecked="{Binding ToolsEnabled}"
                              ToolTip.Tip="{x:Static res:Strings.Models_ToolsEnabledHint}" />

                    <TextBlock Classes="error" Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                      <Button Classes="primary" Content="{x:Static res:Strings.Conn_Save}" Command="{Binding SaveCommand}" />
                      <Button Content="{x:Static res:Strings.Conn_Delete}" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Panel>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
      </Grid>

      <!-- ===== 人格與主動性 ===== -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowPersona}">
       <StackPanel Margin="32">
        <views:SettingsPageHeader x:Name="PersonaHeader"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryPersona}"
                                  Title="{x:Static res:Strings.Settings_HeaderPersonaTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderPersonaDescription}" />
        <StackPanel Spacing="8" DataContext="{Binding Persona}" x:DataType="vm:PersonaViewModel" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Classes="label" Text="{x:Static res:Strings.Persona_Style}" />
          <ComboBox x:Name="PersonaStyleBox" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PersonaStyleOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="muted" Text="{Binding SelectedStyleHint}" TextWrapping="Wrap" />

          <TextBlock Classes="label" Margin="0,12,0,0" Text="{x:Static res:Strings.Persona_Proactivity}" />
          <ComboBox x:Name="PersonaProactivityBox" ItemsSource="{Binding Proactivities}" SelectedItem="{Binding SelectedProactivity}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProactivityOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="muted" Text="{Binding SelectedProactivityHint}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Persona_ProactivityNote}" TextWrapping="Wrap" />

          <TextBlock Classes="label" Margin="0,12,0,0" Text="{x:Static res:Strings.Persona_Custom}" />
          <TextBox x:Name="PersonaCustomBox" Text="{Binding CustomPersona}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="110" MaxHeight="260" Watermark="{x:Static res:Strings.Persona_CustomPlaceholder}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.Persona_CustomNote}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding CustomCounter}" Margin="12,0,0,0" />
          </Grid>
          <TextBlock Classes="error" Text="{Binding CustomError}" IsVisible="{Binding HasCustomError}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="PersonaSaveButton" Classes="primary" Content="{x:Static res:Strings.Persona_Save}" Command="{Binding SaveCommand}" />
            <Button x:Name="PersonaResetButton" Content="{x:Static res:Strings.Persona_Reset}" Command="{Binding ResetCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" IsVisible="{Binding HasMessage}" Text="{Binding Message}" TextWrapping="Wrap" />
        </StackPanel>
       </StackPanel>
      </ScrollViewer>

      <!-- ===== 一般 ===== -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowGeneral}">
       <StackPanel Margin="32">
        <views:SettingsPageHeader x:Name="GeneralHeader"
                                  Eyebrow="{x:Static res:Strings.Settings_CategoryGeneral}"
                                  Title="{x:Static res:Strings.Settings_HeaderGeneralTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderGeneralDescription}" />
      <StackPanel Spacing="8" DataContext="{Binding General}" x:DataType="vm:GeneralViewModel" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Classes="label" Text="{x:Static res:Strings.General_Theme}" />
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="label" Margin="0,12,0,0" Text="{x:Static res:Strings.General_Palette}" />
        <ComboBox x:Name="PaletteBox" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PaletteOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
       </StackPanel>
      </ScrollViewer>

      <!-- ===== 小精靈：角色、尺寸、語氣、狀態預覽（選了立即生效） ===== -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSprite}">
       <StackPanel Margin="32">
        <views:SettingsPageHeader x:Name="SpriteHeader"
                                  Eyebrow="{x:Static res:Strings.Settings_CategorySprite}"
                                  Title="{x:Static res:Strings.Settings_HeaderSpriteTitle}"
                                  Description="{x:Static res:Strings.Settings_HeaderSpriteDescription}" />
        <Grid x:Name="SpritePanel" ColumnDefinitions="240,*" DataContext="{Binding Sprite}" x:DataType="vm:SpriteSettingsViewModel">
          <!-- 預覽區：用同一個角色即時播放所選的狀態 -->
          <Border Grid.Column="0" VerticalAlignment="Top" Height="240" CornerRadius="14" BorderThickness="1" Margin="0,0,24,0"
                  Background="{DynamicResource LumiSurfaceAltBrush}" BorderBrush="{DynamicResource LumiBorderBrush}">
            <Border x:Name="SpritePreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" Spacing="8" MaxWidth="460" HorizontalAlignment="Left">
            <TextBlock Classes="label" Text="{x:Static res:Strings.SpriteSettings_Character}" />
            <ListBox x:Name="SpriteList" Classes="rows" ItemsSource="{Binding Sprites}" SelectedItem="{Binding SelectedSprite}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpriteOption">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- 縮圖：素材型角色的 preview.png（沒有就空著）；像素圖用最近鄰，不要糊掉 -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True"
                            Background="{DynamicResource LumiSurfaceAltBrush}" IsVisible="{Binding PreviewPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Image Source="{Binding PreviewPath, Converter={x:Static views:PathToBitmapConverter.Instance}}" Stretch="Uniform"
                             RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Text="{Binding Credit}" Classes="muted" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding KindText}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_CharacterNote}" TextWrapping="Wrap" />

            <!-- 角色資料夾：放好素材後按「重新載入」 -->
            <StackPanel Spacing="6" IsVisible="{Binding CanReload}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SpriteReloadButton" Content="{Binding ReloadLabel}" Command="{Binding ReloadCommand}" />
                <Button x:Name="SpriteOpenFolderButton" Content="{x:Static res:Strings.SpriteSettings_OpenFolder}" Command="{Binding OpenFolderCommand}"
                        IsVisible="{Binding HasSpritesDirectory}" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_FolderNote}" TextWrapping="Wrap" />
              <TextBlock x:Name="SpriteFolderPath" Classes="muted mono" Text="{Binding SpritesDirectory}" TextWrapping="Wrap" IsVisible="{Binding HasSpritesDirectory}" />
            </StackPanel>

            <!-- 載入失敗與警告 -->
            <StackPanel x:Name="SpriteIssuesPanel" Spacing="4" IsVisible="{Binding HasIssues}" Margin="0,4,0,0">
              <TextBlock Classes="label" Text="{x:Static res:Strings.SpriteSettings_Issues}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_IssuesNote}" TextWrapping="Wrap" />
              <ItemsControl x:Name="SpriteIssueList" ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpriteIssueItem">
                    <Grid ColumnDefinitions="20,*" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Icon}" FontWeight="Bold" Foreground="{DynamicResource LumiWarningIconBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource LumiFontSizeCaption}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Classes="label" Margin="0,12,0,0" Text="{x:Static res:Strings.SpriteSettings_Size}" />
            <ComboBox x:Name="SpriteSizeBox" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SpriteSizeOption"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_SizeNote}" TextWrapping="Wrap" />

            <TextBlock Classes="label" Margin="0,12,0,0" Text="{x:Static res:Strings.SpriteSettings_Voice}" />
            <CheckBox x:Name="SpriteVoiceBox" IsChecked="{Binding VoiceEnabled}" Content="{x:Static res:Strings.SpriteSettings_VoiceToggle}" />
            <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_VoiceNote}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" IsVisible="{Binding HasNoVoice}" Text="{x:Static res:Strings.SpriteSettings_VoiceNone}" TextWrapping="Wrap" />

            <TextBlock Classes="label" Margin="0,12,0,0" Text="{x:Static res:Strings.SpriteSettings_Preview}" />
            <TextBlock Classes="muted" Text="{x:Static res:Strings.SpriteSettings_PreviewNote}" TextWrapping="Wrap" />
            <ListBox x:Name="SpriteStateList" Classes="rows" ItemsSource="{Binding States}" SelectedItem="{Binding PreviewState}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpriteStateItem">
                  <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Medium" />
                    <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>
       </StackPanel>
      </ScrollViewer>
    </Grid>
    </Grid>
  </Grid>
</Window>
