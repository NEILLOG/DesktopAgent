<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:local="using:Lumi.App.Views"
             x:Class="Lumi.App.Views.HomePanel"
             x:DataType="vm:SettingsViewModel">

  <!--
    設定首頁（M20 20G）：狀態總覽。6 張卡片（AI 連線、提醒排程、記憶、工具、外觀與操作、網路），
    每張顯示目前的值與需要注意的地方；點卡片用 GoToCommand 切到對應分類。
    寬視窗 2 欄、窄視窗（Window.narrow）1 欄。卡片沒有開關，只顯示狀態。
  -->
  <UserControl.Resources>
    <local:IconKeyConverter x:Key="IconKeyConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 一張卡片：Surface 底、1px 邊框、卡片圓角；整張是按鈕，hover／按下換成 Surface Alt 底與較強的邊框 -->
    <Style Selector="Button.home-card">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusCard}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.home-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.home-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    </Style>
    <!-- 卡片標題（Caption 11、次要色、SemiBold）；數值 14／600 -->
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.card-value">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Warning 淡底：「需要處理」，文字一定寫出來（不只靠顏色）；同 MemoryPanel 的寫法 -->
    <Style Selector="Border.warn-badge">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.warn-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LumiWarningTextBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
    <!-- RWD：寬視窗 2 欄、窄視窗 1 欄 -->
    <Style Selector="Window.narrow UniformGrid.home-grid">
      <Setter Property="Columns" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ctl:FractionWidthLimiter MaxPixels="720" HorizontalAlignment="Stretch">
      <ItemsControl x:Name="HomeCardList" ItemsSource="{Binding Home.Cards}"
                    AutomationProperties.Name="{x:Static res:Strings.Home_CardsName}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" Classes="home-grid" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HomeCardViewModel">
            <Button Classes="home-card" Margin="0,0,12,12"
                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).GoToCommand}"
                    CommandParameter="{Binding Section}"
                    AutomationProperties.Name="{Binding Title}">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:LumiIcon Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" Size="18"
                                Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="card-title" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ctl:LumiIcon Grid.Column="2" Data="{StaticResource LumiIconChevronRight}" Size="16"
                                Foreground="{DynamicResource LumiTextMutedBrush}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="card-value" Text="{Binding Value}" />
                <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                <Border Classes="warn-badge" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding NeedsAttention}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <ctl:LumiIcon Data="{StaticResource LumiIconAlertTriangle}" Size="12" Foreground="{DynamicResource LumiWarningTextBrush}"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static res:Strings.Home_Attention}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ctl:FractionWidthLimiter>
  </ScrollViewer>
</UserControl>
