<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:views="using:Lumi.App.Views"
             xmlns:ctl="using:Lumi.App.Controls"
             x:Class="Lumi.App.Views.ToolRunView"
             x:DataType="vm:ToolRunViewModel">
  <!--
    一段連續的工具呼叫：少於 3 個直接各自顯示卡片；3 個以上包成一張群組卡（標題是摘要，展開後是各張卡片）。
    左側留出和助理氣泡一樣的位置（光球的寬度）。
  -->
  <UserControl.Styles>
    <Style Selector="Border.toolgroup">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.toolgroup.awaiting">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.toolgroup.failed">
      <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    </Style>
    <Style Selector="Button.groupheader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="Button.groupheader:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="Button.groupheader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="24,*" MaxWidth="780" HorizontalAlignment="Left">
    <Panel Grid.Column="1">
      <!-- 少於 3 個：各自一張卡片 -->
      <ItemsControl IsVisible="{Binding ShowSingleCards}" ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolCardViewModel">
            <views:ToolCardView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 3 個以上：群組卡 -->
      <Border IsVisible="{Binding IsGroup}" Classes="toolgroup"
              Classes.awaiting="{Binding GroupHasAwaiting}" Classes.failed="{Binding GroupHasFailure}">
        <StackPanel>
          <Button x:Name="GroupHeader" Classes="groupheader" Command="{Binding ToggleGroupCommand}">
            <Grid ColumnDefinitions="22,*,Auto" VerticalAlignment="Center">
              <Panel Grid.Column="0" Width="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock IsVisible="{Binding GroupAllSucceeded}" Text="✓" FontWeight="Bold" Foreground="{DynamicResource LumiSuccessBrush}" />
                <TextBlock IsVisible="{Binding GroupHasFailure}" Text="✕" FontWeight="Bold" Foreground="{DynamicResource LumiDangerBrush}" />
                <TextBlock IsVisible="{Binding GroupHasAwaiting}" Text="⚠" FontWeight="Bold" Foreground="{DynamicResource LumiWarningIconBrush}" />
              </Panel>
              <ctl:EmojiTextBlock Grid.Column="1" Text="{Binding GroupTitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                  VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCard}" />
              <Panel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock IsVisible="{Binding !GroupIsOpen}" Text="›" Classes="muted" />
                <TextBlock IsVisible="{Binding GroupIsOpen}" Text="⌄" Classes="muted" />
              </Panel>
            </Grid>
          </Button>
          <ItemsControl IsVisible="{Binding GroupIsOpen}" ItemsSource="{Binding Cards}" Margin="8,0,8,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolCardViewModel">
                <views:ToolCardView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
