<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:views="using:Lumi.App.Views"
             xmlns:ctl="using:Lumi.App.Controls"
             x:Class="Lumi.App.Views.ToolRunView"
             x:DataType="vm:ToolRunViewModel">
  <!--
    一段連續的工具呼叫：少於 3 個直接各自顯示卡片；3 個以上包成一張群組卡（標題是摘要，展開後是各張卡片）。
    左側留出和助理氣泡一樣的位置（光球的寬度）。
  -->
  <UserControl.Styles>
    <!-- 群組卡：Border.card（圓角 14、Border 色邊框）；Padding 由標題按鈕與清單的 Margin 負責。裡面的工具卡片是第二層（最多一層巢狀） -->
    <Style Selector="Border.toolgroup">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.toolgroup.awaiting">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.toolgroup.failed">
      <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    </Style>
    <Style Selector="Button.groupheader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <!-- 整列標題是按鈕：Hover／Pressed 不換底，強制展開時的停用也不變灰；Fluent 的狀態規則會把前景改成黑色，所以明確寫回 Text -->
    <Style Selector="Button.groupheader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.groupheader:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.groupheader:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="24,*" MaxWidth="780" HorizontalAlignment="Left">
    <Panel Grid.Column="1">
      <!-- 少於 3 個：各自一張卡片 -->
      <ItemsControl IsVisible="{Binding ShowSingleCards}" ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolCardViewModel">
            <views:ToolCardView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 3 個以上：群組卡 -->
      <Border IsVisible="{Binding IsGroup}" Classes="card toolgroup"
              Classes.awaiting="{Binding GroupHasAwaiting}" Classes.failed="{Binding GroupHasFailure}">
        <StackPanel>
          <Button x:Name="GroupHeader" Classes="groupheader" Command="{Binding ToggleGroupCommand}">
            <Grid ColumnDefinitions="24,*,Auto" VerticalAlignment="Center">
              <Panel Grid.Column="0" Width="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ctl:LumiIcon IsVisible="{Binding GroupAllSucceeded}" Data="{StaticResource LumiIconCheck}" Foreground="{DynamicResource LumiSuccessBrush}" />
                <ctl:LumiIcon IsVisible="{Binding GroupHasFailure}" Data="{StaticResource LumiIconX}" Foreground="{DynamicResource LumiDangerBrush}" />
                <ctl:LumiIcon IsVisible="{Binding GroupHasAwaiting}" Data="{StaticResource LumiIconAlertTriangle}" Foreground="{DynamicResource LumiWarningIconBrush}" />
              </Panel>
              <ctl:EmojiTextBlock Grid.Column="1" Text="{Binding GroupTitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                  VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCard}" />
              <Panel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <ctl:LumiIcon IsVisible="{Binding !GroupIsOpen}" Data="{StaticResource LumiIconChevronRight}" Foreground="{DynamicResource LumiTextMutedBrush}" />
                <ctl:LumiIcon IsVisible="{Binding GroupIsOpen}" Data="{StaticResource LumiIconChevronDown}" Foreground="{DynamicResource LumiTextMutedBrush}" />
              </Panel>
            </Grid>
          </Button>
          <ItemsControl IsVisible="{Binding GroupIsOpen}" ItemsSource="{Binding Cards}" Margin="12,0,12,12">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolCardViewModel">
                <views:ToolCardView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
