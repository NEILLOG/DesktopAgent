<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:views="using:Lumi.App.Views"
             x:Class="Lumi.App.Views.ChatComposer"
             x:DataType="vm:WorkbenchViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
    <!--
      輸入區的版面常數集中在這裡（Wide 值）：外框左右邊距 64（和 ConversationView 的 conversation-page 左右 Padding 對齊）、
      圓角 16（頁面區域）。RWD（UC）只要在根節點 class 下覆寫，例如 Window.compact Border.composer-area { Margin = 24,8,24,16 }。
      外框顏色與邊框粗細全部寫在樣式裡（不寫本地值），所以 focused／dropping 的樣式才蓋得過去。
    -->
    <Style Selector="Border.composer-area">
      <Setter Property="Margin" Value="64,8,64,16" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    </Style>
    <!-- 輸入框取得焦點：外框改 Accent 邊框（InputBox 本身沒有外框；由 code-behind 切換 focused） -->
    <Style Selector="Border.composer-area.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
    </Style>
    <!-- 拖放檔案進來：2px Accent 邊框（要排在 focused 後面，蓋過它） -->
    <Style Selector="Border.composer-area.dropping">
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- 輸入框預設高度：Normal 64（約三行）；short 起縮成兩行高（48），veryshort 沿用（RWD原則 第 5 節）。MaxHeight 160 之後改捲動 -->
    <Style Selector="TextBox#InputBox">
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <!-- 下層工具列的 tertiary 按鈕：32 高，圖示加文字 -->
    <Style Selector="Button.composer-tool">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- chip 上的移除鈕：20x20 的 tertiary 圖示按鈕 -->
    <Style Selector="Button.chip-remove">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- 送出／停止圓鈕（Button.round／send／stop）在 Themes/Controls.axaml，小精靈輸入列共用 -->
    <!-- 使用習慣提示列的外層（輸入框外框之上，只在有提示時佔位置）：左右邊距跟外框一樣（BudgetBanner 同一組數字） -->
    <Style Selector="Border.composer-hint-host">
      <Setter Property="Margin" Value="64,8,64,8" />
    </Style>

    <!--
      RWD（根節點 class；放在最後才蓋得過上面的預設）。
      Compact：Composer 外框左右 Margin 24；檔案、資料夾、麥克風只剩圖示；隱藏 SendHint（RespondingHint 保留，過長省略）。
      Narrow：Margin 16。提示列的左右 Margin 跟外框一樣。
    -->
    <Style Selector="Window.compact Border.composer-area">
      <Setter Property="Margin" Value="24,8,24,16" />
    </Style>
    <Style Selector="Window.narrow Border.composer-area">
      <Setter Property="Margin" Value="16,8,16,16" />
    </Style>
    <Style Selector="Window.compact Border.composer-hint-host">
      <Setter Property="Margin" Value="24,8,24,8" />
    </Style>
    <Style Selector="Window.narrow Border.composer-hint-host">
      <Setter Property="Margin" Value="16,8,16,8" />
    </Style>
    <Style Selector="Window.compact TextBlock.collapsible-label, Window.narrow TextBlock.collapsible-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact Button.collapsible, Window.narrow Button.collapsible">
      <Setter Property="Width" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.compact Border.compact-hidden, Window.compact TextBlock.compact-hidden, Window.narrow Border.compact-hidden, Window.narrow TextBlock.compact-hidden">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!--
      高度規則（根節點 short／veryshort）。兩行高 = 2 × 行高（約 20）+ 上下 Padding 8 = 48；
      下層工具列（送出鈕 36 高）不縮，所以兩行輸入加一列工具按鈕永遠完整可見。
    -->
    <Style Selector="Window.short TextBox#InputBox, Window.veryshort TextBox#InputBox">
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </UserControl.Styles>

  <!--
    輸入區（RWD原則 3.5、ui-spec 第 6 節）：兩層。
    上層：上下文 chip（有項目才出現）＋輸入框（收音時換成收音面板）；下層：加入檔案、加入資料夾、語音輸入｜提示文字｜送出／停止。
    外框、焦點與拖放邊框都由 InputArea 表達，輸入框沒有自己的外框。
  -->
  <StackPanel>
    <!-- 使用習慣提示列（plan 23 第 7 節）：輸入框外框之上，沒有提示時不佔位置；按鈕與文字由 ComposerHintViewModel 決定 -->
    <Border x:Name="ComposerHintHost" Classes="composer-hint-host" IsVisible="{Binding Hint.IsVisible}">
      <views:ComposerHint DataContext="{Binding Hint}" />
    </Border>

    <Border x:Name="InputArea" Classes="composer-area" DragDrop.AllowDrop="True">
      <StackPanel Spacing="8">
        <!-- 此對話的上下文（ui-spec 6.1）：有項目時才出現 -->
        <StackPanel x:Name="ContextBar" DataContext="{Binding Context}" IsVisible="{Binding HasItems}" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Static res:Strings.Context_Title}" Classes="muted" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static res:Strings.Context_TokensHint}">
              <TextBlock Text="{Binding TokensText}" Classes="muted" />
              <ctl:LumiIcon x:Name="OverLimitIcon" IsVisible="{Binding IsOverLimit}" Data="{StaticResource LumiIconAlertTriangle}" Size="16"
                            Foreground="{DynamicResource LumiWarningIconBrush}"
                            ToolTip.Tip="{Binding OverLimitText}" />
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="ContextChips" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextChipViewModel">
                <Border Classes="chip" Classes.folder="{Binding IsFolder}" Classes.problem="{Binding HasProblem}" ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- 圖片縮圖（解碼失敗就沒有） -->
                    <Image IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}" Width="20" Height="20" Stretch="UniformToFill"
                           Source="{Binding Path, Converter={x:Static views:PathToBitmapConverter.Instance}}" />
                    <ctl:EmojiTextBlock Text="{Binding DisplayName}" MaxWidth="220" TextTrimming="CharacterEllipsis" MaxLines="1"
                                        VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCaption}" />
                    <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock IsVisible="{Binding IsSent}" Text="{Binding SentLabel}" Classes="muted" VerticalAlignment="Center" />
                    <Button Classes="tertiary chip-remove" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.Context_Remove}"
                            AutomationProperties.Name="{x:Static res:Strings.Context_Remove}"
                            Command="{Binding $parent[views:ChatComposer].((vm:WorkbenchViewModel)DataContext).Context.RemoveCommand}" CommandParameter="{Binding}">
                      <ctl:LumiIcon Data="{StaticResource LumiIconX}" Size="12" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding HasNotice}" Text="{Binding Notice}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error}" TextWrapping="Wrap"
                     Foreground="{DynamicResource LumiWarningTextBrush}" FontSize="{DynamicResource LumiFontSizeCaption}" />
        </StackPanel>

        <!-- 語音轉寫的文字放進輸入框後的標籤（ui-spec 6.3）：使用者改動或清空後拿掉 -->
        <Border x:Name="VoiceDraftChip" Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding IsVoiceDraft}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:LumiIcon Data="{StaticResource LumiIconMic}" Size="12" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Voice_ChipLabel}" Classes="muted" FontSize="{DynamicResource LumiFontSizeCaption}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <!-- 語音的一次性提示（太短、沒聽到內容、對話已改變）：下次輸入或開始錄音時消失 -->
        <TextBlock x:Name="VoiceNoticeText" IsVisible="{Binding HasVoiceNotice}" Text="{Binding VoiceNotice}" Classes="muted"
                   FontSize="{DynamicResource LumiFontSizeCaption}" TextWrapping="Wrap" />

        <!-- 上層：輸入框（Enter 送出、Shift+Enter 換行：code-behind）；最高 160，之後改捲動。收音時隱藏，由收音面板取代 -->
        <TextBox x:Name="InputBox" Classes="composer"
                 Text="{Binding InputText}"
                 Watermark="{x:Static res:Strings.Workbench_InputPlaceholder}"
                 AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding !IsViewOnly}"
                 IsVisible="{Binding !IsVoiceActive}"
                 MaxHeight="160"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- 收音面板：錄音中／轉寫中／失敗時取代輸入框（ui-spec 6.3） -->
        <views:VoicePanel x:Name="VoicePanelHost" IsVisible="{Binding IsVoiceActive}" />

        <!-- 下層：左 加入檔案／加入資料夾／語音輸入；右 提示文字、送出／停止 -->
        <Grid x:Name="ComposerToolbar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <!-- 回應中停用，Tooltip 說明原因（取代原本佔版面的提示文字） -->
            <Button x:Name="AddFileButton" Classes="tertiary composer-tool collapsible" Command="{Binding Context.AddFileCommand}"
                    ToolTip.Tip="{Binding AddFileTip}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.Context_AddFile}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconPaperclip}" Size="16" />
                <TextBlock Classes="collapsible-label" Text="{x:Static res:Strings.Context_AddFile}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="AddFolderButton" Classes="tertiary composer-tool collapsible" Command="{Binding Context.AddFolderCommand}"
                    ToolTip.Tip="{Binding AddFolderTip}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.Context_AddFolder}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconFolder}" Size="16" />
                <TextBlock Classes="collapsible-label" Text="{x:Static res:Strings.Context_AddFolder}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- 語音輸入：停用時（沒設定、回應中、已在錄音…）Tooltip 寫出原因（ShowOnDisabled） -->
            <Button x:Name="MicButton" Classes="tertiary composer-tool collapsible" Command="{Binding StartVoiceCommand}"
                    ToolTip.Tip="{Binding MicTip}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.Composer_Mic}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconMic}" Size="16" />
                <TextBlock Classes="collapsible-label" Text="{x:Static res:Strings.Composer_Mic}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- 提示文字區：平時是操作提示（SendHint）；回應中改顯示原因（RespondingHint），不另外佔一行 -->
          <Panel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- 外面包一層：Compact 起整個隱藏（SendHint 自己的 IsVisible 是回應中互斥的綁定） -->
            <Border x:Name="SendHintHost" Classes="compact-hidden">
              <TextBlock x:Name="SendHint" IsVisible="{Binding ShowSendHint}" Classes="muted" Text="{x:Static res:Strings.Composer_SendHint}"
                         TextTrimming="CharacterEllipsis" />
            </Border>
            <TextBlock x:Name="RespondingHint" IsVisible="{Binding IsResponding}" Classes="muted" Text="{x:Static res:Strings.Composer_RespondingHint}"
                       TextTrimming="CharacterEllipsis" />
          </Panel>

          <Panel Grid.Column="2" VerticalAlignment="Center">
            <Button x:Name="SendButton" IsVisible="{Binding ShowSendButton}" Classes="round send"
                    ToolTip.Tip="{x:Static res:Strings.Workbench_Send}" AutomationProperties.Name="{x:Static res:Strings.Workbench_Send}"
                    Command="{Binding SendCommand}">
              <ctl:LumiIcon Data="{StaticResource LumiIconArrowUp}" Size="18" />
            </Button>
            <Button x:Name="StopButton" IsVisible="{Binding IsResponding}" Classes="round stop"
                    ToolTip.Tip="{x:Static res:Strings.Workbench_Stop}" AutomationProperties.Name="{x:Static res:Strings.Workbench_Stop}"
                    Command="{Binding StopCommand}">
              <ctl:LumiIcon Data="{StaticResource LumiIconSquare}" Size="14" />
            </Button>
          </Panel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
