<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:views="using:Lumi.App.Views"
             x:Class="Lumi.App.Views.ChatToolbar"
             x:DataType="vm:WorkbenchViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
    <!-- 工具列上的按鈕統一 32 高；secondary／tertiary 的外觀來自 Themes/Controls.axaml -->
    <Style Selector="Button.toolbar">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar.iconOnly">
      <Setter Property="Width" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- 模型膠囊：圓角膠囊形的 secondary，文字過長時省略，不推走其他按鈕 -->
    <Style Selector="Button.capsule">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border BorderThickness="2" CornerRadius="16" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
        </FocusAdornerTemplate>
      </Setter>
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!--
      RWD（根節點 class；放在最後才蓋得過上面的預設）。
      Compact：新對話、歷史對話只剩圖示（Tooltip 與 AutomationProperties.Name 照舊）。
      Narrow：模型膠囊改成「供應商字首方塊 + model ID」。
    -->
    <Style Selector="Window.compact TextBlock.collapsible-label, Window.narrow TextBlock.collapsible-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact Button.collapsible, Window.narrow Button.collapsible">
      <Setter Property="Width" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.narrow-only, TextBlock.capsule-model">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.narrow Panel.narrow-only, Window.narrow TextBlock.capsule-model">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.narrow TextBlock.capsule-full">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- 工具列：新對話、歷史對話 | 模型膠囊 | 「⋯」選單（重新命名、匯出、刪除這則對話） -->
  <Border Padding="12,8"
          Background="{DynamicResource LumiChromeBrush}"
          BorderBrush="{DynamicResource LumiBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewConversationButton" Classes="secondary toolbar collapsible" Command="{Binding NewConversationCommand}"
                ToolTip.Tip="{x:Static res:Strings.Workbench_NewConversation}"
                AutomationProperties.Name="{x:Static res:Strings.Workbench_NewConversation}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:LumiIcon Data="{StaticResource LumiIconPlus}" Size="16" />
            <TextBlock Classes="collapsible-label" Text="{x:Static res:Strings.Workbench_NewConversation}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="HistoryButton" Classes="secondary toolbar collapsible" Command="{Binding History.ToggleCommand}"
                ToolTip.Tip="{x:Static res:Strings.Workbench_History}"
                AutomationProperties.Name="{x:Static res:Strings.Workbench_History}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:LumiIcon Data="{StaticResource LumiIconClock}" Size="16" />
            <TextBlock Classes="collapsible-label" Text="{x:Static res:Strings.Workbench_History}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- 模型切換膠囊：狀態點、「供應商 · model ID」、下拉箭頭。回應中停用，Tooltip 說明原因（不佔版面） -->
      <Button x:Name="CapsuleButton" Grid.Column="1" Classes="secondary toolbar capsule" HorizontalAlignment="Center"
              IsEnabled="{Binding CanSwitchModel}"
              ToolTip.Tip="{Binding ModelCapsuleTip}" ToolTip.ShowOnDisabled="True"
              AutomationProperties.Name="{Binding ModelSwitcher.CapsuleText}">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <views:ModelPicker DataContext="{Binding ModelSwitcher}" />
          </Flyout>
        </Button.Flyout>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" DataContext="{Binding ModelSwitcher}" x:DataType="vm:ModelSwitcherViewModel">
          <!-- 狀態點；Narrow 時後面多一個供應商字首方塊（完整供應商名稱在 Tooltip） -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Panel Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" IsVisible="{Binding IsOk}" Fill="{DynamicResource LumiSuccessDotBrush}" />
              <Ellipse Width="8" Height="8" IsVisible="{Binding IsFailed}" Fill="{DynamicResource LumiDangerDotBrush}" />
              <Ellipse Width="8" Height="8" IsVisible="{Binding IsUnknown}" Fill="{DynamicResource LumiWarningDotBrush}" />
            </Panel>
            <Panel x:Name="ProviderInitialHost" Classes="narrow-only">
              <Border x:Name="ProviderInitialBadge" Width="20" Height="20" CornerRadius="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasCurrent}" Background="{DynamicResource LumiAccentSoftBrush}">
                <TextBlock Text="{Binding ProviderInitial}" FontWeight="Bold" FontSize="{DynamicResource LumiFontSizeCaption}"
                           Foreground="{DynamicResource LumiTextOnSoftBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </StackPanel>
          <!-- Wide／Compact：「供應商 · model ID」；Narrow：只有確切的 model ID。兩者過長都省略 -->
          <TextBlock x:Name="CapsuleFullText" Grid.Column="1" Classes="capsule-full" Text="{Binding CapsuleText}" FontWeight="Medium" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="CapsuleModelIdText" Grid.Column="1" Classes="capsule-model" Text="{Binding CapsuleModelText}" FontWeight="Medium" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <ctl:LumiIcon Grid.Column="2" Data="{StaticResource LumiIconChevronDown}" Size="16"
                        Foreground="{DynamicResource LumiTextMutedBrush}" />
        </Grid>
      </Button>

      <!-- 「⋯」：對話動作（重新命名、匯出、刪除）。設定在第一列的齒輪，管理連線與模型在模型選單底部 -->
      <Button x:Name="MoreButton" Grid.Column="2" Classes="tertiary toolbar iconOnly"
              ToolTip.Tip="{x:Static res:Strings.Workbench_ConversationOptions}"
              AutomationProperties.Name="{x:Static res:Strings.Workbench_ConversationOptions}">
        <ctl:LumiIcon Data="{StaticResource LumiIconMoreHorizontal}" Size="16" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <!-- 回應中：只有重新命名可用；空對話（沒有任何訊息）三項全部停用 -->
            <MenuItem x:Name="RenameMenuItem" Header="{x:Static res:Strings.Workbench_RenameConversation}"
                      Command="{Binding RenameConversationCommand}" IsEnabled="{Binding RenameConversationEnabled}" />
            <MenuItem x:Name="ExportMenuItem" Header="{x:Static res:Strings.Workbench_ExportConversation}"
                      Command="{Binding ExportConversationCommand}" IsEnabled="{Binding ExportConversationEnabled}" />
            <MenuItem x:Name="DeleteMenuItem" Header="{x:Static res:Strings.Workbench_DeleteConversation}"
                      Foreground="{DynamicResource LumiDangerBrush}"
                      Command="{Binding DeleteConversationCommand}" IsEnabled="{Binding DeleteConversationEnabled}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>
  </Border>
</UserControl>
