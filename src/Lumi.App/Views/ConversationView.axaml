<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:views="using:Lumi.App.Views"
             xmlns:md="using:Lumi.App.Markdown"
             x:Class="Lumi.App.Views.ConversationView"
             x:DataType="vm:WorkbenchViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
    <!--
      對話區的版面常數集中在這裡（Wide 值）：左右 Padding 64、訊息間距 24。
      RWD（UC）只要在根節點 class 下覆寫，例如 Window.compact Border.conversation-page { Padding = 24,24 }、
      Window.narrow ... { Padding = 16,24 }；不需要動下面的結構。
    -->
    <Style Selector="Border.conversation-page">
      <Setter Property="Padding" Value="64,24" />
    </Style>
    <Style Selector="StackPanel.conversation-stack">
      <Setter Property="Spacing" Value="24" />
    </Style>
    <!-- 歡迎區上下留白：Normal 上 32；short 縮成 8；veryshort 整個隱藏（外層 WelcomeHost，因為 WelcomePanel 的 IsVisible 綁了 ShowWelcome） -->
    <Style Selector="StackPanel#WelcomePanel">
      <Setter Property="Margin" Value="0,32,0,0" />
    </Style>
    <!-- 助理頭像：32 圓形、Soft 底、Accent 色文字 -->
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    </Style>
    <!-- 訊息上方一行：名稱＋時間 -->
    <Style Selector="TextBlock.sender">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <!-- 動作列按鈕：tertiary（無框），Caption 字級來自 small -->
    <Style Selector="Button.message-action">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      訊息寬度（RWD原則 3.3、計畫「工作台結構」）：FractionWidthLimiter 取「對話區內容寬度 × Fraction」與 MaxPixels 較小者。
      Wide：助理 ≤ 820 且 ≤ 內容區，使用者 ≤ 72%；Compact／Narrow：助理 92%、使用者 80%（沒有像素上限）。
    -->
    <Style Selector="ctl|FractionWidthLimiter.assistant">
      <Setter Property="Fraction" Value="1" />
      <Setter Property="MaxPixels" Value="820" />
    </Style>
    <Style Selector="ctl|FractionWidthLimiter.user">
      <Setter Property="Fraction" Value="0.72" />
    </Style>
    <Style Selector="Window.compact ctl|FractionWidthLimiter.assistant, Window.narrow ctl|FractionWidthLimiter.assistant">
      <Setter Property="Fraction" Value="0.92" />
      <Setter Property="MaxPixels" Value="{x:Static x:Double.PositiveInfinity}" />
    </Style>
    <Style Selector="Window.compact ctl|FractionWidthLimiter.user, Window.narrow ctl|FractionWidthLimiter.user">
      <Setter Property="Fraction" Value="0.8" />
    </Style>

    <!-- 高度規則（RWD原則 第 5 節）：short 訊息垂直間距 24 → 16、歡迎區留白縮小；veryshort 隱藏歡迎區 -->
    <Style Selector="Window.short StackPanel.conversation-stack, Window.veryshort StackPanel.conversation-stack">
      <Setter Property="Spacing" Value="16" />
    </Style>
    <Style Selector="Window.short StackPanel#WelcomePanel, Window.veryshort StackPanel#WelcomePanel">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Window.veryshort Border#WelcomeHost">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Compact：對話區左右 Padding 24、動作列只剩圖示 -->
    <Style Selector="Window.compact Border#ConversationPage.conversation-page">
      <Setter Property="Padding" Value="24,24" />
    </Style>
    <Style Selector="Window.compact TextBlock.action-label, Window.narrow TextBlock.action-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Narrow：Padding 16、隱藏歡迎區副標、隱藏時間與使用者名稱「你」（保留助理名稱）、助理頭像 24 -->
    <Style Selector="Window.narrow Border#ConversationPage.conversation-page">
      <Setter Property="Padding" Value="16,24" />
    </Style>
    <Style Selector="Window.narrow TextBlock#WelcomeSubtitle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.narrow TextBlock.message-time, Window.narrow StackPanel.user-header">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.narrow Border.avatar">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Window.narrow Border.avatar > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
  </UserControl.Styles>

  <!-- 訊息流：歡迎區、一次性提示、訊息（使用者／助理／工具段落）、錯誤列。ScrollViewer 名稱 MessageScroller 保留給測試與自動捲動 -->
  <ScrollViewer x:Name="MessageScroller">
    <Border x:Name="ConversationPage" Classes="conversation-page">
      <StackPanel x:Name="ConversationStack" Classes="conversation-stack">
        <!-- 歡迎區：對話沒有任何訊息（且不在載入中）時顯示（RWD：narrow 隱藏副標、veryshort 整個隱藏） -->
        <Border x:Name="WelcomeHost">
        <StackPanel x:Name="WelcomePanel" IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center" Spacing="12">
          <Border Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="{StaticResource LumiRadiusPanel}"
                  Background="{DynamicResource LumiAccentSoftBrush}">
            <ctl:LumiIcon Data="{StaticResource LumiIconSparkle}" Size="32" Foreground="{DynamicResource LumiAccentBrush}" />
          </Border>
          <TextBlock x:Name="WelcomeTitle" Text="{x:Static res:Strings.Workbench_WelcomeTitle}" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" FontSize="{DynamicResource LumiFontSizeTitle}" FontWeight="Bold" />
          <TextBlock x:Name="WelcomeSubtitle" Text="{x:Static res:Strings.Workbench_WelcomeSubtitle}" Classes="muted"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- 一次性提示：例如設定檔損毀已改用預設 -->
        <Border IsVisible="{Binding HasNotice}" Padding="16,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource LumiWarningTextBrush}" />
            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{x:Static res:Strings.Workbench_DismissNotice}" Command="{Binding DismissNoticeCommand}" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Classes="conversation-stack" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <!-- 工具段落（ToolRunViewModel 繼承 MessageViewModel，所以放前面先比對） -->
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:ToolRunViewModel">
              <views:ToolRunView />
            </DataTemplate>
            <DataTemplate DataType="vm:MessageViewModel" x:DataType="vm:MessageViewModel">
              <Panel>
                <!-- 使用者：靠右；上方是「你」與時間，再來是送出當時帶的檔案、資料夾、圖片 chip，最後是 UserBubble 底色的氣泡 -->
                <ctl:FractionWidthLimiter Classes="user" IsVisible="{Binding IsUser}">
                <StackPanel HorizontalAlignment="Right" Spacing="8">
                  <StackPanel Classes="user-header" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <TextBlock Classes="sender" Text="{x:Static res:Strings.Workbench_You}" />
                    <TextBlock Classes="muted message-time" Text="{Binding TimeText}" VerticalAlignment="Center" />
                  </StackPanel>
                  <ItemsControl IsVisible="{Binding HasAttachments}" ItemsSource="{Binding Attachments}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MessageChipViewModel">
                        <Border Classes="chip" Classes.folder="{Binding IsFolder}" Classes.problem="{Binding HasProblem}"
                                Padding="8,4" ToolTip.Tip="{Binding Tooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:EmojiTextBlock Text="{Binding DisplayName}" MaxWidth="240" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                FontSize="{DynamicResource LumiFontSizeCaption}" />
                            <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" Classes="muted" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Right" Padding="16,12" CornerRadius="{StaticResource LumiRadiusCard}"
                          Background="{DynamicResource LumiUserBubbleBrush}">
                    <ctl:EmojiTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                        Foreground="{DynamicResource LumiUserBubbleTextBrush}" />
                  </Border>
                </StackPanel>
                </ctl:FractionWidthLimiter>

                <!-- 助理：靠左；左側 32 圓形頭像，右側是「Lumi」與時間、淡底氣泡、動作列 -->
                <ctl:FractionWidthLimiter Classes="assistant" IsVisible="{Binding IsAssistant}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Left">
                  <Border Grid.Column="0" Classes="avatar" VerticalAlignment="Top">
                    <TextBlock Text="{x:Static res:Strings.TitleBar_LogoMark}" FontWeight="Bold"
                               Foreground="{DynamicResource LumiAccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="sender" Text="{x:Static res:Strings.Workbench_AssistantName}" />
                      <TextBlock Classes="muted message-time" Text="{Binding TimeText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 淡底氣泡（對話內容，不算卡片）：思考過程、Markdown、等待與停止提示 -->
                    <Border x:Name="AssistantBubble" IsVisible="{Binding ShowBubble}" HorizontalAlignment="Left" Padding="16,12"
                            CornerRadius="{StaticResource LumiRadiusCard}" Background="{DynamicResource LumiAssistantBubbleBrush}">
                      <StackPanel Spacing="8">
                        <!-- 思考過程：M1 最簡版，正式樣式在 M2（Q14） -->
                        <Expander IsVisible="{Binding HasThinking}" Header="{Binding ThinkingTitle}"
                                  HorizontalAlignment="Stretch">
                          <ctl:EmojiTextBlock Text="{Binding Thinking}" TextWrapping="Wrap"
                                              Foreground="{DynamicResource LumiTextMutedBrush}"
                                              FontSize="{DynamicResource LumiFontSizeCard}" />
                        </Expander>
                        <!-- 助理的回答用 Markdown 渲染；使用者訊息與思考過程維持純文字 -->
                        <md:MarkdownView IsVisible="{Binding HasText}" Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}" />
                        <TextBlock IsVisible="{Binding ShowTypingIndicator}" Text="…" Classes="muted" />
                        <TextBlock IsVisible="{Binding IsStopped}" Text="{x:Static res:Strings.Workbench_Stopped}" Classes="muted" />
                      </StackPanel>
                    </Border>

                    <!-- 動作列：複製、重新產生（只有最後一則）、👍👎（停用，說明即將推出）、本輪 token -->
                    <StackPanel x:Name="MessageActions" IsVisible="{Binding ShowActions}" Orientation="Horizontal" Spacing="4">
                      <Button Classes="tertiary small message-action"
                              Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{x:Static res:Strings.Workbench_CopyTip}" AutomationProperties.Name="{Binding CopyLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <ctl:LumiIcon IsVisible="{Binding !IsCopied}" Data="{StaticResource LumiIconCopy}" Size="14" />
                          <ctl:LumiIcon IsVisible="{Binding IsCopied}" Data="{StaticResource LumiIconCheck}" Size="14" />
                          <TextBlock Classes="action-label" Text="{Binding CopyLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tertiary small message-action" IsVisible="{Binding IsLastAssistant}"
                              Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).RegenerateCommand}"
                              ToolTip.Tip="{x:Static res:Strings.Workbench_RegenerateTip}" AutomationProperties.Name="{x:Static res:Strings.Workbench_Regenerate}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <ctl:LumiIcon Data="{StaticResource LumiIconRefresh}" Size="14" />
                          <TextBlock Classes="action-label" Text="{x:Static res:Strings.Workbench_Regenerate}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="LikeButton" Classes="tertiary small message-action" IsEnabled="False"
                              ToolTip.Tip="{x:Static res:Strings.Workbench_FeedbackComingSoon}" ToolTip.ShowOnDisabled="True"
                              AutomationProperties.Name="{x:Static res:Strings.Workbench_Like}">
                        <ctl:LumiIcon Data="{StaticResource LumiIconThumbsUp}" Size="14" />
                      </Button>
                      <Button x:Name="DislikeButton" Classes="tertiary small message-action" IsEnabled="False"
                              ToolTip.Tip="{x:Static res:Strings.Workbench_FeedbackComingSoon}" ToolTip.ShowOnDisabled="True"
                              AutomationProperties.Name="{x:Static res:Strings.Workbench_Dislike}">
                        <ctl:LumiIcon Data="{StaticResource LumiIconThumbsDown}" Size="14" />
                      </Button>
                      <!-- 停用的原因：一個共用的說明，不是每個按鈕各一個 -->
                      <TextBlock Classes="muted" Text="{x:Static res:Strings.Workbench_FeedbackComingSoon}" VerticalAlignment="Center" />
                      <TextBlock IsVisible="{Binding HasUsage}" Text="{Binding UsageText}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                </ctl:FractionWidthLimiter>
              </Panel>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>

        <!-- 錯誤列：原因 + 對話內容已保留 + 重試（ui-spec 第 3 節） -->
        <Border IsVisible="{Binding HasError}" Padding="16,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
              <TextBlock Text="{x:Static res:Strings.Workbench_ErrorKept}" Classes="muted" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
              <Button x:Name="RetryOtherModelButton" Content="{x:Static res:Strings.Workbench_RetryOtherModel}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <views:ModelPicker DataContext="{Binding RetrySwitcher}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Content="{x:Static res:Strings.Workbench_Retry}" Command="{Binding RetryCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
