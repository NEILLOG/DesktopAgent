<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             x:Class="Lumi.App.Views.ToolCardView"
             x:DataType="vm:ToolCardViewModel">
  <!--
    一次工具呼叫的卡片（ui-spec 第 4、5 節）：預設收合，標題「動作 · 對象 · 結果摘要 … 耗時 ›」；
    執行中與等待允許強制展開；等待允許時確認區嵌在卡片內。只用 token 上色。
  -->
  <UserControl.Styles>
    <Style Selector="Border.toolcard">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.toolcard.awaiting">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.toolcard.failed">
      <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    </Style>
    <Style Selector="Border.toolcard.denied">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.cardheader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <!-- 強制展開時標題不能點，但不要變成灰色的停用外觀 -->
    <Style Selector="Button.cardheader:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="Button.cardheader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.cardlabel">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Card" Classes="toolcard"
          Classes.awaiting="{Binding IsAwaiting}" Classes.failed="{Binding IsFailed}" Classes.denied="{Binding IsDenied}">
    <StackPanel>
      <Button Classes="cardheader" Command="{Binding ToggleCommand}">
        <Grid ColumnDefinitions="22,*,Auto,Auto" VerticalAlignment="Center">
          <!-- 狀態圖示：執行中轉圈（這裡用不確定進度條）、成功勾、失敗叉、等待三角、已拒絕禁止符號 -->
          <Panel Grid.Column="0" Width="18" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ProgressBar IsVisible="{Binding IsRunning}" IsIndeterminate="True" Width="16" MinWidth="16" Height="3"
                         Foreground="{DynamicResource LumiInfoBrush}" />
            <TextBlock IsVisible="{Binding IsSucceeded}" Text="✓" FontWeight="Bold" Foreground="{DynamicResource LumiSuccessBrush}" />
            <TextBlock IsVisible="{Binding IsFailed}" Text="✕" FontWeight="Bold" Foreground="{DynamicResource LumiDangerBrush}" />
            <TextBlock IsVisible="{Binding IsAwaiting}" Text="⚠" FontWeight="Bold" Foreground="{DynamicResource LumiWarningIconBrush}" />
            <TextBlock IsVisible="{Binding IsDenied}" Text="⊘" FontWeight="Bold" Foreground="{DynamicResource LumiTextMutedBrush}" />
          </Panel>
          <ctl:EmojiTextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                              VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCard}" />
          <TextBlock Grid.Column="2" IsVisible="{Binding HasDuration}" Text="{Binding DurationText}" Classes="muted"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
          <Panel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock IsVisible="{Binding !IsOpen}" Text="›" Classes="muted" />
            <TextBlock IsVisible="{Binding IsOpen}" Text="⌄" Classes="muted" />
          </Panel>
        </Grid>
      </Button>

      <StackPanel IsVisible="{Binding IsOpen}" Spacing="8" Margin="12,0,12,12">
        <!-- 確認區（等待允許時）：這次會做什麼、按鈕依權限等級 -->
        <StackPanel IsVisible="{Binding IsAwaiting}" Spacing="8">
          <TextBlock Text="{Binding PermissionNote}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
          <ctl:EmojiTextBlock IsVisible="{Binding HasPreviewDetail}" Text="{Binding PreviewDetail}" TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding IsDestructive}" Text="{x:Static res:Strings.Tool_Irreversible}"
                     FontWeight="SemiBold" Foreground="{DynamicResource LumiDangerBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AllowOnceButton" IsVisible="{Binding !IsDestructive}" Content="{x:Static res:Strings.Tool_AllowOnce}"
                    Command="{Binding AllowOnceCommand}" Background="{DynamicResource LumiPrimaryButtonBrush}"
                    Foreground="{DynamicResource LumiPrimaryButtonTextBrush}" />
            <Button x:Name="AllowExecuteButton" IsVisible="{Binding IsDestructive}" Content="{x:Static res:Strings.Tool_AllowExecute}"
                    Command="{Binding AllowOnceCommand}" Background="{DynamicResource LumiDangerBrush}"
                    Foreground="{DynamicResource LumiSurfaceBrush}" />
            <Button x:Name="AllowConversationButton" IsVisible="{Binding ShowAllowForConversation}"
                    Content="{x:Static res:Strings.Tool_AllowConversation}" Command="{Binding AllowForConversationCommand}" />
            <Button x:Name="DenyButton" Content="{x:Static res:Strings.Tool_Deny}" Command="{Binding DenyCommand}" />
          </StackPanel>
        </StackPanel>

        <TextBlock IsVisible="{Binding HasApprovalNote}" Text="{Binding ApprovalNote}" Classes="muted" />

        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static res:Strings.Tool_Arguments}" Classes="cardlabel" />
          <ctl:EmojiTextBlock Text="{Binding ArgumentsText}" TextWrapping="Wrap" FontFamily="{DynamicResource LumiMonoFont}"
                              FontSize="{DynamicResource LumiFontSizeCaption}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasResult}" Spacing="2">
          <TextBlock Text="{x:Static res:Strings.Tool_Result}" Classes="cardlabel" />
          <ctl:EmojiTextBlock x:Name="ResultText" Text="{Binding ResultDisplay}" TextWrapping="Wrap"
                              FontFamily="{DynamicResource LumiMonoFont}" FontSize="{DynamicResource LumiFontSizeCaption}" />
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <Button Classes="chrome small" IsVisible="{Binding HasMoreResult}" Content="{Binding ShowFullLabel}"
                    Command="{Binding ToggleFullOutputCommand}" />
            <Button Classes="chrome small" Content="{Binding CopyLabel}" Command="{Binding CopyResultCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
