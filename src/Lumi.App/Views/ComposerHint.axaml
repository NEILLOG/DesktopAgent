<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:res="using:Lumi.App.Resources"
             x:Class="Lumi.App.Views.ComposerHint"
             x:DataType="vm:ComposerHintViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
  </UserControl.Styles>
  <!--
    輸入框上方的使用習慣提示列（plan 23 第 7.1 節）：一行文字，第二行是最多兩個動作按鈕（secondary，32 高）加「知道了」「不再提醒這類」（tertiary small）。
    樣式同用量面板的快滿提醒（Warning 底、圓角 10、內距 12、文字 13px）。左右邊距由 ChatComposer 的外層決定（跟隨輸入框外框）。
  -->
  <Border CornerRadius="10" Padding="12" BorderThickness="1"
          Background="{DynamicResource LumiWarningBackgroundBrush}" BorderBrush="{DynamicResource LumiWarningBorderBrush}">
    <StackPanel Spacing="12">
      <TextBlock x:Name="HintText" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                 Foreground="{DynamicResource LumiWarningTextBrush}" />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button x:Name="HintPrimaryButton" Classes="secondary" Height="32" Padding="12,0"
                IsVisible="{Binding HasPrimary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                AutomationProperties.Name="{Binding PrimaryText}" />
        <Button x:Name="HintSecondaryButton" Classes="secondary" Height="32" Padding="12,0"
                IsVisible="{Binding HasSecondary}" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}"
                AutomationProperties.Name="{Binding SecondaryText}" />
        <Button x:Name="HintDismissButton" Classes="tertiary small"
                Content="{x:Static res:Strings.Hint_Dismiss}" Command="{Binding DismissCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Hint_Dismiss}" />
        <Button x:Name="HintMuteButton" Classes="tertiary small"
                Content="{x:Static res:Strings.Hint_Mute}" Command="{Binding MuteCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Hint_Mute}" />
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
