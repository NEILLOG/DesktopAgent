<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:views="using:Lumi.App.Views"
             x:Class="Lumi.App.Views.ModelsPanel"
             x:DataType="vm:ModelsViewModel">

  <!-- 模型表單（AI 連線頁的詳細區之一）：一個容器卡片（只一層）。沒有內層捲動，卡片照內容長高，由 AI 連線頁整頁一起捲 -->
  <Border x:Name="DetailCard" Classes="card" Padding="24" VerticalAlignment="Top" IsVisible="{Binding HasEditor}">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <!-- 視覺樹（也就是 Tab）順序：標頭 → 欄位 → 底部動作列；Grid 的列與子元素順序無關，所以動作列寫在最後 -->
      <!-- 標頭：字首圖示（所屬連線）、顯示名稱、供應商（Caption）、所屬連線的狀態徽章 -->
      <Grid x:Name="DetailHeader" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
        <views:ProviderMark Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0" Text="{Binding HeaderInitial}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="HeaderTitleText" Text="{Binding HeaderTitle}" FontSize="{DynamicResource LumiFontSizeTitle}" FontWeight="Bold"
                     Foreground="{DynamicResource LumiTextBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="HeaderProviderText" Classes="muted" Text="{Binding HeaderProvider}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <views:StatusIndicator x:Name="StatusBadge" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" IsBadge="True" Status="{Binding EditorStatus}" />
      </Grid>

      <StackPanel Grid.Row="1" Spacing="16" Margin="0,0,0,16">

        <ctl:FormField x:Name="ConnectionField" Label="{x:Static res:Strings.Models_Connection}" Requirement="Required"
                       Hint="{x:Static res:Strings.Models_ConnectionHint}">
          <ComboBox x:Name="ConnectionBox" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Static res:Strings.Models_Connection}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ConnectionOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </ctl:FormField>

        <!-- 模型 ID：可編輯下拉＋重新整理；說明列顯示可用模型數或取不到的原因 -->
        <ctl:FormField x:Name="ModelIdField" Label="{x:Static res:Strings.Models_ModelId}" Requirement="Required"
                       Hint="{Binding ListStatusText}" Error="{Binding ModelIdError}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="ModelIdBox" Grid.Column="0" IsEditable="True" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableModelIds}" Text="{Binding ModelId}"
                      Classes.error="{Binding ModelIdError, Converter={x:Static ObjectConverters.IsNotNull}}"
                      AutomationProperties.Name="{x:Static res:Strings.Models_ModelId}" />
            <Button x:Name="RefreshModelsButton" Grid.Column="1" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="12,8"
                    Command="{Binding RefreshModelListCommand}" AutomationProperties.Name="{x:Static res:Strings.Models_Refresh}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconRefresh}" Size="16" />
                <TextBlock Text="{x:Static res:Strings.Models_Refresh}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </ctl:FormField>

        <ctl:FormField x:Name="DisplayNameField" Label="{x:Static res:Strings.Models_DisplayName}" Requirement="Required"
                       Hint="{x:Static res:Strings.Models_DisplayNameHint}" Error="{Binding DisplayNameError}">
          <TextBox x:Name="DisplayNameBox" Text="{Binding DisplayName}" Classes.error="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   AutomationProperties.Name="{x:Static res:Strings.Models_DisplayName}" />
        </ctl:FormField>

        <StackPanel Spacing="8">
          <CheckBox x:Name="ShowThinkingCheckBox" Content="{x:Static res:Strings.Models_ShowThinking}" IsChecked="{Binding ShowThinking}" />
          <CheckBox x:Name="ToolsEnabledCheckBox" Content="{x:Static res:Strings.Models_ToolsEnabled}" IsChecked="{Binding ToolsEnabled}"
                    ToolTip.Tip="{x:Static res:Strings.Models_ToolsEnabledHint}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Models_ToolsEnabledHint}" />
        </StackPanel>

        <!-- 進階（預設收合）：技術欄位。有錯誤時自動展開（ModelsPanel.axaml.cs） -->
        <Expander x:Name="AdvancedExpander" Classes="advanced" Header="{x:Static res:Strings.Settings_Advanced}" IsExpanded="False">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,8,0,0">
            <ctl:FormField x:Name="MaxOutputField" Grid.Column="0" Label="{x:Static res:Strings.Models_MaxOutput}" Requirement="Required"
                           Hint="{x:Static res:Strings.Models_MaxOutputHint}" Error="{Binding MaxOutputError}">
              <NumericUpDown x:Name="MaxOutputBox" Value="{Binding MaxOutputTokens}" Minimum="1" Increment="256" FormatString="0"
                             AutomationProperties.Name="{x:Static res:Strings.Models_MaxOutput}" />
            </ctl:FormField>
            <ctl:FormField x:Name="ContextWindowField" Grid.Column="1" Label="{x:Static res:Strings.Models_ContextWindow}" Requirement="Required"
                           Hint="{x:Static res:Strings.Models_ContextWindowHint}" Error="{Binding ContextWindowError}">
              <NumericUpDown x:Name="ContextWindowBox" Value="{Binding ContextWindow}" Minimum="1" Increment="1000" FormatString="0"
                             AutomationProperties.Name="{x:Static res:Strings.Models_ContextWindow}" />
            </ctl:FormField>
          </Grid>
        </Expander>

        <!-- 單價（M23）：依 model ID 與連線比對價目表。整段由 ShowPricing 控制（沒有價目表時不顯示）；段落之間 24 -->
        <ContentControl x:Name="PricingSection" Margin="0,8,0,0" Content="{Binding Pricing}" IsVisible="{Binding ShowPricing}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ModelPricingViewModel">
              <ctl:FormField Label="{x:Static res:Strings.Pricing_Title}">
                <StackPanel Spacing="12">
                  <!-- 本機：不比對、不計費 -->
                  <TextBlock x:Name="PricingLocalText" Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Pricing_Local}"
                             IsVisible="{Binding IsLocal}" />

                  <!-- 只有候選（近似或前綴相符）：警示框列出來給使用者選，不自動套用 -->
                  <Border x:Name="PricingCandidatesBox" IsVisible="{Binding ShowCandidates}" Background="{DynamicResource LumiWarningBackgroundBrush}"
                          BorderBrush="{DynamicResource LumiWarningBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding CandidatesTitle}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
                      <ItemsControl ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PriceCandidateItem">
                            <RadioButton GroupName="PricingCandidates" IsChecked="{Binding IsSelected}" Margin="0,0,0,4">
                              <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ModelId}" />
                                <TextBlock Classes="muted" Text="{Binding PriceText}" />
                              </StackPanel>
                            </RadioButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PricingApplyButton" Classes="secondary" MinHeight="{StaticResource LumiControlHeight}" Padding="12,8"
                                Content="{x:Static res:Strings.Pricing_Apply}" Command="{Binding ApplyCandidateCommand}" />
                        <Button x:Name="PricingManualButton" Classes="tertiary" MinHeight="{StaticResource LumiControlHeight}" Padding="12,8"
                                Content="{x:Static res:Strings.Pricing_Manual}" Command="{Binding ManualCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- 摘要（一行）：自動帶入時後面接「✓ 已自動帶入」，右邊是「編輯」 -->
                  <Grid x:Name="PricingSummary" IsVisible="{Binding ShowSummary}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SummaryText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsAutoFilled}">
                        <ctl:LumiIcon Data="{StaticResource LumiIconCheck}" Size="14" Foreground="{DynamicResource LumiSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.Pricing_AutoFilled}" VerticalAlignment="Center" />
                      </StackPanel>
                    </WrapPanel>
                    <Button Grid.Column="1" Classes="tertiary small" VerticalAlignment="Center" Content="{x:Static res:Strings.Pricing_Edit}"
                            Command="{Binding EditCommand}" />
                  </Grid>

                  <!-- 欄位：輸入、輸出兩欄；快取價格收合；找不到時說明；還原（只有比對得到時） -->
                  <StackPanel x:Name="PricingFields" IsVisible="{Binding ShowFields}" Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <ctl:FormField Grid.Column="0" Label="{x:Static res:Strings.Pricing_Input}" Error="{Binding InputError}">
                        <TextBox x:Name="PricingInputBox" Text="{Binding InputText}" Classes.error="{Binding InputError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 AutomationProperties.Name="{x:Static res:Strings.Pricing_Input}" />
                      </ctl:FormField>
                      <ctl:FormField Grid.Column="1" Label="{x:Static res:Strings.Pricing_Output}" Error="{Binding OutputError}">
                        <TextBox x:Name="PricingOutputBox" Text="{Binding OutputText}" Classes.error="{Binding OutputError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 AutomationProperties.Name="{x:Static res:Strings.Pricing_Output}" />
                      </ctl:FormField>
                    </Grid>
                    <TextBlock x:Name="PricingNotFoundText" Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Pricing_NotFound}"
                               IsVisible="{Binding ShowNotFound}" />
                    <Button x:Name="PricingRestoreButton" Classes="tertiary small" HorizontalAlignment="Left" Content="{x:Static res:Strings.Pricing_Restore}"
                            Command="{Binding RestoreCommand}" IsVisible="{Binding CanRestore}" />
                    <Expander x:Name="PricingCacheExpander" Classes="advanced" Header="{x:Static res:Strings.Pricing_Advanced}"
                              IsExpanded="{Binding ShowAdvanced, Mode=TwoWay}">
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <ctl:FormField Grid.Column="0" Label="{x:Static res:Strings.Pricing_CacheRead}" Hint="{x:Static res:Strings.Pricing_CacheHint}"
                                       Error="{Binding CacheReadError}">
                          <TextBox x:Name="PricingCacheReadBox" Text="{Binding CacheReadText}" Classes.error="{Binding CacheReadError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.Name="{x:Static res:Strings.Pricing_CacheRead}" />
                        </ctl:FormField>
                        <ctl:FormField Grid.Column="1" Label="{x:Static res:Strings.Pricing_CacheWrite}" Hint="{x:Static res:Strings.Pricing_CacheHint}"
                                       Error="{Binding CacheWriteError}">
                          <TextBox x:Name="PricingCacheWriteBox" Text="{Binding CacheWriteText}" Classes.error="{Binding CacheWriteError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.Name="{x:Static res:Strings.Pricing_CacheWrite}" />
                        </ctl:FormField>
                      </Grid>
                    </Expander>
                  </StackPanel>

                  <!-- 底部：說明在左；右邊是價目表日期與「更新價目表」；更新結果在下一行 -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static res:Strings.Pricing_Note}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="muted" Text="{Binding TableDateText}" VerticalAlignment="Center" />
                      <Button x:Name="PricingUpdateButton" Classes="tertiary small" Content="{Binding UpdateTableLabel}" Command="{Binding UpdateTableCommand}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="PricingUpdateStatusText" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasUpdateStatus}"
                             Text="{Binding UpdateStatusText}" />
                </StackPanel>
              </ctl:FormField>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>

      <!-- 底部：錯誤、分隔線、動作列（刪除 danger｜儲存 primary） -->
      <StackPanel Grid.Row="2" Spacing="8">
        <TextBlock x:Name="FieldErrorsText" Classes="error" Text="{x:Static res:Strings.Form_FixErrors}" IsVisible="{Binding HasFieldErrors}" />
      <TextBlock x:Name="SaveErrorText" Classes="error" Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}" />
        <Border Classes="divider" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="DeleteButton" Grid.Column="0" Classes="danger" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                  Content="{x:Static res:Strings.Conn_Delete}" Command="{Binding DeleteCommand}" />
          <Button x:Name="SaveButton" Grid.Column="2" Classes="primary" MinHeight="{StaticResource LumiControlHeight}" Padding="16,8"
                  Content="{x:Static res:Strings.Conn_Save}" Command="{Binding SaveCommand}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
