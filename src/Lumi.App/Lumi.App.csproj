<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Lumi.App</RootNamespace>
    <AssemblyName>Lumi.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\Lumi.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Window 由 DI 建構（建構子注入 ViewModel），不走執行階段載入器 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumi.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumi.Core\Lumi.Core.csproj" />
    <ProjectReference Include="..\Lumi.Providers\Lumi.Providers.csproj" />
    <ProjectReference Include="..\Lumi.Speech\Lumi.Speech.csproj" />
    <ProjectReference Include="..\Lumi.Documents\Lumi.Documents.csproj" />
    <ProjectReference Include="..\Lumi.Mcp\Lumi.Mcp.csproj" />
    <ProjectReference Include="..\Lumi.Infrastructure\Lumi.Infrastructure.csproj" />
    <ProjectReference Include="..\Lumi.Platform\Lumi.Platform.csproj" />
    <ProjectReference Include="..\Lumi.Tools\Lumi.Tools.csproj" />
    <ProjectReference Include="..\Lumi.Sprites.Abstractions\Lumi.Sprites.Abstractions.csproj" />
    <ProjectReference Include="..\Lumi.Sprites.Orb\Lumi.Sprites.Orb.csproj" />
    <ProjectReference Include="..\Lumi.Sprites.Assets\Lumi.Sprites.Assets.csproj" />
    <ProjectReference Include="..\Lumi.Web\Lumi.Web.csproj" />
    <ProjectReference Include="..\Lumi.Browser\Lumi.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Icons\*.png" />
    <None Include="Assets\Fonts\LICENSES\**" />
    <None Include="Assets\LICENSES\**" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    單檔發佈（M22）：Playwright driver（.playwright：node 與 JS 套件）不放在執行檔旁邊，也不再靠整包自我解壓（受控 DLL 會被解到暫存資料夾，被清掉就缺檔）。
    改成把目前平台的 .playwright 壓成 zip 內嵌（資源名稱 Lumi.Playwright.<SHA-256 前 16 碼>.zip），執行時由 Lumi.Browser 的 PlaywrightDriverLocator 解到使用者資料夾。
    一般 build／run 不受影響，driver 照舊在輸出資料夾。
  -->
  <Target Name="LumiEmbedPlaywrightDriver" AfterTargets="CopyPlaywrightFilesToOutput" BeforeTargets="AssignTargetPaths" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_LumiPlaywrightStage>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)playwright-embed/</_LumiPlaywrightStage>
      <_LumiPlaywrightZip>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)playwright-driver.zip</_LumiPlaywrightZip>
    </PropertyGroup>
    <RemoveDir Directories="$(_LumiPlaywrightStage)" />
    <Copy SourceFiles="@(_PlaywrightCopyItems)" DestinationFiles="@(_PlaywrightCopyItems->'$(_LumiPlaywrightStage).playwright/%(PlaywrightFolder)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(_LumiPlaywrightZip)" />
    <ZipDirectory SourceDirectory="$(_LumiPlaywrightStage)" DestinationFile="$(_LumiPlaywrightZip)" />
    <GetFileHash Files="$(_LumiPlaywrightZip)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_LumiPlaywrightHash" />
    </GetFileHash>
    <ItemGroup>
      <EmbeddedResource Include="$(_LumiPlaywrightZip)" LogicalName="Lumi.Playwright.$(_LumiPlaywrightHash.Substring(0, 16).ToLowerInvariant()).zip" />
    </ItemGroup>
  </Target>

  <!-- 單檔發佈時 .playwright 與 playwright.ps1 不放進輸出（已內嵌在執行檔裡） -->
  <Target Name="LumiRemovePlaywrightFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('.playwright/')) Or '%(ResolvedFileToPublish.RelativePath)' == 'playwright.ps1'" />
    </ItemGroup>
  </Target>

</Project>
