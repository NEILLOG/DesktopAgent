<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumi.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lumi.App/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- 元件只引用這兩個資源，不直接寫字型名稱（agent.md 第 12 節） -->
      <FontFamily x:Key="LumiUiFont">fonts:Lumi#IBM Plex Sans, fonts:Lumi#Noto Sans TC</FontFamily>
      <FontFamily x:Key="LumiMonoFont">fonts:Lumi#JetBrains Mono, fonts:Lumi#Noto Sans TC</FontFamily>
      <x:Double x:Key="LumiFontSizeBody">15</x:Double>
      <x:Double x:Key="LumiFontSizeCard">14</x:Double>
      <x:Double x:Key="LumiFontSizeCaption">13</x:Double>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Fluent 的強調色改用 Lumi 的琥珀色，避免預設藍色混進來 -->
        <ColorPaletteResources x:Key="Light" Accent="{StaticResource LumiAccentFixedColor}" />
        <ColorPaletteResources x:Key="Dark" Accent="{StaticResource LumiAccentFixedColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource LumiUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="Background" Value="{DynamicResource LumiBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource LumiUiFont}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource LumiUiFont}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource LumiMonoFont}" />
    </Style>
  </Application.Styles>
</Application>
