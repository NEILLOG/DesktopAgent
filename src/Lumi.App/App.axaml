<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumi.App.App"
             RequestedThemeVariant="Default">

  <!-- 主題色票（Themes/Palettes）不在這裡載入：啟動時由 ThemeService 依設定套上，切換主題時整份替換 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lumi.App/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Lumi.App/Themes/Typography.axaml" />
        <ResourceInclude Source="avares://Lumi.App/Themes/Metrics.axaml" />
        <ResourceInclude Source="avares://Lumi.App/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Fluent 的強調色跟著目前主題的 Accent，切換主題時一起變 -->
        <ColorPaletteResources x:Key="Light" Accent="{DynamicResource LumiAccentColor}" />
        <ColorPaletteResources x:Key="Dark" Accent="{DynamicResource LumiAccentColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource LumiUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="Background" Value="{DynamicResource LumiBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource LumiUiFont}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource LumiUiFont}" />
    </Style>
    <StyleInclude Source="avares://Lumi.App/Themes/Controls.axaml" />
    <StyleInclude Source="avares://Lumi.App/Themes/Markdown.axaml" />

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource LumiMonoFont}" />
    </Style>
  </Application.Styles>
</Application>
