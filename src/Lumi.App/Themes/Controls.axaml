<!--
  共用控制項樣式（ui-guide.html 第 3、4、6、7 節）：輸入框、按鈕四種層級。元件只引用 token。
  卡片、分隔線、徽章只提供樣式 class，實際套用在 UB／UD 的元件改寫時進行。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Lumi.App.Controls">
  <!--
    TextBox／ComboBox（ui-guide.html 第 5 節）：高 40、圓角 10、邊框 1，全部吃主題 token，深色模式不再是 Fluent 的純黑底。
    Focus：Accent 邊框＋外圈 3px 的 Soft 光暈。TextBox／ComboBox 沒有 BoxShadow，所以模板裡多放一個透明的外框
    （PART_FocusGlow／FocusGlow：邊框 3px、Margin -3、圓角 +3），Focus 時顯示。多行輸入框的高度由使用處自行設定（MinHeight 40 只是下限）。
    錯誤：加 class="error"（Danger 邊框；一定要同時顯示錯誤文字）。停用：SurfaceAlt 底＋Muted 文字（要另外寫出原因）。
    模板的 PART_ 名稱沿用 Fluent，Avalonia 的程式碼會用名稱找這些零件。
  -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource LumiControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="TextBox">
        <DataValidationErrors>
          <Panel>
            <Border Name="PART_FocusGlow"
                    Margin="-3"
                    BorderThickness="3"
                    CornerRadius="13"
                    BorderBrush="{DynamicResource LumiAccentSoftBrush}"
                    IsVisible="False"
                    IsHitTestVisible="False" />
            <Border Name="PART_BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}" />
            <Border Margin="{TemplateBinding BorderThickness}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Grid.Column="0"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding InnerLeftContent}" />
                <DockPanel x:Name="PART_InnerDockPanel" Grid.Column="1" Margin="{TemplateBinding Padding}">
                  <TextBlock Name="PART_FloatingWatermark"
                             Foreground="{DynamicResource LumiAccentTextBrush}"
                             IsVisible="False"
                             Text="{TemplateBinding Watermark}"
                             DockPanel.Dock="Top" />
                  <ScrollViewer Name="PART_ScrollViewer"
                                HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                    <Panel>
                      <TextBlock Name="PART_Watermark"
                                 Foreground="{DynamicResource LumiTextMutedBrush}"
                                 Text="{TemplateBinding Watermark}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <TextBlock.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                          </MultiBinding>
                        </TextBlock.IsVisible>
                      </TextBlock>
                      <TextPresenter Name="PART_TextPresenter"
                                     Text="{TemplateBinding Text, Mode=TwoWay}"
                                     CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                     CaretIndex="{TemplateBinding CaretIndex}"
                                     SelectionStart="{TemplateBinding SelectionStart}"
                                     SelectionEnd="{TemplateBinding SelectionEnd}"
                                     TextAlignment="{TemplateBinding TextAlignment}"
                                     TextWrapping="{TemplateBinding TextWrapping}"
                                     LineHeight="{TemplateBinding LineHeight}"
                                     LetterSpacing="{TemplateBinding LetterSpacing}"
                                     PasswordChar="{TemplateBinding PasswordChar}"
                                     RevealPassword="{TemplateBinding RevealPassword}"
                                     SelectionBrush="{TemplateBinding SelectionBrush}"
                                     SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                     CaretBrush="{TemplateBinding CaretBrush}"
                                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Panel>
                    <ScrollViewer.Styles>
                      <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                        <Setter Property="Cursor" Value="IBeam" />
                      </Style>
                    </ScrollViewer.Styles>
                  </ScrollViewer>
                </DockPanel>
                <ContentPresenter Grid.Column="2"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding InnerRightContent}" />
              </Grid>
            </Border>
          </Panel>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- 多行輸入框：文字靠上，高度由使用處決定 -->
  <Style Selector="TextBox[AcceptsReturn=True]">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <!-- 狀態。Fluent 的 :pointerover／:focus 也會設 Border 的背景與邊框，所以這裡每個狀態都明確寫一次，確保吃 token -->
  <Style Selector="TextBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_FocusGlow">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark, TextBox:pointerover /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <!-- 錯誤：Danger 邊框（class="error" 或資料驗證失敗）。一定要同時顯示錯誤文字，不能只靠顏色 -->
  <Style Selector="TextBox.error /template/ Border#PART_BorderElement, TextBox:error /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBrush}" />
  </Style>
  <Style Selector="TextBox.error:focus /template/ Border#PART_BorderElement, TextBox:error:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBrush}" />
  </Style>
  <Style Selector="TextBox.error:focus /template/ Border#PART_FocusGlow, TextBox:error:focus /template/ Border#PART_FocusGlow">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBackgroundBrush}" />
  </Style>
  <!-- 停用：要在旁邊用 Caption 寫出原因 -->
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <!-- 嵌在別的控制項裡（可編輯 ComboBox）：沒有自己的外框、底色與光暈 -->
  <Style Selector="TextBox.embedded">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.embedded /template/ Border#PART_BorderElement, TextBox.embedded:pointerover /template/ Border#PART_BorderElement, TextBox.embedded:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.embedded:focus /template/ Border#PART_FocusGlow">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!--
    對話輸入區（ChatComposer）裡的多行輸入框：沒有自己的外框、底色與光暈，外框與焦點由外層 InputArea 表達
    （焦點時 InputArea 用 Accent 邊框，見 ChatComposer）。高度由使用處決定（MinHeight 64、MaxHeight 160）。
  -->
  <Style Selector="TextBox.composer">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,4" />
  </Style>
  <Style Selector="TextBox.composer /template/ Border#PART_BorderElement, TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement, TextBox.composer:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer:focus /template/ Border#PART_FocusGlow">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ComboBox：同一組高度、圓角、邊框與 Focus 樣式；下拉箭頭用 LumiIcon（chevron-down） -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource LumiControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8,0,8" />
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ComboBox">
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,32">
            <Border x:Name="FocusGlow"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-3"
                    BorderThickness="3"
                    CornerRadius="13"
                    BorderBrush="{DynamicResource LumiAccentSoftBrush}"
                    IsVisible="False"
                    IsHitTestVisible="False" />
            <Border x:Name="Background"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{DynamicResource ComboBoxThemeMinWidth}" />
            <TextBlock x:Name="PlaceholderTextBlock"
                       Grid.Column="0"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Margin="{TemplateBinding Padding}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <ContentControl x:Name="ContentPresenter"
                            Grid.Column="0"
                            Content="{TemplateBinding SelectionBoxItem}"
                            Margin="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <TextBox Name="PART_EditableTextBox"
                     Classes="embedded"
                     Grid.Column="0"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     Watermark="{TemplateBinding PlaceholderText}"
                     IsVisible="{TemplateBinding IsEditable}" />
            <Border x:Name="DropDownOverlay"
                    Grid.Column="1"
                    Background="Transparent"
                    Margin="0,1,1,1"
                    Width="30"
                    IsVisible="False"
                    HorizontalAlignment="Right" />
            <controls:LumiIcon x:Name="DropDownGlyph"
                               Grid.Column="1"
                               Data="{StaticResource LumiIconChevronDown}"
                               Size="16"
                               Margin="0,0,12,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource LumiTextMutedBrush}" />
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border x:Name="PopupBorder"
                      Background="{DynamicResource LumiSurfaceBrush}"
                      BorderBrush="{DynamicResource LumiBorderBrush}"
                      BorderThickness="1"
                      Padding="4"
                      HorizontalAlignment="Stretch"
                      CornerRadius="{StaticResource LumiRadiusInput}">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              IsScrollChainingEnabled="False"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background, ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-within /template/ Border#Background, ComboBox:focus-within:pointerover /template/ Border#Background, ComboBox:focus-within:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-within /template/ Border#FocusGlow">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ComboBox:focus /template/ ContentControl#ContentPresenter, ComboBox:focus-visible /template/ ContentControl#ContentPresenter, ComboBox:focus:pressed /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ComboBox:focus /template/ TextBlock#PlaceholderTextBlock, ComboBox:focus-visible /template/ TextBlock#PlaceholderTextBlock, ComboBox:focus:pressed /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox:focus /template/ controls|LumiIcon#DropDownGlyph, ComboBox:focus-visible /template/ controls|LumiIcon#DropDownGlyph, ComboBox:focus:pressed /template/ controls|LumiIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox.error /template/ Border#Background, ComboBox:error /template/ Border#Background, ComboBox.error:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ controls|LumiIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox[IsEditable=true]">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
  </Style>

  <!-- 下拉清單項目：選取＝Soft 底＋OnSoft 文字，Hover＝SurfaceAlt -->
  <Style Selector="ComboBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!--
    UE-4：清單項目、選單、核取方塊、單選鈕、捲軸、浮出層的互動狀態。
    與按鈕（UE-3）同一個問題：Fluent 把 Hover／Pressed／Selected／Disabled 的底色與字色設在模板內的 ContentPresenter（或方塊／圓點零件），
    優先於我們設在控制項本身的 Background／Foreground，所以每個狀態都要用 `/template/` 選擇器明確寫出。
    狀態的後寫的贏：Hover、Pressed 在前，Selected 在後（選取中的項目 Hover／Pressed 不改變底色），Disabled 放最後。
    焦點（鍵盤）：和按鈕一致，Accent 2px 圓角框畫在項目外緣內側（Fluent 預設是黑白雙框）。
  -->

  <!-- ListBoxItem（歷史抽屜、設定 Menu 分類、卡片清單、色票、ModelPicker、小精靈狀態預覽）：
       Hover＝SurfaceAlt；Selected＝Soft 底＋OnSoft 文字（Hover／Pressed 不變，Pressed 也不改變選取）；Disabled＝Muted 文字 -->
  <Style Selector="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
  </Style>
  <Style Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:disabled /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!--
    MenuItem（工具列「…」的 MenuFlyout）：Surface 底、Text 字、圓角 10；Hover＝SurfaceAlt（Avalonia 選單用 :selected 表示滑過或鍵盤移到）、
    Pressed＝Soft、Disabled＝Muted。MenuFlyout／Flyout 外框：Surface 底、Border 色框、圓角 12；陰影交給視窗系統的浮起陰影（不另外畫）。
  -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusFlyout}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusFlyout}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusInput}" />
  </Style>
  <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot, MenuItem:selected:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
  </Style>
  <Style Selector="MenuItem:pressed /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected:pressed /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ Border#PART_LayoutRoot, MenuItem:disabled:selected /template/ Border#PART_LayoutRoot, MenuItem:disabled:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:disabled:selected /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:disabled:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!--
    CheckBox／RadioButton（分段切換的 RadioButton 有自己的模板，不受影響）：方塊／圓點用 Accent，未選取的框 BorderStrong，
    Hover＝框變 Accent、底 SurfaceAlt；Pressed＝底 Soft；Disabled＝淡色。文字 Text（停用 Muted）。
  -->
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!--
    Fluent 的規則帶 :checked／:unchecked 與其他狀態的組合，選擇器比單純的 CheckBox:pointerover 具體，所以這裡每個狀態都寫成「選取狀態＋互動狀態」的完整組合
    （選取狀態：:unchecked、:checked、:indeterminate；互動狀態：正常、:pointerover、:pressed、:disabled，後寫的贏，Disabled 最後）。
  -->
  <Style Selector="CheckBox:unchecked /template/ ContentPresenter#PART_ContentPresenter, CheckBox:checked /template/ ContentPresenter#PART_ContentPresenter, CheckBox:indeterminate /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:pointerover /template/ ContentPresenter#PART_ContentPresenter, CheckBox:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, CheckBox:indeterminate:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:pressed /template/ ContentPresenter#PART_ContentPresenter, CheckBox:checked:pressed /template/ ContentPresenter#PART_ContentPresenter, CheckBox:indeterminate:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:disabled /template/ ContentPresenter#PART_ContentPresenter, CheckBox:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, CheckBox:indeterminate:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked /template/ ContentPresenter#PART_ContentPresenter, RadioButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:pointerover /template/ ContentPresenter#PART_ContentPresenter, RadioButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:pressed /template/ ContentPresenter#PART_ContentPresenter, RadioButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:disabled /template/ ContentPresenter#PART_ContentPresenter, RadioButton:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <!-- CheckBox 的方塊與勾勾 -->
  <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:disabled /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource LumiAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle, CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource LumiAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentHoverBrush}" />
  </Style>
  <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle, CheckBox:indeterminate:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource LumiAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentHoverBrush}" />
  </Style>
  <Style Selector="CheckBox:checked:disabled /template/ Border#NormalRectangle, CheckBox:indeterminate:disabled /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked /template/ Path#CheckGlyph, CheckBox:checked /template/ Path#CheckGlyph, CheckBox:indeterminate /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:pointerover /template/ Path#CheckGlyph, CheckBox:checked:pointerover /template/ Path#CheckGlyph, CheckBox:indeterminate:pointerover /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:pressed /template/ Path#CheckGlyph, CheckBox:checked:pressed /template/ Path#CheckGlyph, CheckBox:indeterminate:pressed /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:unchecked:disabled /template/ Path#CheckGlyph, CheckBox:checked:disabled /template/ Path#CheckGlyph, CheckBox:indeterminate:disabled /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceBrush}" />
  </Style>
  <Style Selector="CheckBox:indeterminate /template/ Path#IndeterminateGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:indeterminate:pointerover /template/ Path#IndeterminateGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:indeterminate:pressed /template/ Path#IndeterminateGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="CheckBox:indeterminate:disabled /template/ Path#IndeterminateGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceBrush}" />
  </Style>
  <!-- RadioButton 的圓點：未選取＝Surface 圓＋BorderStrong 框；選取＝Accent 框＋Accent 圓點 -->
  <Style Selector="RadioButton:unchecked /template/ Ellipse#OuterEllipse, RadioButton:checked /template/ Ellipse#OuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:pointerover /template/ Ellipse#OuterEllipse, RadioButton:checked:pointerover /template/ Ellipse#OuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:pressed /template/ Ellipse#OuterEllipse, RadioButton:checked:pressed /template/ Ellipse#OuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:disabled /template/ Ellipse#OuterEllipse, RadioButton:checked:disabled /template/ Ellipse#OuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiBorderBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked /template/ Ellipse#CheckOuterEllipse, RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:pointerover /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:pointerover /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiAccentHoverBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:pressed /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:pressed /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiAccentHoverBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked:disabled /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:disabled /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="RadioButton:unchecked /template/ Ellipse#CheckGlyph, RadioButton:checked /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiAccentBrush}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton:unchecked:pointerover /template/ Ellipse#CheckGlyph, RadioButton:checked:pointerover /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiAccentHoverBrush}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton:unchecked:pressed /template/ Ellipse#CheckGlyph, RadioButton:checked:pressed /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiAccentHoverBrush}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton:unchecked:disabled /template/ Ellipse#CheckGlyph, RadioButton:checked:disabled /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>

  <!-- ScrollBar：只換 thumb 與 track 的顏色（BorderStrong／透明；Hover 與按住用 Muted），尺寸、動畫與箭頭維持 Fluent。Fluent 的規則帶方向偽類，所以兩個方向各寫一次 -->
  <Style Selector="ScrollBar:vertical /template/ Rectangle#TrackRect, ScrollBar:horizontal /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb, ScrollBar:horizontal /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover, ScrollBar:horizontal /template/ Thumb:pointerover, ScrollBar:vertical /template/ Thumb:pressed, ScrollBar:horizontal /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!-- ListBox 本身不畫底色（Fluent 預設是灰底），選取與 Hover 由項目負責 -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>

  <!--
    NumericUpDown（模型設定「進階」的最大輸出、上下文長度）：只換顏色，尺寸維持。外框和 TextBox 同一套（Surface 底、BorderStrong 框、Hover＝Accent 淡邊、
    Focus＝Accent 邊、Disabled＝SurfaceAlt 底），內層的 TextBox 沒有自己的框與光暈（外框代表整個控制項），
    上下箭頭按鈕：透明底、Muted 圖示，Hover＝SurfaceAlt，Pressed＝Soft（和 tertiary 一致）。
  -->
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="NumericUpDown:pointerover">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="NumericUpDown:focus-within">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="NumericUpDown:disabled">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_FocusGlow">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- 沒有偽類別的規則優先權低於模板裡的 TemplateBinding（Fluent 把控制項的底色與框線綁進去），所以「正常」狀態也要帶一個條件（:not(:disabled)）才蓋得過 -->
  <Style Selector="ButtonSpinner /template/ RepeatButton:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <Style Selector="ButtonSpinner /template/ RepeatButton PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover PathIcon, ButtonSpinner /template/ RepeatButton:pressed PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!-- ProgressBar（對話用量）：進度＝Accent、軌道＝Border；不依賴 Fluent 強調色是否已換成主題色 -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource LumiAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource LumiBorderBrush}" />
  </Style>

  <!--
    按鈕層級（ui-guide.html 第 6 節）。每個動作區最多一個 primary。
    狀態樣式（UE-3）：Fluent 的 Button:pointerover／:pressed／:disabled 規則設在模板內的 ContentPresenter#PART_ContentPresenter，
    優先於我們設在 Button 本身的 Background／Foreground／BorderBrush（TemplateBinding），Hover 時會變成 Fluent 的半透明黑底＋黑字。
    所以每個層級都要用 `/template/ ContentPresenter#PART_ContentPresenter` 的選擇器明確寫出 Hover／Pressed／Disabled。
    選擇器的 class 與偽類比 Fluent 多，所以一定蓋得過；Pressed 時 :pointerover 也成立，因此 Pressed 要寫在 Hover 之後；
    Disabled 放最後。前景色設在 ContentPresenter 上，Content 裡的 TextBlock 與 LumiIcon 會繼承。
    Focus（鍵盤）：見檔案最後的「焦點框」。
  -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.tertiary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- primary（含停止鈕 stop）：Hover／Pressed 底色往背景色靠，文字色不變；Disabled＝SurfaceAlt 底＋Muted 文字 -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.stop:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- secondary 與 ToggleButton.secondary（未選取）：Hover＝SurfaceAlt 底；Pressed＝Soft 底；Disabled＝透明底＋Border 色框＋Muted 文字 -->
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
  </Style>

  <!-- tertiary：Hover＝SurfaceAlt 底；Pressed＝Soft 底；Disabled＝Muted 文字（平常就是 Muted，所以再降到 0.6 透明度才看得出來） -->
  <Style Selector="Button.tertiary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tertiary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tertiary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- danger：Hover＝Danger 淡底（紅框紅字不變）；Pressed＝淡底＋紅框加深；Disabled＝Muted 文字與 Border 色框 -->
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBrush}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
  </Style>

  <!--
    送出／停止：圓形圖示按鈕（對話輸入區與小精靈輸入列共用）。送出用 Accent 底（不算 Primary 文字按鈕），停止用 Primary 底（上面 Button.stop 的狀態）。
    送出：Hover／Pressed＝AccentHover；Disabled（輸入為空）＝Soft 底＋Muted 圖示。小精靈輸入列回應中時會把 send class 換成 stop。
  -->
  <Style Selector="Button.round">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Background" Value="{DynamicResource LumiAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiOnAccentBrush}" />
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.send:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.stop">
    <Setter Property="Background" Value="{DynamicResource LumiPrimaryButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiPrimaryButtonTextBrush}" />
  </Style>

  <!--
    焦點框（鍵盤 Tab／方向鍵才出現，滑鼠點擊不會）：所有按鈕一致，Accent 2px、畫在按鈕自己的外緣內側（疊在邊框上，不佔版面；圓角同按鈕）。
    Fluent 預設的焦點框是黑色 2px＋白色 1px 的直角雙框，和圓角按鈕對不上，所以整個換掉。
    自己畫焦點外觀的按鈕（dashed 的虛線框變 Accent、分段切換與進階區段標題的邊框變 Accent）與卡片清單項目（卡片邊框變 Accent）把 FocusAdorner 設成 null，避免疊成雙框。
  -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.round">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="18" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.chip-remove">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource LumiAccentBrush}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.dashed, Border.segmented RadioButton, Expander.advanced /template/ ToggleButton#ExpanderHeader, ListBox.cards ListBoxItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <!-- 卡片：只用來代表一個物件（ui-guide.html 第 7 節）。不要把整份表單或每個欄位包成卡片 -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusCard}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- 分隔線：1px、上下 16；用來分群組，不是每個欄位下面都畫一條 -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,16" />
    <Setter Property="Background" Value="{DynamicResource LumiBorderBrush}" />
  </Style>
  <!-- 狀態徽章：Soft 底＋文字（不能只靠顏色或圓點）。文字用 OnSoft 色 -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
  </Style>

  <!--
    表單欄位（controls:FormField）：標籤在輸入框上方、右側「必填／選填」、說明 Caption 在下方、錯誤文字（Danger）在說明下方。
    輸入框放在 Content；輸入框有錯誤時另外加 class="error"（Danger 邊框），但文字一定要有。
  -->
  <Style Selector="controls|FormField">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Name="PART_Label" Grid.Column="0" Text="{TemplateBinding Label}"
                       IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="{DynamicResource LumiFontSizeBody}" FontWeight="Bold"
                       Foreground="{DynamicResource LumiTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="PART_Requirement" Grid.Column="1" Margin="8,0,0,0" Text="{TemplateBinding RequirementText}"
                       IsVisible="{TemplateBinding RequirementText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiTextMutedBrush}" />
          </Grid>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <TextBlock Name="PART_Hint" Text="{TemplateBinding Hint}"
                     IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiTextMutedBrush}" TextWrapping="Wrap" />
          <TextBlock Name="PART_Error" Text="{TemplateBinding Error}"
                     IsVisible="{TemplateBinding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="{DynamicResource LumiFontSizeCaption}" Foreground="{DynamicResource LumiDangerBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!--
    分段切換（ui-guide.html 第 3 節的選取樣式）：Border.segmented 裡放 RadioButton。選取＝Soft 底＋OnSoft 文字，圓角 10；
    沒選取＝Muted 文字，Hover 是 Surface 底。外框是 SurfaceAlt 底，用來表示「這幾個是同一組」。
  -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusCard}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.segmented RadioButton">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border Name="PART_Segment" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="{StaticResource LumiRadiusInput}" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="SegmentContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.segmented RadioButton:pointerover /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
  </Style>
  <Style Selector="Border.segmented RadioButton:pressed /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
  </Style>
  <Style Selector="Border.segmented RadioButton:disabled /template/ Border#PART_Segment">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Border.segmented RadioButton:focus-visible /template/ Border#PART_Segment">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="Border.segmented RadioButton:checked">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
  </Style>
  <Style Selector="Border.segmented RadioButton:checked /template/ Border#PART_Segment, Border.segmented RadioButton:checked:pointerover /template/ Border#PART_Segment, Border.segmented RadioButton:checked:pressed /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
  </Style>
  <Style Selector="Border.segmented RadioButton:checked:disabled">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!--
    卡片清單（ListBox.cards）：每一列是一張 Border.card（巢狀最多一層）。可點擊所以 Hover 才有陰影；
    選取＝Soft 底＋Accent 邊框（狀態另外用文字表達）。ListBoxItem 本身不畫底色，避免蓋住卡片的圓角。
  -->
  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusCard}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter, ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter, ListBox.cards ListBoxItem:selected /template/ ContentPresenter, ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.cards ListBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover Border.card">
    <Setter Property="BoxShadow" Value="{DynamicResource LumiCardHoverShadow}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected Border.card, ListBox.cards ListBoxItem:selected:pointerover Border.card">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:focus-visible Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>

  <!-- 虛線「＋新增」入口：tertiary 風格（不是 Primary）。Avalonia 的 Border 沒有虛線，用 Rectangle 描邊 -->
  <Style Selector="Button.dashed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel>
          <Rectangle Name="PART_Dash" RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="4,3"
                     Stroke="{DynamicResource LumiBorderStrongBrush}" Fill="{TemplateBinding Background}" IsHitTestVisible="False" />
          <ContentPresenter Name="DashContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.dashed:pointerover, Button.dashed:pressed">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
  </Style>
  <Style Selector="Button.dashed:pointerover /template/ Rectangle#PART_Dash, Button.dashed:focus-visible /template/ Rectangle#PART_Dash">
    <Setter Property="Stroke" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="Button.dashed:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- 進階區段（預設收合）：沒有外框，標題是 Muted 文字加 chevron，展開時 chevron 轉 180 度；內容與標題之間留 8 -->
  <Style Selector="Expander.advanced">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton Name="ExpanderHeader" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Left"
                        Foreground="{DynamicResource LumiTextMutedBrush}" FontWeight="SemiBold" Padding="8,8">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border Name="HeaderBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="{StaticResource LumiRadiusInput}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Name="HeaderContent" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
              </ControlTemplate>
            </ToggleButton.Template>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LumiIcon Name="Chevron" Data="{StaticResource LumiIconChevronDown}" Size="16" />
              <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Border Name="ExpanderContent" IsVisible="{TemplateBinding IsExpanded}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander.advanced /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
  </Style>
  <Style Selector="Expander.advanced /template/ ToggleButton#ExpanderHeader:focus-visible /template/ Border#HeaderBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
  </Style>
  <Style Selector="Expander.advanced:expanded /template/ controls|LumiIcon#Chevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- 切換「顯示／隱藏」之類的 ToggleButton 用 secondary 樣式；選取＝Soft 底＋OnSoft 文字 -->
  <Style Selector="ToggleButton.secondary">
    <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ToggleButton.secondary:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.secondary:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.secondary:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextOnSoftBrush}" />
  </Style>
  <Style Selector="ToggleButton.secondary:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
  </Style>

  <!--
    清單＋詳細（ui-guide.html 第 8 節）：Grid 兩欄（清單 260＋詳細）兩列。清單 class="master"、詳細 class="detail"。
    視窗寬 < 900 時，根節點（Window）有 stacked class（ResponsiveClasses），清單改到上面、詳細在下面，整區改成整頁捲動。
    清單＋詳細外層的 ScrollViewer（class="master-detail-scroll"）：並排時不捲動（清單、詳細各自捲動），上下排時整頁捲動。
  -->
  <Style Selector="ScrollViewer.master-detail-scroll">
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector=":is(Control).master">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.RowSpan" Value="2" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style Selector=":is(Control).detail">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.RowSpan" Value="2" />
  </Style>
  <Style Selector="Window.stacked ScrollViewer.master-detail-scroll">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Padding" Value="0,0,12,0" />
  </Style>
  <Style Selector="Window.stacked :is(Control).master">
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Grid.RowSpan" Value="1" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style Selector="Window.stacked :is(Control).detail">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.RowSpan" Value="1" />
  </Style>
</Styles>
