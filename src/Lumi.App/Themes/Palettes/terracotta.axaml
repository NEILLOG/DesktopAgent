<!--
  色票：陶土色：溫暖、人文感（ui-guide.html 第 1 節）。
  由 scratchpad 腳本依原則色碼推導；文字用色已依 WCAG 驗證（見 Lumi.App.Tests/Theming/PaletteContrastTests.cs）。
  切換主題時整份替換（ThemeService.ApplyPalette）；元件一律引用 Lumi*Brush，不直接寫色碼。
  色碼只能出現在 Themes/ 資料夾（tests/Lumi.Architecture.Tests/ThemeTokenRuleTests.cs）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="LumiBackgroundColor">#F6F5F2</Color>
      <Color x:Key="LumiSurfaceColor">#FFFFFF</Color>
      <Color x:Key="LumiChromeColor">#FCFBF9</Color>
      <Color x:Key="LumiSurfaceAltColor">#F0EEEA</Color>
      <Color x:Key="LumiBorderColor">#E8E6E1</Color>
      <Color x:Key="LumiBorderStrongColor">#B8B6B3</Color>
      <Color x:Key="LumiTextColor">#27272B</Color>
      <Color x:Key="LumiTextMutedColor">#696972</Color>
      <Color x:Key="LumiTextOnSoftColor">#27272B</Color>
      <Color x:Key="LumiAccentColor">#EF8354</Color>
      <Color x:Key="LumiAccentHoverColor">#DC7045</Color>
      <Color x:Key="LumiAccentSoftColor">#FFF0E8</Color>
      <Color x:Key="LumiAccentBorderColor">#F6B497</Color>
      <Color x:Key="LumiAccentTextColor">#C14712</Color>
      <Color x:Key="LumiOnAccentColor">#27272B</Color>
      <Color x:Key="LumiUserBubbleColor">#FFF0E8</Color>
      <Color x:Key="LumiUserBubbleTextColor">#27272B</Color>
      <Color x:Key="LumiAssistantBubbleColor">#F0EEEA</Color>
      <Color x:Key="LumiPrimaryButtonColor">#27272B</Color>
      <Color x:Key="LumiPrimaryButtonTextColor">#FFFFFF</Color>

      <SolidColorBrush x:Key="LumiBackgroundBrush" Color="{StaticResource LumiBackgroundColor}" />
      <SolidColorBrush x:Key="LumiSurfaceBrush" Color="{StaticResource LumiSurfaceColor}" />
      <SolidColorBrush x:Key="LumiChromeBrush" Color="{StaticResource LumiChromeColor}" />
      <SolidColorBrush x:Key="LumiSurfaceAltBrush" Color="{StaticResource LumiSurfaceAltColor}" />
      <SolidColorBrush x:Key="LumiBorderBrush" Color="{StaticResource LumiBorderColor}" />
      <SolidColorBrush x:Key="LumiBorderStrongBrush" Color="{StaticResource LumiBorderStrongColor}" />
      <SolidColorBrush x:Key="LumiTextBrush" Color="{StaticResource LumiTextColor}" />
      <SolidColorBrush x:Key="LumiTextMutedBrush" Color="{StaticResource LumiTextMutedColor}" />
      <SolidColorBrush x:Key="LumiTextOnSoftBrush" Color="{StaticResource LumiTextOnSoftColor}" />
      <SolidColorBrush x:Key="LumiAccentBrush" Color="{StaticResource LumiAccentColor}" />
      <SolidColorBrush x:Key="LumiAccentHoverBrush" Color="{StaticResource LumiAccentHoverColor}" />
      <SolidColorBrush x:Key="LumiAccentSoftBrush" Color="{StaticResource LumiAccentSoftColor}" />
      <SolidColorBrush x:Key="LumiAccentBorderBrush" Color="{StaticResource LumiAccentBorderColor}" />
      <SolidColorBrush x:Key="LumiAccentTextBrush" Color="{StaticResource LumiAccentTextColor}" />
      <SolidColorBrush x:Key="LumiOnAccentBrush" Color="{StaticResource LumiOnAccentColor}" />
      <SolidColorBrush x:Key="LumiUserBubbleBrush" Color="{StaticResource LumiUserBubbleColor}" />
      <SolidColorBrush x:Key="LumiUserBubbleTextBrush" Color="{StaticResource LumiUserBubbleTextColor}" />
      <SolidColorBrush x:Key="LumiAssistantBubbleBrush" Color="{StaticResource LumiAssistantBubbleColor}" />
      <SolidColorBrush x:Key="LumiPrimaryButtonBrush" Color="{StaticResource LumiPrimaryButtonColor}" />
      <SolidColorBrush x:Key="LumiPrimaryButtonTextBrush" Color="{StaticResource LumiPrimaryButtonTextColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="LumiBackgroundColor">#1C1917</Color>
      <Color x:Key="LumiSurfaceColor">#24201E</Color>
      <Color x:Key="LumiChromeColor">#201C1A</Color>
      <Color x:Key="LumiSurfaceAltColor">#302A27</Color>
      <Color x:Key="LumiBorderColor">#49403C</Color>
      <Color x:Key="LumiBorderStrongColor">#655853</Color>
      <Color x:Key="LumiTextColor">#EEEDEC</Color>
      <Color x:Key="LumiTextMutedColor">#B3ABA8</Color>
      <Color x:Key="LumiTextOnSoftColor">#EEEDEC</Color>
      <Color x:Key="LumiAccentColor">#F08C60</Color>
      <Color x:Key="LumiAccentHoverColor">#F3A07C</Color>
      <Color x:Key="LumiAccentSoftColor">#3F271D</Color>
      <Color x:Key="LumiAccentBorderColor">#734430</Color>
      <Color x:Key="LumiAccentTextColor">#ECB8A2</Color>
      <Color x:Key="LumiOnAccentColor">#1B1918</Color>
      <Color x:Key="LumiUserBubbleColor">#573324</Color>
      <Color x:Key="LumiUserBubbleTextColor">#F2EBE9</Color>
      <Color x:Key="LumiAssistantBubbleColor">#302A27</Color>
      <Color x:Key="LumiPrimaryButtonColor">#EEEDEC</Color>
      <Color x:Key="LumiPrimaryButtonTextColor">#1C1917</Color>

      <SolidColorBrush x:Key="LumiBackgroundBrush" Color="{StaticResource LumiBackgroundColor}" />
      <SolidColorBrush x:Key="LumiSurfaceBrush" Color="{StaticResource LumiSurfaceColor}" />
      <SolidColorBrush x:Key="LumiChromeBrush" Color="{StaticResource LumiChromeColor}" />
      <SolidColorBrush x:Key="LumiSurfaceAltBrush" Color="{StaticResource LumiSurfaceAltColor}" />
      <SolidColorBrush x:Key="LumiBorderBrush" Color="{StaticResource LumiBorderColor}" />
      <SolidColorBrush x:Key="LumiBorderStrongBrush" Color="{StaticResource LumiBorderStrongColor}" />
      <SolidColorBrush x:Key="LumiTextBrush" Color="{StaticResource LumiTextColor}" />
      <SolidColorBrush x:Key="LumiTextMutedBrush" Color="{StaticResource LumiTextMutedColor}" />
      <SolidColorBrush x:Key="LumiTextOnSoftBrush" Color="{StaticResource LumiTextOnSoftColor}" />
      <SolidColorBrush x:Key="LumiAccentBrush" Color="{StaticResource LumiAccentColor}" />
      <SolidColorBrush x:Key="LumiAccentHoverBrush" Color="{StaticResource LumiAccentHoverColor}" />
      <SolidColorBrush x:Key="LumiAccentSoftBrush" Color="{StaticResource LumiAccentSoftColor}" />
      <SolidColorBrush x:Key="LumiAccentBorderBrush" Color="{StaticResource LumiAccentBorderColor}" />
      <SolidColorBrush x:Key="LumiAccentTextBrush" Color="{StaticResource LumiAccentTextColor}" />
      <SolidColorBrush x:Key="LumiOnAccentBrush" Color="{StaticResource LumiOnAccentColor}" />
      <SolidColorBrush x:Key="LumiUserBubbleBrush" Color="{StaticResource LumiUserBubbleColor}" />
      <SolidColorBrush x:Key="LumiUserBubbleTextBrush" Color="{StaticResource LumiUserBubbleTextColor}" />
      <SolidColorBrush x:Key="LumiAssistantBubbleBrush" Color="{StaticResource LumiAssistantBubbleColor}" />
      <SolidColorBrush x:Key="LumiPrimaryButtonBrush" Color="{StaticResource LumiPrimaryButtonColor}" />
      <SolidColorBrush x:Key="LumiPrimaryButtonTextBrush" Color="{StaticResource LumiPrimaryButtonTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
