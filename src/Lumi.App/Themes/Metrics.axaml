<!-- 間距與圓角尺度（ui-guide.html 第 9 節）：間距只用 4／8／12／16／24／32，圓角輸入框 10、卡片 14、頁面區域 16。 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="LumiSpace4">4</x:Double>
  <x:Double x:Key="LumiSpace8">8</x:Double>
  <x:Double x:Key="LumiSpace12">12</x:Double>
  <x:Double x:Key="LumiSpace16">16</x:Double>
  <x:Double x:Key="LumiSpace24">24</x:Double>
  <x:Double x:Key="LumiSpace32">32</x:Double>
  <!-- 輸入框、下拉選單的高度（ui-guide.html：38–42px） -->
  <x:Double x:Key="LumiControlHeight">40</x:Double>
  <CornerRadius x:Key="LumiRadiusInput">10</CornerRadius>
  <CornerRadius x:Key="LumiRadiusCard">14</CornerRadius>
  <CornerRadius x:Key="LumiRadiusPanel">16</CornerRadius>
</ResourceDictionary>
