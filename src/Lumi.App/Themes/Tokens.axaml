<!--
  語意 token（不隨主題變）：狀態色、程式碼區塊、小精靈陰影。規格見 docs/ui-spec.md 1.2 與 plan/12-ui-redesign.md。
  主題色（Background、Accent、Text…）在 Themes/Palettes/*.axaml，依使用者選的主題整份替換。
  這個資料夾是整個專案唯一可以寫 #RRGGBB 的地方；元件一律使用 {DynamicResource LumiXxxBrush}。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 小精靈的氣泡與輸入列浮在任意桌面背景上，用陰影與細框線確保看得清楚（ui-spec 8.1） -->
  <BoxShadows x:Key="LumiSpriteShadow">0 8 24 0 #59000000</BoxShadows>
  <!-- 可點擊卡片 Hover 的陰影（ui-guide.html：陰影只用在浮起與 Hover） -->
  <BoxShadows x:Key="LumiCardHoverShadow">0 4 12 0 #1F000000</BoxShadows>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="LumiInfoColor">#2F6FDB</Color>
      <Color x:Key="LumiSuccessColor">#1F7A52</Color>
      <Color x:Key="LumiDangerColor">#A1360B</Color>
      <Color x:Key="LumiDangerBackgroundColor">#FDF2EE</Color>
      <Color x:Key="LumiDangerBorderColor">#E3A58C</Color>
      <Color x:Key="LumiWarningIconColor">#B26B00</Color>
      <Color x:Key="LumiWarningTextColor">#8A5A0B</Color>
      <Color x:Key="LumiWarningBackgroundColor">#FFFBF2</Color>
      <Color x:Key="LumiWarningBorderColor">#E9B85A</Color>
      <Color x:Key="LumiCodeBackgroundColor">#1A1D22</Color>
      <Color x:Key="LumiCodeTextColor">#D7DCE3</Color>
      <Color x:Key="LumiCodeHeaderColor">#252A31</Color>

      <SolidColorBrush x:Key="LumiInfoBrush" Color="{StaticResource LumiInfoColor}" />
      <SolidColorBrush x:Key="LumiSuccessBrush" Color="{StaticResource LumiSuccessColor}" />
      <SolidColorBrush x:Key="LumiDangerBrush" Color="{StaticResource LumiDangerColor}" />
      <SolidColorBrush x:Key="LumiDangerBackgroundBrush" Color="{StaticResource LumiDangerBackgroundColor}" />
      <SolidColorBrush x:Key="LumiDangerBorderBrush" Color="{StaticResource LumiDangerBorderColor}" />
      <SolidColorBrush x:Key="LumiWarningIconBrush" Color="{StaticResource LumiWarningIconColor}" />
      <SolidColorBrush x:Key="LumiWarningTextBrush" Color="{StaticResource LumiWarningTextColor}" />
      <SolidColorBrush x:Key="LumiWarningBackgroundBrush" Color="{StaticResource LumiWarningBackgroundColor}" />
      <SolidColorBrush x:Key="LumiWarningBorderBrush" Color="{StaticResource LumiWarningBorderColor}" />
      <SolidColorBrush x:Key="LumiCodeBackgroundBrush" Color="{StaticResource LumiCodeBackgroundColor}" />
      <SolidColorBrush x:Key="LumiCodeTextBrush" Color="{StaticResource LumiCodeTextColor}" />
      <SolidColorBrush x:Key="LumiCodeHeaderBrush" Color="{StaticResource LumiCodeHeaderColor}" />
      <!-- 狀態點（非文字元件）：ui-guide.html 的固定語意色，淺深色相同、不隨主題變。文字用上面的 Success／Danger／Warning -->
      <Color x:Key="LumiSuccessDotColor">#55A981</Color>
      <Color x:Key="LumiWarningDotColor">#D99A3E</Color>
      <Color x:Key="LumiDangerDotColor">#BD5335</Color>
      <SolidColorBrush x:Key="LumiSuccessDotBrush" Color="{StaticResource LumiSuccessDotColor}" />
      <SolidColorBrush x:Key="LumiWarningDotBrush" Color="{StaticResource LumiWarningDotColor}" />
      <SolidColorBrush x:Key="LumiDangerDotBrush" Color="{StaticResource LumiDangerDotColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="LumiInfoColor">#6FA0F0</Color>
      <Color x:Key="LumiSuccessColor">#4CC28A</Color>
      <Color x:Key="LumiDangerColor">#F08A5D</Color>
      <Color x:Key="LumiDangerBackgroundColor">#2D1A14</Color>
      <Color x:Key="LumiDangerBorderColor">#7A3B25</Color>
      <Color x:Key="LumiWarningIconColor">#F2B544</Color>
      <Color x:Key="LumiWarningTextColor">#F5C66B</Color>
      <Color x:Key="LumiWarningBackgroundColor">#2A2416</Color>
      <Color x:Key="LumiWarningBorderColor">#6B5320</Color>
      <Color x:Key="LumiCodeBackgroundColor">#1A1D22</Color>
      <Color x:Key="LumiCodeTextColor">#D7DCE3</Color>
      <Color x:Key="LumiCodeHeaderColor">#252A31</Color>

      <SolidColorBrush x:Key="LumiInfoBrush" Color="{StaticResource LumiInfoColor}" />
      <SolidColorBrush x:Key="LumiSuccessBrush" Color="{StaticResource LumiSuccessColor}" />
      <SolidColorBrush x:Key="LumiDangerBrush" Color="{StaticResource LumiDangerColor}" />
      <SolidColorBrush x:Key="LumiDangerBackgroundBrush" Color="{StaticResource LumiDangerBackgroundColor}" />
      <SolidColorBrush x:Key="LumiDangerBorderBrush" Color="{StaticResource LumiDangerBorderColor}" />
      <SolidColorBrush x:Key="LumiWarningIconBrush" Color="{StaticResource LumiWarningIconColor}" />
      <SolidColorBrush x:Key="LumiWarningTextBrush" Color="{StaticResource LumiWarningTextColor}" />
      <SolidColorBrush x:Key="LumiWarningBackgroundBrush" Color="{StaticResource LumiWarningBackgroundColor}" />
      <SolidColorBrush x:Key="LumiWarningBorderBrush" Color="{StaticResource LumiWarningBorderColor}" />
      <SolidColorBrush x:Key="LumiCodeBackgroundBrush" Color="{StaticResource LumiCodeBackgroundColor}" />
      <SolidColorBrush x:Key="LumiCodeTextBrush" Color="{StaticResource LumiCodeTextColor}" />
      <SolidColorBrush x:Key="LumiCodeHeaderBrush" Color="{StaticResource LumiCodeHeaderColor}" />
      <!-- 狀態點（非文字元件）：ui-guide.html 的固定語意色，淺深色相同、不隨主題變。文字用上面的 Success／Danger／Warning -->
      <Color x:Key="LumiSuccessDotColor">#55A981</Color>
      <Color x:Key="LumiWarningDotColor">#D99A3E</Color>
      <Color x:Key="LumiDangerDotColor">#BD5335</Color>
      <SolidColorBrush x:Key="LumiSuccessDotBrush" Color="{StaticResource LumiSuccessDotColor}" />
      <SolidColorBrush x:Key="LumiWarningDotBrush" Color="{StaticResource LumiWarningDotColor}" />
      <SolidColorBrush x:Key="LumiDangerDotBrush" Color="{StaticResource LumiDangerDotColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
