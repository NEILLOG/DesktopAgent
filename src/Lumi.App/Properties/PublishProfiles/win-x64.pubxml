<?xml version="1.0" encoding="utf-8"?>
<!-- 單一檔案發佈（M20）：自包含、不裁剪（Avalonia 與 JSON 反射不安全）。輸出到 artifacts/publish/<RID>/。 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 只有原生函式庫在啟動時解壓（它們都在啟動時就載入）。受控 DLL 直接從單檔載入，不再解壓到暫存資料夾（M22：暫存被清掉會造成執行中缺檔）。
         Playwright driver 改成內嵌 zip，第一次用瀏覽器時由程式解到使用者資料夾（見 Lumi.App.csproj 與 PlaywrightDriverLocator）；appsettings.json 改用程式內建預設。 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>
</Project>
