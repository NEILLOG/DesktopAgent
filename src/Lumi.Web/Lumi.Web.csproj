<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lumi.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumi.Web.Tests" />
  </ItemGroup>

  <!-- 解析網頁與 PAC 的套件只能出現在這個專案（架構測試 WebLibraryRuleTests 守住） -->
  <ItemGroup>
    <PackageReference Include="SmartReader" />
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Jint" />
    <PackageReference Include="System.ServiceModel.Syndication" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Proxy\PacHelpers.js" LogicalName="Lumi.Web.Proxy.PacHelpers.js" />
    <!-- 價目表快照（LiteLLM，MIT）：M23。日期檔記下快照日期 -->
    <EmbeddedResource Include="Pricing\litellm-model-prices.json" LogicalName="Lumi.Web.Pricing.litellm-model-prices.json" />
    <EmbeddedResource Include="Pricing\litellm-model-prices.date.txt" LogicalName="Lumi.Web.Pricing.litellm-model-prices.date.txt" />
    <ProjectReference Include="..\Lumi.Core\Lumi.Core.csproj" />
  </ItemGroup>

</Project>
